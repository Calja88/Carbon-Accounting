# Pooled runtime connection (Neon: the "-pooler" host). The application uses
# this at request time. Synthetic localhost example only.
DATABASE_URL="postgresql://paragon:paragon@localhost:5432/paragon_carbon?schema=public"

# Direct connection used only by Prisma migration/CLI commands. Neon’s Vercel
# integration commonly provides DATABASE_URL_UNPOOLED automatically; DIRECT_URL
# is the explicit cross-platform name used by this repository. If neither is
# set, prisma.config.ts derives a direct Neon host from DATABASE_URL.
DIRECT_URL="postgresql://paragon:paragon@localhost:5432/paragon_carbon?schema=public"
# DATABASE_URL_UNPOOLED="postgresql://paragon:paragon@localhost:5432/paragon_carbon?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- AI layer ---------------------------------------------------------------
# The only credential the AI layer uses. Read server-side only; never stored in
# the database, never returned from an endpoint, never sent to the browser.
# Leave it blank and the platform runs exactly as before, with AI features
# showing a clear "unavailable" message. Core carbon accounting is unaffected.
OPENROUTER_API_KEY=

# Optional attribution headers OpenRouter uses for its app rankings.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# Master switches. Everything below is a *default*: an administrator can change
# all of it at /admin/ai without a redeploy, and the database value wins.
AI_ENABLED=true
AI_OPENROUTER_ENABLED=true

# Free-only mode. When true the router will only call a model whose OpenRouter
# pricing metadata confirms it is free; if none is available for a task, the
# request fails and the user is told AI is temporarily unavailable rather than
# a paid model being used. Defaults to true even if unset.
AI_FREE_ONLY=true
# Whether OpenRouter's own free-model router (openrouter/free) may be used as a
# last-resort fallback.
AI_ALLOW_FREE_ROUTER=true

# Model per task. Defaults are free models; see src/lib/ai/config.ts. Prefer
# changing these at /admin/ai, which lists what OpenRouter currently offers.
AI_MODEL_GENERAL_CHAT=
AI_MODEL_CARBON_REASONING=
AI_MODEL_EMISSION_CLASSIFICATION=
AI_MODEL_DOCUMENT_EXTRACTION=
AI_MODEL_DOCUMENT_VISION=
AI_MODEL_LCA_ASSISTANT=
AI_MODEL_DATA_QUALITY_REVIEW=
AI_MODEL_REPORT_ASSISTANT=
# Tried when a task's own model and its fallback are both unavailable.
AI_MODEL_FALLBACK=

# Safety and cost protection.
AI_AUTO_ACCEPT_EXTRACTION=false
AI_MIN_CONFIDENCE=0.7
AI_LOGGING_LEVEL=STANDARD
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_DAY=300
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_DOCUMENT_BYTES=8388608

# --- Microsoft Graph / SharePoint integration (SP02) ------------------------
# Docs/SP00_SHAREPOINT_INTEGRATION_SPEC.md §3 Option A: one Paragon-owned,
# multi-tenant Entra application, scoped to the `Sites.Selected` application
# permission only (never Sites.Read.All / Sites.ReadWrite.All). These three
# values identify and authenticate *that* application — never a customer's
# own tenant/site, which is configured per organisation via SP01's
# OrganisationStorageConnection/StorageSiteBinding rows, not via env vars.
# Read server-side only; never stored in Neon, never returned from an
# endpoint, never sent to the browser. Leave blank in any environment that
# does not need live Graph calls (synthetic/local tests never need this set).
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Optional per-request timeout override for the Graph client (ms). Defaults
# to 15000 if unset.
GRAPH_REQUEST_TIMEOUT_MS=

# Opt-in switch (task SP03) to route the shared documents/evidence module's
# bytes through the SharePoint-backed provider instead of the built-in
# database provider. Leave unset/blank to keep the existing (database)
# behaviour — this is per-deployment, not per-organisation; an organisation
# without its own OrganisationStorageConnection configured simply fails
# closed on upload/download rather than falling back silently.
DOCUMENT_EVIDENCE_STORAGE=

DATABASE_URL="postgresql://paragon:paragon@localhost:5432/paragon_carbon?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- AI layer ---------------------------------------------------------------
# The only credential the AI layer uses. Read server-side only; never stored in
# the database, never returned from an endpoint, never sent to the browser.
# Leave it blank and the platform runs exactly as before, with AI features
# showing a clear "unavailable" message. Core carbon accounting is unaffected.
OPENROUTER_API_KEY=

# Optional attribution headers OpenRouter uses for its app rankings.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# Master switches. Everything below is a *default*: an administrator can change
# all of it at /admin/ai without a redeploy, and the database value wins.
AI_ENABLED=true
AI_OPENROUTER_ENABLED=true

# Free-only mode. When true the router will only call a model whose OpenRouter
# pricing metadata confirms it is free; if none is available for a task, the
# request fails and the user is told AI is temporarily unavailable rather than
# a paid model being used. Defaults to true even if unset.
AI_FREE_ONLY=true
# Whether OpenRouter's own free-model router (openrouter/free) may be used as a
# last-resort fallback.
AI_ALLOW_FREE_ROUTER=true

# Model per task. Defaults are free models; see src/lib/ai/config.ts. Prefer
# changing these at /admin/ai, which lists what OpenRouter currently offers.
AI_MODEL_GENERAL_CHAT=
AI_MODEL_CARBON_REASONING=
AI_MODEL_EMISSION_CLASSIFICATION=
AI_MODEL_DOCUMENT_EXTRACTION=
AI_MODEL_DOCUMENT_VISION=
AI_MODEL_LCA_ASSISTANT=
AI_MODEL_DATA_QUALITY_REVIEW=
AI_MODEL_REPORT_ASSISTANT=
# Tried when a task's own model and its fallback are both unavailable.
AI_MODEL_FALLBACK=

# Safety and cost protection.
AI_AUTO_ACCEPT_EXTRACTION=false
AI_MIN_CONFIDENCE=0.7
# How far the assistant may go on its own with a document it has read.
#   AUTO_LOG_HIGH_CONFIDENCE — create the entry when every deterministic check
#                              in src/lib/ai/auto-log.ts passes (the default).
#   REVIEW_ALL               — never create one unprompted; hold it for review.
# "High confidence" means those checks passed, not that a model said so.
# Neither setting changes what an explicit "log this" from a user does: that is
# their decision, and the same checks still have to pass.
AI_DATA_ENTRY_MODE=AUTO_LOG_HIGH_CONFIDENCE
# Read a file attached to the assistant as soon as it is uploaded.
AI_AUTO_EXTRACT_ATTACHMENTS=true
AI_LOGGING_LEVEL=STANDARD
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_DAY=300
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_DOCUMENT_BYTES=8388608

{
  "name": "paragon-id-carbon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:lca-methodology": "tsx prisma/seed/lca-methodology-only.ts",
    "db:seed:ems-demo": "tsx prisma/seed/ems-demo.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/resolve-failed-migration.mjs && prisma migrate deploy",
    "backfill:organisation": "tsx scripts/backfill-organisation.ts",
    "migrate:contract-preflight": "tsx scripts/contract-migration-preflight.ts",
    "test": "vitest run",
    "handoff:full": "node scripts/handoff/full-handoff.mjs",
    "handoff:review": "node scripts/handoff/review-handoff.mjs",
    "handoff:secret-audit": "node scripts/handoff/secret-audit.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.0",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"

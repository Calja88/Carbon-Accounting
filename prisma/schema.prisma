// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  DATA_OWNER
  SUSTAINABILITY_LEAD
  FINANCE
  ADMIN
}

enum ConsolidationApproach {
  OPERATIONAL_CONTROL
}

enum Scope {
  SCOPE_1
  SCOPE_2
  SCOPE_3
}

enum FormType {
  QUANTITY
  CONTRACT_INFO
  /// Cat 7 employee commuting — a periodic headcount/modal-split survey,
  /// not a single quantity entry (data map row S3-07).
  SURVEY
}

enum EntryStatus {
  SUBMITTED
  FLAGGED
  APPROVED
  REJECTED
  /// Saved, real activity data with no matching EmissionFactor yet (v2:
  /// Scope 3 factors are not seeded as placeholders — see README — so an
  /// entry can be genuinely complete and still be waiting on a real,
  /// imported factor before it produces a figure). Never silently dropped;
  /// surfaced in reports as "awaiting emission factor".
  AWAITING_FACTOR
}

enum FactorBasis {
  STANDARD
  LOCATION_BASED
  MARKET_BASED
  RESIDUAL_MIX
}

/// Which of the methodology Section 7 sources a factor set came from —
/// lets the platform hold more than one live source per category and
/// resolve between them (OFFICIAL primary, EEIO fallback for Cat 1/2,
/// SUPPLIER_SPECIFIC override where a named supplier has provided one).
enum FactorSourceType {
  OFFICIAL_DEFRA_DESNZ
  EEIO_SPEND_BASED
  SUPPLIER_SPECIFIC
  /// Life-cycle inventory factors (materials, freight, waste routes) used by
  /// the product LCA engine. Held in the same versioned, append-only library
  /// as every other factor set so one import/audit path covers both.
  LCA_SECONDARY
}

enum DataQualityTier {
  TIER_1
  TIER_2
  TIER_3
}

enum TariffType {
  STANDARD
  GREEN
}

// ---------------------------------------------------------------------------
// Organisational structure
// ---------------------------------------------------------------------------

/// Paragon ID, RFID Discovery, Thames Technology — the three operating units
/// consolidated under operational control (methodology Section 3).
model Entity {
  id                    String                @id @default(cuid())
  name                  String                @unique
  consolidationApproach ConsolidationApproach @default(OPERATIONAL_CONTROL)
  createdAt             DateTime              @default(now())
  sites                 Site[]

  // Product LCA / PCF
  products            Product[]
  suppliers           Supplier[]
  methodologyProfiles LcaMethodologyProfile[]
  lcaAssessments      LcaAssessment[]
  supplierPcfs        LcaSupplierPcf[]
}

model Site {
  id        String   @id @default(cuid())
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  activityEntries  ActivityEntry[]
  energyContracts  SiteEnergyContract[]
  commutingSurveys CommutingSurvey[]

  // Product LCA / PCF
  productManufacturingLocations ProductManufacturingLocation[]
  lcaCorporateDataLinks         LcaCorporateDataLink[]

  // AI layer / evidence documents
  sourceDocuments SourceDocument[]

  @@unique([entityId, name])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  enteredEntries     ActivityEntry[]      @relation("EnteredBy")
  enteredContracts   SiteEnergyContract[] @relation("ContractEnteredBy")
  calculations       Calculation[]        @relation("CalculatedBy")
  reportSnapshots    ReportSnapshot[]     @relation("GeneratedBy")
  enteredSurveys     CommutingSurvey[]    @relation("SurveyEnteredBy")
  importedFactorSets EmissionFactorSet[]  @relation("FactorSetImportedBy")

  // Product LCA / PCF
  ownedLcaAssessments      LcaAssessment[]        @relation("LcaAssessmentOwner")
  issuedLcaAssessments     LcaAssessment[]        @relation("LcaAssessmentIssuer")
  lcaCalculationRuns       LcaCalculationRun[]    @relation("LcaRunBy")
  issuedLcaVersions        LcaAssessmentVersion[] @relation("LcaVersionIssuer")
  uploadedLcaEvidence      LcaEvidence[]          @relation("LcaEvidenceUploader")
  ownedLcaAssumptions      LcaAssumption[]        @relation("LcaAssumptionOwner")
  approvedLcaAssumptions   LcaAssumption[]        @relation("LcaAssumptionApprover")
  ownedLcaExclusions       LcaExclusion[]         @relation("LcaExclusionOwner")
  approvedLcaExclusions    LcaExclusion[]         @relation("LcaExclusionApprover")
  recordedLcaVerifications LcaVerification[]      @relation("LcaVerificationRecorder")
  lcaAuditEvents           LcaAuditEvent[]        @relation("LcaAuditActor")

  // --- AI layer / evidence documents ---
  aiSettingsUpdates    AiSettings[]         @relation("AiSettingsUpdatedBy")
  aiInteractions       AiInteraction[]      @relation("AiInteractionUser")
  aiSuggestionsRaised  AiSuggestion[]       @relation("AiSuggestionRaisedBy")
  aiSuggestionsDecided AiSuggestion[]       @relation("AiSuggestionDecidedBy")
  uploadedDocuments    SourceDocument[]     @relation("DocumentUploadedBy")
  createdExtractions   DocumentExtraction[] @relation("ExtractionCreatedBy")
  reviewedExtractions  DocumentExtraction[] @relation("ExtractionReviewedBy")
  retractedEntries     ActivityEntry[]      @relation("EntryRetractedBy")
  archivedDocuments    SourceDocument[]     @relation("DocumentArchivedBy")
}

// ---------------------------------------------------------------------------
// Catalog / configuration (seeded from the Data Requirements Map)
// ---------------------------------------------------------------------------

/// One row per data-map entry (S1-01..S1-05, S2-01..S2-04, and future Scope 3
/// rows). Data-entry forms are rendered from this table, not hand-coded per
/// field, so extending scope later is a data change, not a rebuild.
model ActivityDataPoint {
  id               String          @id @default(cuid())
  code             String          @unique // e.g. "S1-01"
  scope            Scope
  category         String // e.g. "Stationary combustion"
  dataPointName    String // e.g. "Natural gas — facilities"
  promptTemplate   String // verbatim plain-English prompt, with [site]/[period] placeholders
  helpText         String? // "Why are we asking this?" tooltip content (technical framing)
  sourceSystemHint String?
  unitOptions      String[] // e.g. ["kWh", "m3"]
  frequency        String // e.g. "Monthly"
  defaultTier      DataQualityTier
  formType         FormType
  buildPriority    String // as tagged in the data map, kept for traceability
  notes            String?
  sortOrder        Int             @default(0)
  factorCategory   String // matches EmissionFactor.category for this data point
  /// GHG Protocol Scope 3 category label (e.g. "Cat 1 — Purchased goods &
  /// services"), null for Scope 1/2. Copied onto every Calculation this
  /// data point produces so reports can group Scope 3 totals by category
  /// without going through this table (needed for Cat 3, which has no
  /// data point of its own — see Calculation.scope3Category).
  scope3Category   String?

  factorOptions FactorOption[]
  entries       ActivityEntry[]
}

/// Selectable sub-type options for a data point that needs one (fuel type,
/// vehicle type, refrigerant type, business-travel mode, commuting mode).
/// subtypeKey matches EmissionFactor.subtypeKey.
model FactorOption {
  id                  String            @id @default(cuid())
  activityDataPointId String
  activityDataPoint   ActivityDataPoint @relation(fields: [activityDataPointId], references: [id])
  label               String // shown in the dropdown, e.g. "Diesel"
  subtypeKey          String // e.g. "diesel", "petrol", "car_average_diesel", "r410a"
  /// Per-option unit override (e.g. "miles" for a rail/flight option,
  /// "nights" for a hotel option) — only set where a data point's options
  /// don't share one common unit (unitOptions). When set, the entry form
  /// uses this instead of showing a unit picker.
  unit                String?
  sortOrder           Int               @default(0)

  entries                  ActivityEntry[]
  commutingSurveyResponses CommutingSurveyResponse[]

  @@unique([activityDataPointId, subtypeKey])
}

// ---------------------------------------------------------------------------
// Emission factors (versioned, never edited in place — only superseded)
// ---------------------------------------------------------------------------

model EmissionFactorSet {
  id               String           @id @default(cuid())
  name             String // e.g. "UK Gov GHG Conversion Factors for Company Reporting 2024 (placeholder)"
  publisher        String // e.g. "DEFRA/DESNZ"
  sourceType       FactorSourceType @default(OFFICIAL_DEFRA_DESNZ)
  /// Only set for sourceType SUPPLIER_SPECIFIC — the named supplier this
  /// set's factors apply to. Matched against ActivityEntry.supplierName
  /// (methodology Section 7: supplier-specific data overrides EEIO/DEFRA
  /// defaults where the Group has entered it).
  supplierName     String?
  vintageYear      Int // year of publication
  publishedDate    DateTime?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  sourceUrl        String?
  isPlaceholder    Boolean          @default(true) // true until a real official file is imported
  notes            String?
  /// Set when this EmissionFactorSet was created via the admin factor
  /// import (Part B) rather than seeded — traceability for who loaded
  /// which file, and when.
  sourceFileName   String?
  importedByUserId String?
  importedBy       User?            @relation("FactorSetImportedBy", fields: [importedByUserId], references: [id])
  createdAt        DateTime         @default(now())

  factors EmissionFactor[]
}

model EmissionFactor {
  id          String            @id @default(cuid())
  factorSetId String
  factorSet   EmissionFactorSet @relation(fields: [factorSetId], references: [id])
  scope       Scope
  category    String // e.g. "natural_gas", "grid_electricity", "refrigerant"
  subtypeKey  String? // matches FactorOption.subtypeKey where applicable
  basis       FactorBasis       @default(STANDARD)
  region      String            @default("UK")
  unit        String // the unit the factor is expressed per, e.g. "kWh", "litre", "mile", "kg"
  co2eFactor  Decimal           @db.Decimal(18, 8) // kgCO2e per unit
  notes       String?

  /// Lifecycle metadata, only meaningful for factors used in product LCA
  /// work. Nullable so the corporate factor library is unaffected: a
  /// corporate Scope 1/2 factor has no LCA boundary to declare, while a
  /// cradle-to-gate material factor must declare one or the product model
  /// can silently double-count or gap a stage.
  boundary           LcaFactorBoundary?
  gwpBasis           String? // e.g. "IPCC AR6 (2021), GWP100"
  referenceYear      Int? // the year the factor's underlying data represents
  lcaDataSource      String? // dataset/process name within the publisher's library
  uncertaintyPercent Decimal?           @db.Decimal(9, 4)

  calculations Calculation[]

  lcaInventoryItems         LcaInventoryItem[]     @relation("LcaItemFactor")
  lcaRecycledInventoryItems LcaInventoryItem[]     @relation("LcaItemRecycledFactor")
  lcaTransportLegs          LcaTransportLeg[]      @relation("LcaLegFactor")
  lcaEndOfLifeRoutes        LcaEndOfLifeRoute[]    @relation("LcaEolFactor")
  lcaResults                LcaCalculationResult[] @relation("LcaResultFactor")
  lcaEvidence               LcaEvidence[]          @relation("LcaEvidenceFactor")

  @@unique([factorSetId, category, subtypeKey, basis])
}

// ---------------------------------------------------------------------------
// Transactional data
// ---------------------------------------------------------------------------

/// Supplier/tariff/REGO metadata for a site's electricity, needed for the
/// Scope 2 market-based calculation (data map rows S2-02 / S2-03).
model SiteEnergyContract {
  id              String     @id @default(cuid())
  siteId          String
  site            Site       @relation(fields: [siteId], references: [id])
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  supplierName    String
  tariffType      TariffType
  regoBacked      Boolean    @default(false)
  regoVolumeKwh   Decimal?   @db.Decimal(18, 3)
  source          String?
  enteredByUserId String
  enteredBy       User       @relation("ContractEnteredBy", fields: [enteredByUserId], references: [id])
  enteredAt       DateTime   @default(now())
}

model ActivityEntry {
  id                  String            @id @default(cuid())
  activityDataPointId String
  activityDataPoint   ActivityDataPoint @relation(fields: [activityDataPointId], references: [id])
  siteId              String
  site                Site              @relation(fields: [siteId], references: [id])
  periodStart         DateTime
  periodEnd           DateTime

  rawValue       Decimal @db.Decimal(18, 4)
  rawUnit        String
  canonicalValue Decimal @db.Decimal(18, 8)
  canonicalUnit  String

  factorOptionId String?
  factorOption   FactorOption? @relation(fields: [factorOptionId], references: [id])

  /// Cat 1 (purchased goods & services) only — matched against
  /// EmissionFactorSet.supplierName to look up a supplier-specific factor
  /// override before falling back to EEIO/DEFRA (methodology Section 7).
  /// Null/unused for every other data point.
  supplierName String?

  dataQualityTier     DataQualityTier
  status              EntryStatus     @default(SUBMITTED)
  plausibilityFlagged Boolean         @default(false)
  plausibilityReason  String?
  notes               String?

  /// How this row's activity data reached the platform. AI never writes an
  /// entry on its own: AI_EXTRACTED means a human reviewed and accepted an
  /// AI extraction, and `enteredBy`/`enteredAt` record who accepted it and
  /// when. Defaults to USER_ENTERED so every pre-existing row keeps its
  /// original meaning.
  dataOrigin DataOrigin @default(USER_ENTERED)

  /// The uploaded evidence document this entry was created from, kept
  /// linked for audit (methodology Section 8 evidence trail).
  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])

  /// The AI extraction a human accepted to create this entry, if any.
  acceptedFromExtractionId String?
  acceptedFromExtraction   DocumentExtraction? @relation("ExtractionAcceptedEntries", fields: [acceptedFromExtractionId], references: [id])

  enteredByUserId String
  enteredBy       User     @relation("EnteredBy", fields: [enteredByUserId], references: [id])
  enteredAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Soft-delete for accounting records (G2): a retracted entry is excluded
  /// from active totals/dashboards/reports but the row, its calculations and
  /// its evidence link are kept for audit. Never physically deleted once it
  /// has contributed a Calculation.
  retractedAt       DateTime?
  retractedByUserId String?
  retractedBy       User?     @relation("EntryRetractedBy", fields: [retractedByUserId], references: [id])
  retractionReason  String?

  calculations            Calculation[]
  commutingSurveyResponse CommutingSurveyResponse?
  /// Product assessments that cite this corporate record as their source.
  /// Reference only — see LcaCorporateDataLink.
  lcaCorporateDataLinks   LcaCorporateDataLink[]

  @@index([activityDataPointId, siteId, periodStart])
  @@index([sourceDocumentId])
  @@index([retractedAt])
}

/// Cat 7 employee commuting (data map row S3-07) — "survey-based initially
/// ... extrapolated across headcount" (methodology Section 9). One header
/// row per site/period capturing the survey-level inputs (headcount,
/// commuting days), so the raw inputs stay in the audit trail; the
/// per-mode responses each become a normal ActivityEntry/Calculation once
/// resolved, reusing the existing calculation + audit-trail pipeline
/// rather than a bespoke one.
model CommutingSurvey {
  id                    String   @id @default(cuid())
  siteId                String
  site                  Site     @relation(fields: [siteId], references: [id])
  periodStart           DateTime
  periodEnd             DateTime
  headcount             Int
  /// User-entered, not assumed — neither source document gives a default
  /// commuting-frequency figure (see README assumptions).
  commutingDaysInPeriod Int
  enteredByUserId       String
  enteredBy             User     @relation("SurveyEnteredBy", fields: [enteredByUserId], references: [id])
  enteredAt             DateTime @default(now())

  responses CommutingSurveyResponse[]

  @@index([siteId, periodStart])
}

model CommutingSurveyResponse {
  id                     String          @id @default(cuid())
  surveyId               String
  survey                 CommutingSurvey @relation(fields: [surveyId], references: [id])
  factorOptionId         String
  factorOption           FactorOption    @relation(fields: [factorOptionId], references: [id])
  percentOfHeadcount     Decimal         @db.Decimal(5, 2)
  avgOneWayDistanceMiles Decimal         @db.Decimal(10, 3)

  /// The derived ActivityEntry once a distance figure has been calculated
  /// and run through the normal calculation pipeline.
  activityEntryId String?        @unique
  activityEntry   ActivityEntry? @relation(fields: [activityEntryId], references: [id])

  @@unique([surveyId, factorOptionId])
}

/// One row per emission figure. Scope 2 electricity entries produce two rows
/// (LOCATION_BASED and MARKET_BASED) from a single entry. Key factor details
/// are snapshotted onto the row itself (not just FK'd) so the audit trail is
/// self-contained even if the EmissionFactor catalog changes later.
model Calculation {
  id              String        @id @default(cuid())
  activityEntryId String
  activityEntry   ActivityEntry @relation(fields: [activityEntryId], references: [id])

  emissionFactorId String
  emissionFactor   EmissionFactor @relation(fields: [emissionFactorId], references: [id])

  scope          Scope
  basis          FactorBasis
  /// GHG Protocol Scope 3 category label, copied from
  /// ActivityDataPoint.scope3Category for Cat 1/6/7 entries, or set
  /// directly by the Cat 3 (fuel/energy-related) auto-derivation job,
  /// which has no ActivityDataPoint of its own to read it from. Null for
  /// Scope 1/2.
  scope3Category String?

  inputValue Decimal @db.Decimal(18, 8)
  inputUnit  String

  // Snapshot of the factor at calculation time (compliance audit trail)
  factorValueSnapshot   Decimal @db.Decimal(18, 8)
  factorUnitSnapshot    String
  factorSourceSnapshot  String // publisher + set name
  factorVintageSnapshot String // vintage year as string, e.g. "2024"
  formulaApplied        String

  resultKgCo2e    Decimal         @db.Decimal(18, 8)
  dataQualityTier DataQualityTier

  calculatedByUserId String?
  calculatedBy       User?    @relation("CalculatedBy", fields: [calculatedByUserId], references: [id])
  calculatedAt       DateTime @default(now())
  engineVersion      String   @default("calc-engine-v1")
  supersededById     String? // if a later recalculation replaced this row's relevance

  /// Set only on Cat 3 (fuel/energy-related) rows auto-derived from a
  /// Scope 1/2 calculation (well-to-tank / T&D losses) — points back at
  /// the Scope 1/2 Calculation it was derived from. The unique constraint
  /// makes re-running the derivation job idempotent: at most one Cat 3
  /// companion row per source calculation, ever.
  derivedFromCalculationId String?      @unique
  derivedFromCalculation   Calculation? @relation("Cat3DerivedFrom", fields: [derivedFromCalculationId], references: [id])
  derivedCategory3Row      Calculation? @relation("Cat3DerivedFrom")

  reportLinks ReportSnapshotCalculation[]

  @@index([activityEntryId])
}

// ---------------------------------------------------------------------------
// Reporting (append-only, versioned snapshots — never overwritten)
// ---------------------------------------------------------------------------

model ReportSnapshot {
  id                String   @id @default(cuid())
  version           Int      @default(autoincrement())
  periodStart       DateTime
  periodEnd         DateTime
  generatedByUserId String
  generatedBy       User     @relation("GeneratedBy", fields: [generatedByUserId], references: [id])
  generatedAt       DateTime @default(now())

  payload Json // frozen computed report: totals, breakdowns, narrative, DQ summary

  calculationLinks ReportSnapshotCalculation[]
}

model ReportSnapshotCalculation {
  id               String         @id @default(cuid())
  reportSnapshotId String
  reportSnapshot   ReportSnapshot @relation(fields: [reportSnapshotId], references: [id])
  calculationId    String
  calculation      Calculation    @relation(fields: [calculationId], references: [id])

  @@unique([reportSnapshotId, calculationId])
}

// ===========================================================================
// Product Life Cycle Assessment (LCA) / Product Carbon Footprint (PCF)
//
// A product-level system that sits alongside — never inside — the corporate
// GHG inventory above. Corporate totals (Calculation rows) and product
// totals (LcaCalculationResult rows) are never summed together: a product
// footprint is an intensity figure for one product, a corporate inventory
// is an absolute figure for one organisation. Where a product assessment
// reuses a corporate record as its data source, that reuse is recorded
// explicitly as an LcaCorporateDataLink (reference only, never a transfer
// of emissions in either direction).
// ===========================================================================

enum LcaAssessmentStatus {
  DRAFT
  DATA_COLLECTION
  CALCULATION
  INTERNAL_REVIEW
  READY_FOR_VERIFICATION
  VERIFIED
  SUPERSEDED
}

/// Lifecycle boundary of an assessment. Cradle-to-gate assessments normally
/// report against a declared unit rather than a functional unit, because a
/// function cannot be fully described without the use and end-of-life stages.
enum LcaBoundary {
  CRADLE_TO_GATE
  CRADLE_TO_GRAVE
  CRADLE_TO_CRADLE
  GATE_TO_GATE
  GATE_TO_GRAVE
  CUSTOM
}

enum LcaLifecycleStage {
  RAW_MATERIALS
  INBOUND_TRANSPORT
  MANUFACTURING
  PACKAGING
  DISTRIBUTION
  USE_PHASE
  END_OF_LIFE
  OTHER
}

enum LcaAllocationMethod {
  NONE
  MASS
  PHYSICAL
  ECONOMIC
  MANUAL
}

/// Kept separate on every result row so gross fossil emissions can never be
/// netted down by removals, stored carbon or purchased offsets without that
/// being visible (see LcaCalculationRun totals, which report each class).
enum LcaEmissionClassification {
  FOSSIL
  BIOGENIC
  BIOGENIC_REMOVAL
  TECHNOLOGICAL_REMOVAL
  STORED_CARBON
  /// Credit for a burden avoided elsewhere (e.g. recovered material
  /// displacing virgin production). Only produced when the assessment's
  /// methodology selects an avoided-burden or circular-footprint treatment,
  /// and always carried as its own class so it can be seen rather than
  /// quietly shrinking the gross figure.
  AVOIDED_BURDEN
  OFFSET
}

enum LcaDataType {
  PRIMARY
  SUPPLIER_SPECIFIC
  SECONDARY
  PROXY
  MODELLED
}

enum LcaItemType {
  MATERIAL
  ENERGY
  FUEL
  TRANSPORT
  MANUFACTURING_PROCESS
  PACKAGING
  WASTE
  WATER
  USE_PHASE
  END_OF_LIFE
  SUPPLIER_PCF
  OTHER
}

enum LcaTransportMode {
  ROAD
  RAIL
  SEA
  AIR
  INLAND_WATERWAY
  MULTIMODAL
  CUSTOM
}

enum LcaEndOfLifeRouteType {
  LANDFILL
  RECYCLING
  INCINERATION_ENERGY_RECOVERY
  INCINERATION_NO_RECOVERY
  REUSE
  COMPOSTING
  CUSTOM
}

enum LcaUncertaintyStatus {
  NOT_ASSESSED
  QUALITATIVE
  ESTIMATED
  QUANTIFIED
}

enum LcaMateriality {
  LOW
  MEDIUM
  HIGH
}

enum LcaAssuranceType {
  NONE
  INTERNAL_REVIEW
  CRITICAL_REVIEW
  LIMITED_ASSURANCE
  REASONABLE_ASSURANCE
}

enum LcaPcfVerificationStatus {
  UNVERIFIED
  SELF_DECLARED
  SECOND_PARTY_REVIEWED
  THIRD_PARTY_VERIFIED
}

/// What a factor actually covers. Selecting a cradle-to-grave factor for a
/// cradle-to-gate model (or applying a combustion-only factor as if it were
/// well-to-wheel) is a silent double-count or gap, so it is recorded and
/// validated rather than assumed.
enum LcaFactorBoundary {
  UNKNOWN
  CRADLE_TO_GATE
  CRADLE_TO_GRAVE
  GATE_TO_GATE
  UPSTREAM
  DOWNSTREAM
  COMBUSTION_ONLY
  WELL_TO_TANK
  WELL_TO_WHEEL
  END_OF_LIFE
}

enum LcaFactorSelectionMode {
  NONE
  LIBRARY_FACTOR
  SUPPLIER_PCF
  MANUAL
}

enum LcaVersionStatus {
  DRAFT_REVISION
  ISSUED
  SUPERSEDED
}

enum LcaBiogenicTreatment {
  EXCLUDED
  REPORTED_SEPARATELY
  INCLUDED_IN_TOTAL
}

/// No single universal recycling methodology is hard-coded — the choice is
/// recorded per methodology profile and applied by the engine.
enum LcaRecyclingMethod {
  CUT_OFF
  AVOIDED_BURDEN
  CIRCULAR_FOOTPRINT_FORMULA
  MANUAL
}

enum LcaElectricityApproach {
  LOCATION_BASED
  MARKET_BASED
  DUAL_REPORTED
}

enum LcaOffsetTreatment {
  EXCLUDED
  DISCLOSED_SEPARATELY
}

enum LcaProductStatus {
  ACTIVE
  DISCONTINUED
}

enum LcaEvidenceKind {
  EXTERNAL_LINK
  UPLOADED_FILE
  SYSTEM_RECORD
}

enum LcaCorporateLinkType {
  FACILITY_ENERGY
  SUPPLIER_RECORD
  SCOPE3_ACTIVITY
  OTHER
}

// ---------------------------------------------------------------------------
// Suppliers, products
// ---------------------------------------------------------------------------

/// A first-class supplier record. The corporate side of the platform matches
/// suppliers by free-text name (ActivityEntry.supplierName /
/// EmissionFactorSet.supplierName); `name` is kept aligned with that string
/// so a supplier-specific corporate factor set and a product-level supplier
/// PCF can be recognised as the same counterparty.
model Supplier {
  id         String   @id @default(cuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id])
  name       String
  identifier String? // internal supplier code, DUNS, VAT number...
  country    String?
  contact    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productPcfs    LcaSupplierPcf[]
  inventoryItems LcaInventoryItem[]

  @@unique([entityId, name])
}

model Product {
  id          String           @id @default(cuid())
  entityId    String
  entity      Entity           @relation(fields: [entityId], references: [id])
  name        String
  sku         String
  description String?
  category    String?
  status      LcaProductStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  versions ProductVersion[]

  @@unique([entityId, sku])
  @@index([entityId])
}

model ProductVersion {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  versionLabel  String // e.g. "Rev A", "2026 build"
  description   String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  manufacturingLocations ProductManufacturingLocation[]
  assessments            LcaAssessment[]

  @@unique([productId, versionLabel])
}

/// Where this product version is made. Optionally points at an internal Site
/// so a product assessment can pull facility energy from the corporate
/// inventory for the right building (see LcaCorporateDataLink).
model ProductManufacturingLocation {
  id               String         @id @default(cuid())
  productVersionId String
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  name             String
  country          String?
  siteId           String?
  site             Site?          @relation(fields: [siteId], references: [id])
  isPrimary        Boolean        @default(false)
  notes            String?
}

// ---------------------------------------------------------------------------
// Methodology register — structured configuration, not prose
// ---------------------------------------------------------------------------

model LcaMethodologyProfile {
  id       String  @id @default(cuid())
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  name    String
  version String
  summary String?

  defaultBoundary           LcaBoundary            @default(CRADLE_TO_GATE)
  gwpBasis                  String // e.g. "IPCC AR6 (2021), GWP100"
  defaultAllocationMethod   LcaAllocationMethod    @default(MASS)
  allocationRules           String?
  recyclingMethod           LcaRecyclingMethod     @default(CUT_OFF)
  recyclingRules            String?
  electricityApproach       LcaElectricityApproach @default(LOCATION_BASED)
  electricityRules          String?
  biogenicTreatment         LcaBiogenicTreatment   @default(REPORTED_SEPARATELY)
  biogenicRules             String?
  removalsRules             String?
  offsetTreatment           LcaOffsetTreatment     @default(DISCLOSED_SEPARATELY)
  offsetRules               String?
  cutOffRules               String? // e.g. "exclude flows < 1% of mass and < 1% of estimated impact, max 5% total"
  cutOffThresholdPercent    Decimal?               @db.Decimal(6, 3)
  /// Ordered list of factor sources, most preferred first — the hierarchy the
  /// factor resolver and the validation engine both read.
  factorHierarchy           String[]
  dataQualityRequirements   String?
  /// Minimum acceptable pedigree score (1 best .. 5 worst) for an assessment
  /// to be considered ready for independent review.
  minimumDataQualityScore   Decimal?               @db.Decimal(4, 2)
  requireEvidenceForPrimary Boolean                @default(true)
  standardsReferenced       String[]
  notes                     String?
  isDefault                 Boolean                @default(false)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  assessments LcaAssessment[]

  @@unique([name, version])
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

model LcaAssessment {
  id               String         @id @default(cuid())
  entityId         String
  entity           Entity         @relation(fields: [entityId], references: [id])
  productVersionId String
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id])

  reference String
  title     String

  status LcaAssessmentStatus @default(DRAFT)

  // --- versioning -------------------------------------------------------
  version                  Int             @default(1)
  versionLabel             String?
  parentAssessmentId       String?
  parentAssessment         LcaAssessment?  @relation("AssessmentRevisions", fields: [parentAssessmentId], references: [id])
  revisions                LcaAssessment[] @relation("AssessmentRevisions")
  supersededByAssessmentId String?         @unique
  supersededBy             LcaAssessment?  @relation("AssessmentSupersession", fields: [supersededByAssessmentId], references: [id])
  supersedes               LcaAssessment?  @relation("AssessmentSupersession")

  // --- scenario modelling ----------------------------------------------
  /// A scenario is a full, independent copy of a baseline assessment, so a
  /// scenario edit can never write over baseline data.
  isScenario           Boolean         @default(false)
  baselineAssessmentId String?
  baselineAssessment   LcaAssessment?  @relation("ScenarioOf", fields: [baselineAssessmentId], references: [id])
  scenarioCopies       LcaAssessment[] @relation("ScenarioOf")
  scenarioDescription  String?

  // --- goal & scope -----------------------------------------------------
  goal                          String?
  intendedApplication           String?
  intendedAudience              String?
  comparativeAssertionDisclosed Boolean             @default(false)
  scopeDescription              String?
  boundary                      LcaBoundary         @default(CRADLE_TO_GATE)
  boundaryNotes                 String?
  includedStages                LcaLifecycleStage[]
  periodStart                   DateTime?
  periodEnd                     DateTime?
  ownerUserId                   String?
  owner                         User?               @relation("LcaAssessmentOwner", fields: [ownerUserId], references: [id])

  // --- functional / declared unit and reference flow ---------------------
  functionalUnitDescription String?
  functionalUnitQuantity    Decimal @default(1) @db.Decimal(24, 10)
  functionalUnitUnit        String?
  isDeclaredUnit            Boolean @default(false)
  declaredUnitDescription   String?
  referenceFlowDescription  String?
  referenceFlowQuantity     Decimal @default(1) @db.Decimal(24, 10)
  referenceFlowUnit         String?
  /// How much product the entered inventory represents (e.g. one batch of
  /// 500 units). The engine divides model totals by the number of functional
  /// units this represents to get the per-functional-unit figure.
  modelledOutputQuantity    Decimal @default(1) @db.Decimal(24, 10)
  modelledOutputUnit        String?
  modelledOutputDescription String?

  // --- methodology ------------------------------------------------------
  methodologyProfileId String?
  methodologyProfile   LcaMethodologyProfile? @relation(fields: [methodologyProfileId], references: [id])
  /// Frozen copy of the methodology profile taken when a version is issued,
  /// so an issued assessment's methodology can never change under it.
  methodologySnapshot  Json?
  methodologyNotes     String?

  usePhaseLifetimeYears Decimal? @db.Decimal(12, 4)
  usePhaseAssumptions   String?

  // --- narrative --------------------------------------------------------
  completenessNotes String?
  limitations       String?
  interpretation    String?

  engineVersion        String    @default("lca-engine-v1")
  lastCalculationRunId String?   @unique
  issuedAt             DateTime?
  issuedByUserId       String?
  issuedBy             User?     @relation("LcaAssessmentIssuer", fields: [issuedByUserId], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  processes       LcaProcess[]
  inventoryItems  LcaInventoryItem[]
  assumptions     LcaAssumption[]
  exclusions      LcaExclusion[]
  evidence        LcaEvidence[]
  calculationRuns LcaCalculationRun[]    @relation("RunsOfAssessment")
  results         LcaCalculationResult[]
  versions        LcaAssessmentVersion[]
  verifications   LcaVerification[]
  auditEvents     LcaAuditEvent[]

  @@unique([entityId, reference])
  @@index([entityId, status])
  @@index([productVersionId])
}

/// A unit process in the lifecycle model. Self-referencing so a stage can be
/// broken down as deeply as the modeller needs (e.g. Manufacturing ->
/// Injection moulding -> Drying), with allocation applied at whichever level
/// the multi-output split actually happens.
model LcaProcess {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  parentProcessId String?
  parentProcess   LcaProcess?  @relation("ProcessTree", fields: [parentProcessId], references: [id])
  childProcesses  LcaProcess[] @relation("ProcessTree")

  stage       LcaLifecycleStage
  name        String
  description String?
  sortOrder   Int               @default(0)
  isIncluded  Boolean           @default(true)

  allocationMethod           LcaAllocationMethod @default(NONE)
  /// Share of this process's emissions attributed to the assessed product,
  /// as a percentage. Derived from process outputs for MASS/PHYSICAL/ECONOMIC,
  /// entered directly for MANUAL, always 100 for NONE.
  allocationPercent          Decimal             @default(100) @db.Decimal(9, 6)
  allocationRationale        String?
  allocationBasisDescription String?

  geography String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outputs        LcaProcessOutput[]
  inventoryItems LcaInventoryItem[]
  results        LcaCalculationResult[]
  assumptions    LcaAssumption[]
  exclusions     LcaExclusion[]
  evidence       LcaEvidence[]

  @@index([assessmentId, stage])
}

/// Co-products of a multi-output process. The engine computes the allocation
/// factor from these according to the process's allocation method, so the
/// split is reproducible and auditable rather than a typed-in number.
model LcaProcessOutput {
  id        String     @id @default(cuid())
  processId String
  process   LcaProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  name              String
  isAssessedProduct Boolean  @default(false)
  massValue         Decimal? @db.Decimal(24, 10)
  massUnit          String?
  physicalValue     Decimal? @db.Decimal(24, 10)
  physicalUnit      String?
  economicValue     Decimal? @db.Decimal(24, 10)
  economicCurrency  String?
  manualPercent     Decimal? @db.Decimal(9, 6)
  notes             String?
  sortOrder         Int      @default(0)
}

/// One activity-data line: a material, an energy input, a freight movement,
/// a waste flow, a supplier PCF, and so on. Everything the calculation
/// engine consumes comes from this table.
model LcaInventoryItem {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  processId    String
  process      LcaProcess    @relation(fields: [processId], references: [id], onDelete: Cascade)

  itemType    LcaItemType
  name        String
  description String?
  sortOrder   Int         @default(0)

  // --- bill of materials attributes (material/packaging items) ----------
  componentName          String?
  partNumber             String?
  materialName           String?
  recycledContentPercent Decimal? @db.Decimal(9, 6)
  /// Manufacturing loss on this input: gross input = quantity / (1 - waste%).
  wastePercent           Decimal? @db.Decimal(9, 6)

  // --- activity data ----------------------------------------------------
  quantity            Decimal @db.Decimal(24, 10)
  unit                String
  // The quantity expressed in the factor's own unit is NOT stored here: it is
  // an output of a calculation run and lives on the result row, which also
  // records the conversion that produced it. Copying it back onto the
  // inventory would give the same figure two homes and, because writing it
  // touches the row, would make every line read as changed the moment it was
  // calculated.
  /// Extra multiplier applied after unit conversion — e.g. "x 3 uses per year
  /// x 5 years". Always shown as its own provenance step, never folded in.
  adjustmentFactor    Decimal @default(1) @db.Decimal(24, 10)
  adjustmentRationale String?

  // --- provenance of the activity data ----------------------------------
  dataType    LcaDataType @default(SECONDARY)
  dataSource  String?
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  geography   String?
  periodStart DateTime?
  periodEnd   DateTime?
  notes       String?

  // --- factor selection --------------------------------------------------
  factorSelectionMode      LcaFactorSelectionMode @default(NONE)
  emissionFactorId         String?
  emissionFactor           EmissionFactor?        @relation("LcaItemFactor", fields: [emissionFactorId], references: [id])
  /// Optional second factor used for the recycled share of a material, so
  /// recycled content changes the result only when a sourced recycled-route
  /// factor actually exists — never through an invented discount.
  recycledEmissionFactorId String?
  recycledEmissionFactor   EmissionFactor?        @relation("LcaItemRecycledFactor", fields: [recycledEmissionFactorId], references: [id])
  supplierPcfId            String?
  supplierPcf              LcaSupplierPcf?        @relation(fields: [supplierPcfId], references: [id])

  manualFactorValue     Decimal?           @db.Decimal(24, 10)
  manualFactorUnit      String?
  manualFactorSource    String?
  manualFactorVersion   String?
  manualFactorBoundary  LcaFactorBoundary?
  manualFactorGeography String?
  manualFactorYear      Int?
  manualFactorGwpBasis  String?
  manualFactorRationale String?

  // --- carbon classification --------------------------------------------
  classification        LcaEmissionClassification @default(FOSSIL)
  /// Biogenic carbon taken out of the atmosphere and held in this input,
  /// expressed as kgCO2e per unit of the item's own quantity. Always
  /// reported as its own class — never netted off the fossil total.
  biogenicUptakePerUnit Decimal?                  @db.Decimal(24, 10)
  storedCarbonPerUnit   Decimal?                  @db.Decimal(24, 10)

  // --- data quality (pedigree, 1 best .. 5 worst) ------------------------
  temporalScore      Int?
  geographicalScore  Int?
  technologicalScore Int?
  completenessScore  Int?
  reliabilityScore   Int?

  // --- uncertainty -------------------------------------------------------
  uncertaintyStatus  LcaUncertaintyStatus @default(NOT_ASSESSED)
  uncertaintyPercent Decimal?             @db.Decimal(9, 4)
  uncertaintyLower   Decimal?             @db.Decimal(24, 10)
  uncertaintyUpper   Decimal?             @db.Decimal(24, 10)
  uncertaintyNotes   String?

  isExcluded      Boolean @default(false)
  exclusionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportLegs   LcaTransportLeg[]
  endOfLifeRoutes LcaEndOfLifeRoute[]
  results         LcaCalculationResult[]
  evidence        LcaEvidence[]
  assumptions     LcaAssumption[]
  corporateLinks  LcaCorporateDataLink[]

  @@index([assessmentId, itemType])
  @@index([processId])
}

/// One movement in a freight chain. A multimodal journey is several legs on
/// one TRANSPORT item; each leg produces its own result row so the register
/// export shows the tonne-km arithmetic leg by leg.
model LcaTransportLeg {
  id              String           @id @default(cuid())
  inventoryItemId String
  inventoryItem   LcaInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  sequence        Int              @default(0)
  mode            LcaTransportMode
  modeDescription String?
  originName      String?
  destinationName String?

  distanceValue      Decimal  @db.Decimal(24, 10)
  distanceUnit       String   @default("km")
  massValue          Decimal  @db.Decimal(24, 10)
  massUnit           String   @default("kg")
  /// Share of the vehicle's payload attributable to this consignment, and
  /// whether the return leg is included — both change the answer materially
  /// and neither is assumed.
  loadFactorPercent  Decimal? @db.Decimal(9, 6)
  includesReturnTrip Boolean  @default(false)

  emissionFactorId   String?
  emissionFactor     EmissionFactor? @relation("LcaLegFactor", fields: [emissionFactorId], references: [id])
  manualFactorValue  Decimal?        @db.Decimal(24, 10)
  manualFactorUnit   String?
  manualFactorSource String?

  assumptions String?
  notes       String?

  results LcaCalculationResult[]

  @@index([inventoryItemId])
}

/// One end-of-life (or production-waste) route for an item's mass. Route
/// percentages for an item must total 100%, which the validation engine
/// enforces rather than silently normalising.
model LcaEndOfLifeRoute {
  id              String           @id @default(cuid())
  inventoryItemId String
  inventoryItem   LcaInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  route            LcaEndOfLifeRouteType
  routeDescription String?
  percent          Decimal               @db.Decimal(9, 6)

  emissionFactorId   String?
  emissionFactor     EmissionFactor? @relation("LcaEolFactor", fields: [emissionFactorId], references: [id])
  manualFactorValue  Decimal?        @db.Decimal(24, 10)
  manualFactorUnit   String?
  manualFactorSource String?

  /// Recovery/credit figures are only applied when the assessment's
  /// methodology profile says to (AVOIDED_BURDEN / CIRCULAR_FOOTPRINT), and
  /// are always reported as their own line, never merged into gross.
  recoveryRatePercent Decimal? @db.Decimal(9, 6)
  avoidedFactorValue  Decimal? @db.Decimal(24, 10)
  avoidedFactorUnit   String?
  avoidedFactorSource String?
  recoveryAssumptions String?
  notes               String?

  results LcaCalculationResult[]

  @@index([inventoryItemId])
}

// ---------------------------------------------------------------------------
// Supplier product carbon footprints
// ---------------------------------------------------------------------------

model LcaSupplierPcf {
  id         String   @id @default(cuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  productName       String
  productIdentifier String?
  productCategory   String?

  /// kgCO2e per declared unit, excluding biogenic where the supplier reports
  /// the two separately.
  pcfValue                Decimal  @db.Decimal(24, 10)
  pcfBiogenicValue        Decimal? @db.Decimal(24, 10)
  declaredUnitQuantity    Decimal  @default(1) @db.Decimal(24, 10)
  declaredUnitUnit        String
  declaredUnitDescription String?

  boundary             LcaBoundary
  boundaryNotes        String?
  methodology          String?
  methodologyVersion   String?
  gwpBasis             String?
  reportingPeriodStart DateTime?
  reportingPeriodEnd   DateTime?
  geography            String?

  verificationStatus LcaPcfVerificationStatus @default(UNVERIFIED)
  verifierName       String?
  verificationDate   DateTime?
  assuranceType      LcaAssuranceType         @default(NONE)

  primaryDataSharePercent Decimal? @db.Decimal(9, 6)
  temporalScore           Int?
  geographicalScore       Int?
  technologicalScore      Int?
  completenessScore       Int?
  reliabilityScore        Int?
  uncertaintyPercent      Decimal? @db.Decimal(9, 4)

  /// Set when this record was created by importing a PACT-aligned exchange
  /// document, with the source payload kept verbatim for audit.
  sourceFormat  String?
  sourcePayload Json?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems LcaInventoryItem[]
  evidence       LcaEvidence[]

  @@index([entityId])
  @@index([supplierId])
}

// ---------------------------------------------------------------------------
// Registers: assumptions, exclusions, corporate links, evidence
// ---------------------------------------------------------------------------

model LcaAssumption {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  assumption  String
  category    String
  rationale   String
  source      String?
  uncertainty String?
  materiality LcaMateriality @default(MEDIUM)

  ownerUserId      String?
  owner            User?     @relation("LcaAssumptionOwner", fields: [ownerUserId], references: [id])
  approvedByUserId String?
  approvedBy       User?     @relation("LcaAssumptionApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  recordedAt       DateTime  @default(now())

  processId       String?
  process         LcaProcess?       @relation(fields: [processId], references: [id])
  inventoryItemId String?
  inventoryItem   LcaInventoryItem? @relation(fields: [inventoryItemId], references: [id])

  evidence LcaEvidence[]

  @@index([assessmentId])
}

model LcaExclusion {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  excludedItem            String
  rationale               String
  estimatedRelevance      String
  estimatedPercentOfTotal Decimal? @db.Decimal(9, 4)

  ownerUserId      String?
  owner            User?     @relation("LcaExclusionOwner", fields: [ownerUserId], references: [id])
  approvedByUserId String?
  approvedBy       User?     @relation("LcaExclusionApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  recordedAt       DateTime  @default(now())

  processId String?
  process   LcaProcess? @relation(fields: [processId], references: [id])

  evidence LcaEvidence[]

  @@index([assessmentId])
}

/// Records that a product inventory line was sourced from an existing
/// corporate record. Reference only: no emissions move between the corporate
/// inventory and the product footprint in either direction, and both figures
/// remain complete in their own right.
model LcaCorporateDataLink {
  id              String           @id @default(cuid())
  inventoryItemId String
  inventoryItem   LcaInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  linkType        LcaCorporateLinkType
  activityEntryId String?
  activityEntry   ActivityEntry?       @relation(fields: [activityEntryId], references: [id])
  siteId          String?
  site            Site?                @relation(fields: [siteId], references: [id])
  supplierName    String?

  /// Share of the corporate figure attributed to this product line, and how
  /// that share was arrived at.
  allocationPercent Decimal  @default(100) @db.Decimal(9, 6)
  allocationBasis   String?
  notes             String?
  createdAt         DateTime @default(now())

  @@index([inventoryItemId])
}

model LcaEvidence {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  title       String
  description String?
  kind        LcaEvidenceKind @default(EXTERNAL_LINK)

  externalUrl     String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  checksumSha256  String?
  /// Storage backend that holds the bytes. "database" is the built-in
  /// fallback used when no object-storage credentials are configured; the
  /// service layer can route to another provider without a schema change.
  storageProvider String?
  storageKey      String?

  uploadedByUserId String?
  uploadedBy       User?    @relation("LcaEvidenceUploader", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now())

  processId        String?
  process          LcaProcess?       @relation(fields: [processId], references: [id])
  inventoryItemId  String?
  inventoryItem    LcaInventoryItem? @relation(fields: [inventoryItemId], references: [id])
  emissionFactorId String?
  emissionFactor   EmissionFactor?   @relation("LcaEvidenceFactor", fields: [emissionFactorId], references: [id])
  supplierPcfId    String?
  supplierPcf      LcaSupplierPcf?   @relation(fields: [supplierPcfId], references: [id])
  assumptionId     String?
  assumption       LcaAssumption?    @relation(fields: [assumptionId], references: [id])
  exclusionId      String?
  exclusion        LcaExclusion?     @relation(fields: [exclusionId], references: [id])
  verificationId   String?
  verification     LcaVerification?  @relation(fields: [verificationId], references: [id])

  blob LcaEvidenceBlob?

  @@index([assessmentId])
}

/// Bytes for evidence held by the built-in database storage provider, kept in
/// its own table so listing evidence never loads file contents.
model LcaEvidenceBlob {
  id         String      @id @default(cuid())
  evidenceId String      @unique
  evidence   LcaEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  data       Bytes
}

// ---------------------------------------------------------------------------
// Calculations
// ---------------------------------------------------------------------------

model LcaCalculationRun {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation("RunsOfAssessment", fields: [assessmentId], references: [id], onDelete: Cascade)

  runAt               DateTime  @default(now())
  runByUserId         String?
  runBy               User?     @relation("LcaRunBy", fields: [runByUserId], references: [id])
  /// The assessment's updatedAt as it stood once this run finished writing.
  /// Staleness is judged against this rather than against runAt, because
  /// storing a run itself touches the assessment row — comparing to runAt
  /// would make every assessment read as out of date the instant it was
  /// calculated.
  assessmentUpdatedAt DateTime?
  engineVersion       String
  methodologyVersion  String?
  /// Everything needed to reproduce this run: methodology configuration and
  /// the factor set(s) each result drew on.
  methodologySnapshot Json?
  factorSnapshot      Json?
  totals              Json
  itemCount           Int       @default(0)
  notes               String?

  results LcaCalculationResult[]

  @@index([assessmentId, runAt])
}

/// One emission figure, with every input to it snapshotted so the row stays
/// readable even if the factor library, methodology or inventory changes.
model LcaCalculationResult {
  id           String            @id @default(cuid())
  runId        String
  run          LcaCalculationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   LcaAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  inventoryItemId  String?
  inventoryItem    LcaInventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  processId        String?
  process          LcaProcess?        @relation(fields: [processId], references: [id])
  transportLegId   String?
  transportLeg     LcaTransportLeg?   @relation(fields: [transportLegId], references: [id])
  endOfLifeRouteId String?
  endOfLifeRoute   LcaEndOfLifeRoute? @relation(fields: [endOfLifeRouteId], references: [id])

  stage          LcaLifecycleStage
  processName    String
  itemName       String
  itemType       LcaItemType
  classification LcaEmissionClassification @default(FOSSIL)
  /// Snapshotted alongside the figure so supplier and material contribution
  /// breakdowns can be rebuilt from a historical run without depending on the
  /// inventory still saying the same thing.
  supplierName   String?
  materialName   String?

  activityValue    Decimal @db.Decimal(24, 10)
  activityUnit     String
  conversionFactor Decimal @db.Decimal(30, 15)
  normalizedValue  Decimal @db.Decimal(24, 10)
  normalizedUnit   String

  factorValue         Decimal                @db.Decimal(24, 10)
  factorUnit          String
  factorSource        String
  factorVersion       String
  factorBoundary      LcaFactorBoundary      @default(UNKNOWN)
  factorGeography     String?
  factorYear          Int?
  factorGwpBasis      String?
  factorSelectionMode LcaFactorSelectionMode
  emissionFactorId    String?
  emissionFactor      EmissionFactor?        @relation("LcaResultFactor", fields: [emissionFactorId], references: [id])
  isPlaceholderFactor Boolean                @default(false)

  allocationMethod LcaAllocationMethod @default(NONE)
  allocationFactor Decimal             @default(1) @db.Decimal(24, 10)
  adjustmentFactor Decimal             @default(1) @db.Decimal(24, 10)

  grossKgCo2e             Decimal @db.Decimal(24, 10)
  allocatedKgCo2e         Decimal @db.Decimal(24, 10)
  perFunctionalUnitKgCo2e Decimal @db.Decimal(24, 10)

  dataType           LcaDataType
  dataQualityScore   Decimal?    @db.Decimal(6, 3)
  uncertaintyPercent Decimal?    @db.Decimal(9, 4)

  formula    String
  /// Ordered activity -> unit -> conversion -> factor -> methodology ->
  /// adjustment/allocation -> calculation -> result steps behind this figure.
  provenance Json

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([assessmentId, stage])
}

// ---------------------------------------------------------------------------
// Versions, verification, audit
// ---------------------------------------------------------------------------

/// A frozen, immutable copy of an assessment at a point in time. Issued
/// versions are never rewritten — a change means a new revision.
model LcaAssessmentVersion {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  version        Int
  label          String?
  status         LcaVersionStatus @default(DRAFT_REVISION)
  issuedAt       DateTime?
  issuedByUserId String?
  issuedBy       User?            @relation("LcaVersionIssuer", fields: [issuedByUserId], references: [id])

  engineVersion      String
  methodologyVersion String?
  calculationRunId   String?
  /// The complete assessment as it stood: goal and scope, model, inventory,
  /// factor snapshots, results, registers, validation and readiness.
  payload            Json

  createdAt DateTime @default(now())

  @@unique([assessmentId, version])
}

model LcaVerification {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  organisation        String
  verifierName        String
  verificationDate    DateTime
  assuranceType       LcaAssuranceType
  scopeOfVerification String
  statementReference  String?
  statementUrl        String?
  conclusion          String?
  notes               String?

  recordedByUserId String?
  recordedBy       User?    @relation("LcaVerificationRecorder", fields: [recordedByUserId], references: [id])
  recordedAt       DateTime @default(now())

  evidence LcaEvidence[]

  @@index([assessmentId])
}

/// Append-only record of every material change. Never updated or deleted.
model LcaAuditEvent {
  id           String         @id @default(cuid())
  assessmentId String?
  assessment   LcaAssessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  entityType String // "assessment", "inventory_item", "process", "supplier_pcf", ...
  entityId   String?
  action     String // "created", "updated", "deleted", "status_changed", "calculated", ...
  summary    String

  actorUserId String?
  actor       User?    @relation("LcaAuditActor", fields: [actorUserId], references: [id])
  occurredAt  DateTime @default(now())

  before   Json?
  after    Json?
  metadata Json?

  @@index([assessmentId, occurredAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// AI layer
//
// Design rule enforced by this schema: AI never owns an accounting number.
// Everything AI produces lands in AiSuggestion / DocumentExtraction, which a
// human must accept before it becomes an ActivityEntry. The deterministic
// calculation engines then do the arithmetic against approved EmissionFactor
// rows, exactly as they already did before AI existed.
//
// The AI layer deliberately adds no life-cycle models of its own: product
// assessment already has a full schema above (LcaAssessment and friends), and
// the LCA copilot reads that rather than a parallel one.
// ---------------------------------------------------------------------------

/// The task types the model router knows about. A model is chosen per task
/// (AiTaskModel), never hard-coded at a call site.
enum AiTaskType {
  GENERAL_CHAT
  CARBON_REASONING
  EMISSION_CLASSIFICATION
  DOCUMENT_EXTRACTION
  DOCUMENT_VISION
  LCA_ASSISTANT
  DATA_QUALITY_REVIEW
  REPORT_ASSISTANT
}

enum AiCallStatus {
  SUCCESS
  VALIDATION_FAILED
  PROVIDER_ERROR
  RATE_LIMITED
  TIMEOUT
  DISABLED
  NO_MODEL_AVAILABLE
  NOT_CONFIGURED
  FORBIDDEN
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
  SUPERSEDED
}

/// How much of an AI call is retained. Full prompts are never stored at any
/// level — see src/lib/ai/audit.ts for what each level keeps and why.
enum AiLoggingLevel {
  MINIMAL
  STANDARD
  VERBOSE
}

/// Provenance of a stored value, so a reader can always tell user-entered
/// data apart from imported, AI-extracted and derived data.
enum DataOrigin {
  USER_ENTERED
  IMPORTED
  AI_EXTRACTED
  DERIVED
}

/// Single-row application configuration for the AI layer (`id` is always
/// "singleton"). Environment variables provide the safe defaults; this table
/// lets an administrator change model routing and safety settings without a
/// code change or redeploy. No API key is ever stored here — the key is read
/// from OPENROUTER_API_KEY server-side only.
model AiSettings {
  id                   String         @id @default("singleton")
  aiEnabled            Boolean        @default(true)
  openRouterEnabled    Boolean        @default(true)
  /// When true the router will only ever call a model whose OpenRouter
  /// pricing metadata confirms it is free. If no free model is available for
  /// a task, the call fails closed with NO_MODEL_AVAILABLE — it never
  /// silently falls through to a paid model.
  freeOnly             Boolean        @default(true)
  /// Whether OpenRouter's own free-model router (openrouter/free) may be used.
  allowFreeRouter      Boolean        @default(true)
  /// Deliberately defaults to OFF: an extraction always goes to a human
  /// review screen before it becomes accounting data.
  autoAcceptExtraction Boolean        @default(false)
  /// Suggestions below this confidence are always marked requiresReview.
  minConfidence        Decimal        @default(0.7) @db.Decimal(4, 3)
  loggingLevel         AiLoggingLevel @default(STANDARD)
  requestsPerMinute    Int            @default(12)
  requestsPerDay       Int            @default(300)

  /// Cached copy of OpenRouter's live model catalogue (GET /api/v1/models),
  /// so free/paid classification and capability checks use the provider's own
  /// current metadata rather than a hand-maintained list in source.
  catalogJson        Json?
  catalogRefreshedAt DateTime?

  updatedByUserId String?
  updatedBy       User?    @relation("AiSettingsUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt       DateTime @updatedAt

  taskModels AiTaskModel[]
}

/// Per-task model assignment, editable by an administrator in the UI.
model AiTaskModel {
  id              String     @id @default(cuid())
  settingsId      String
  settings        AiSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  task            AiTaskType
  modelId         String
  fallbackModelId String?
  updatedAt       DateTime   @updatedAt

  @@unique([settingsId, task])
}

/// One row per AI call attempt — the audit trail for AI activity. Full
/// prompts and raw document text are deliberately not stored (see
/// AiLoggingLevel); API keys never are, at any level.
model AiInteraction {
  id             String       @id @default(cuid())
  task           AiTaskType
  /// Which AIProvider implementation handled the call, e.g. "openrouter".
  provider       String
  feature        String
  modelRequested String
  modelUsed      String?
  status         AiCallStatus
  usedFallback   Boolean      @default(false)
  attempts       Int          @default(1)

  userId String?
  user   User?   @relation("AiInteractionUser", fields: [userId], references: [id])

  entityId    String?
  siteId      String?
  relatedType String?
  relatedId   String?

  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])

  confidence       Decimal? @db.Decimal(4, 3)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  /// Only populated when OpenRouter itself reports a cost — never estimated.
  costUsd          Decimal? @db.Decimal(14, 8)
  latencyMs        Int?

  errorCode     String?
  errorMessage  String?
  outputSummary Json?

  createdAt DateTime @default(now())

  suggestions AiSuggestion[]

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([task, createdAt])
  @@index([status, createdAt])
}

/// An AI-produced proposal awaiting a human decision. Nothing here is
/// authoritative: accepting one is what writes real data, and that write is
/// attributed to the accepting user.
model AiSuggestion {
  id         String             @id @default(cuid())
  task       AiTaskType
  feature    String
  /// What the suggestion is about, e.g. "ACTIVITY_ENTRY", "EMISSION_FACTOR",
  /// "LCA_ASSESSMENT", "DOCUMENT".
  targetType String
  targetId   String?
  status     AiSuggestionStatus @default(PENDING)

  confidence       Decimal? @db.Decimal(4, 3)
  requiresReview   Boolean  @default(true)
  /// Short auditable justification ("Classified as Scope 2 because ...").
  /// Never a chain-of-thought transcript.
  reasoningSummary String?
  payload          Json
  /// What the human actually accepted, when they edited before accepting.
  finalPayload     Json?
  modelUsed        String?

  interactionId String?
  interaction   AiInteraction? @relation(fields: [interactionId], references: [id])

  raisedByUserId String
  raisedBy       User     @relation("AiSuggestionRaisedBy", fields: [raisedByUserId], references: [id])
  createdAt      DateTime @default(now())

  decidedByUserId String?
  decidedBy       User?     @relation("AiSuggestionDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?

  @@index([targetType, targetId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Evidence documents (invoices, Waste Transfer Notes, meter statements ...)
// ---------------------------------------------------------------------------

enum SourceDocumentKind {
  ELECTRICITY_INVOICE
  GAS_INVOICE
  WATER_INVOICE
  FUEL_INVOICE
  WASTE_TRANSFER_NOTE
  WASTE_INVOICE
  TRANSPORT_RECORD
  SUPPLIER_DOCUMENT
  METER_STATEMENT
  OTHER
  UNKNOWN
}

enum DocumentStatus {
  UPLOADED
  EXTRACTED
  EXTRACTION_FAILED
  PARTIALLY_ACCEPTED
  ACCEPTED
  REJECTED
}

/// Uploaded evidence. Bytes live in Postgres so the platform stays a single
/// deployable with no object-store dependency — size-capped in application
/// code (AI_MAX_DOCUMENT_BYTES). Document text is always treated as
/// untrusted content when it reaches a model.
model SourceDocument {
  id       String @id @default(cuid())
  filename String
  mimeType String
  byteSize Int
  /// Content hash — lets a re-upload of the same file be recognised rather
  /// than silently duplicated, and pins the exact bytes an extraction ran on.
  sha256   String
  content  Bytes

  kind   SourceDocumentKind @default(UNKNOWN)
  status DocumentStatus     @default(UPLOADED)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  uploadedByUserId String
  uploadedBy       User     @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now())
  notes            String?

  /// G4: set instead of a hard delete when the document supports an
  /// authoritative record (an ActivityEntry, calculation or LCA evidence).
  /// An archived document drops off the normal document list but its bytes
  /// and extraction history stay intact for audit.
  archivedAt       DateTime?
  archivedByUserId String?
  archivedBy       User?     @relation("DocumentArchivedBy", fields: [archivedByUserId], references: [id])

  extractions     DocumentExtraction[]
  activityEntries ActivityEntry[]
  aiInteractions  AiInteraction[]

  @@index([siteId, uploadedAt])
  @@index([sha256])
}

/// One AI extraction attempt against a document. `payload` is a validated
/// DocumentExtractionResult (see src/lib/ai/schemas.ts) — never raw model
/// output.
model DocumentExtraction {
  id         String         @id @default(cuid())
  documentId String
  document   SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  modelUsed     String?
  status        AiCallStatus
  payload       Json?
  confidence    Decimal?     @db.Decimal(4, 3)
  warnings      String[]
  missingFields String[]
  errorMessage  String?
  interactionId String?

  createdByUserId String
  createdBy       User     @relation("ExtractionCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  reviewedByUserId String?
  reviewedBy       User?     @relation("ExtractionReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?

  acceptedEntries ActivityEntry[] @relation("ExtractionAcceptedEntries")

  @@index([documentId, createdAt])
}

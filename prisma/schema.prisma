// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  DATA_OWNER
  SUSTAINABILITY_LEAD
  FINANCE
  ADMIN
}

// --- Phase 1 tenancy (T10): Organisation is the SaaS tenant above Entity. ---

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum MembershipAccessMode {
  ORGANISATION_WIDE
  RESTRICTED
}

// --- Phase 1 RBAC (T11): configurable roles/permissions per organisation. ---

enum RoleTemplateKey {
  SUSTAINABILITY_LEAD
  EMS_CONTRIBUTOR
  SITE_MANAGER
  AUDITOR
  FINANCE_READ_ONLY
  ORGANISATION_ADMINISTRATOR
}

enum ConsolidationApproach {
  OPERATIONAL_CONTROL
}

enum Scope {
  SCOPE_1
  SCOPE_2
  SCOPE_3
}

enum FormType {
  QUANTITY
  CONTRACT_INFO
  /// Cat 7 employee commuting — a periodic headcount/modal-split survey,
  /// not a single quantity entry (data map row S3-07).
  SURVEY
}

enum EntryStatus {
  SUBMITTED
  FLAGGED
  APPROVED
  REJECTED
  /// Saved, real activity data with no matching EmissionFactor yet (v2:
  /// Scope 3 factors are not seeded as placeholders — see README — so an
  /// entry can be genuinely complete and still be waiting on a real,
  /// imported factor before it produces a figure). Never silently dropped;
  /// surfaced in reports as "awaiting emission factor".
  AWAITING_FACTOR
}

enum FactorBasis {
  STANDARD
  LOCATION_BASED
  MARKET_BASED
  RESIDUAL_MIX
}

/// Phase 1 tenancy (T18) — PHASE1_TENANCY_RBAC_SPEC.md §4: official/global
/// reference sets are PLATFORM (visible to every tenant, mutable only by a
/// platform-operator control plane, not implemented here); supplier-specific
/// and customer-created sets are ORGANISATION (visible/mutable only to their
/// owner). Never inferred from a nullable column — always this explicit flag.
enum FactorVisibility {
  PLATFORM
  ORGANISATION
}

/// Which of the methodology Section 7 sources a factor set came from —
/// lets the platform hold more than one live source per category and
/// resolve between them (OFFICIAL primary, EEIO fallback for Cat 1/2,
/// SUPPLIER_SPECIFIC override where a named supplier has provided one).
enum FactorSourceType {
  OFFICIAL_DEFRA_DESNZ
  EEIO_SPEND_BASED
  SUPPLIER_SPECIFIC
  /// Life-cycle inventory factors (materials, freight, waste routes) used by
  /// the product LCA engine. Held in the same versioned, append-only library
  /// as every other factor set so one import/audit path covers both.
  LCA_SECONDARY
}

enum DataQualityTier {
  TIER_1
  TIER_2
  TIER_3
}

enum TariffType {
  STANDARD
  GREEN
}

// ---------------------------------------------------------------------------
// Organisational structure
// ---------------------------------------------------------------------------

/// Paragon ID, RFID Discovery, Thames Technology — the three operating units
/// consolidated under operational control (methodology Section 3).
model Organisation {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  status              OrganisationStatus @default(ACTIVE)
  timezone            String             @default("Europe/London")
  locale              String             @default("en-GB")
  defaultJurisdiction String             @default("GB-UKM")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  entities    Entity[]
  sites       Site[]
  memberships OrganisationMembership[]
  roles       RoleDefinition[]

  // Carbon-domain roots (T16).
  siteEnergyContracts SiteEnergyContract[]
  activityEntries     ActivityEntry[]
  commutingSurveys    CommutingSurvey[]
  calculations        Calculation[]
  reportSnapshots     ReportSnapshot[]
  sourceDocuments     SourceDocument[]

  // LCA-domain roots (T17). lcaMethodologyProfiles stays nullable/optional —
  // a methodology profile may be platform-shared (organisationId null) —
  // unlike every other relation below, which the T1A contract migration
  // made mandatory.
  lcaSuppliers           Supplier[]
  lcaProducts            Product[]
  lcaMethodologyProfiles LcaMethodologyProfile[]
  lcaAssessments         LcaAssessment[]
  lcaSupplierPcfs        LcaSupplierPcf[]
  lcaEvidence            LcaEvidence[]
  lcaAssessmentVersions  LcaAssessmentVersion[]

  // AI layer and factor administration (T18).
  aiSettings      AiSettings?
  aiInteractions  AiInteraction[]
  aiSuggestions   AiSuggestion[]
  ownedFactorSets EmissionFactorSet[]

  // Platform audit log (T20).
  auditEvents AuditEvent[]

  // Transactional outbox and job framework (T21).
  outboxMessages OutboxMessage[]
  jobRuns        JobRun[]

  // Controlled documents and shared evidence (T22).
  controlledDocuments         ControlledDocument[]
  controlledDocumentRevisions ControlledDocumentRevision[]
  evidenceObjects             EvidenceObject[]
  evidenceLinks               EvidenceLink[]
  documentDistributions       DocumentDistribution[]

  // EMS programme, scope, context and interested parties (T23).
  emsProgrammes               EmsProgramme[]
  emsScopeVersions            EmsScopeVersion[]
  emsScopeEntities            EmsScopeEntity[]
  emsScopeSites               EmsScopeSite[]
  emsScopeActivities          EmsScopeActivity[]
  standardRequirementMaps     StandardRequirementMap[]
  contextIssues               ContextIssue[]
  interestedParties           InterestedParty[]
  interestedPartyRequirements InterestedPartyRequirement[]
  emsRiskOpportunities        EmsRiskOpportunity[]
  changeAssessments           ChangeAssessment[]
  environmentalPolicyRecords  EnvironmentalPolicyRecord[]

  // Notifications and reminders (T24).
  notifications Notification[]
  reminderRules ReminderRule[]

  // Process/activity profiles (T30).
  activityProcesses    ActivityProcess[]
  environmentalAspects EnvironmentalAspect[]
  environmentalImpacts EnvironmentalImpact[]
  aspectImpactLinks    AspectImpactLink[]
  significanceMethods  SignificanceMethod[]
  aspectAssessments    AspectAssessment[]
  significanceCriteria SignificanceCriterion[]

  // Operational controls and review cycle (T33).
  operationalControls       OperationalControl[]
  operationalControlAspects OperationalControlAspect[]
  controlApplicabilities    ControlApplicability[]
  controlChecks             ControlCheck[]

  // External providers, communications and emergency preparedness (T35).
  externalProviderControls       ExternalProviderControl[]
  externalProviderControlAspects ExternalProviderControlAspect[]
  externalProviderEvaluations    ExternalProviderEvaluation[]
  communicationPlans             CommunicationPlan[]
  communicationRecords           CommunicationRecord[]
  emergencyScenarios             EmergencyScenario[]
  emergencyPlans                 EmergencyPlan[]
  emergencyExercises             EmergencyExercise[]
  emergencyExerciseActions       EmergencyExerciseAction[]

  // Legal applicability workflow (T43).
  applicabilityAssessments      ApplicabilityAssessment[]
  applicabilityAssessmentScopes ApplicabilityAssessmentScope[]

  // Compliance obligation versioning and approval (T44).
  complianceObligations               ComplianceObligation[]
  complianceObligationVersions        ComplianceObligationVersion[]
  complianceObligationVersionScopes   ComplianceObligationVersionScope[]
  complianceObligationVersionControls ComplianceObligationVersionControl[]
  complianceObligationApprovals       ComplianceObligationApproval[]
  obligationChangeReviews             ObligationChangeReview[]

  // Compliance evaluation (T45).
  complianceEvaluationProgrammes   ComplianceEvaluationProgramme[]
  complianceEvaluations            ComplianceEvaluation[]
  complianceEvaluationScopes       ComplianceEvaluationScope[]
  complianceEvaluationItems        ComplianceEvaluationItem[]
  complianceEvaluationFindingLinks ComplianceEvaluationFindingLink[]

  // Other requirements and manual legal sources (T46).
  otherRequirementSources OtherRequirementSource[]

  // Objectives and metric definitions (T50).
  environmentalObjectives        EnvironmentalObjective[]
  environmentalObjectiveVersions EnvironmentalObjectiveVersion[]
  objectiveSourceLinks           ObjectiveSourceLink[]
  objectiveApprovals             ObjectiveApproval[]
  objectiveMetricDefinitions     ObjectiveMetricDefinition[]
  objectiveMetricVersions        ObjectiveMetricVersion[]

  // Action programmes and reminders (T52).
  actionProgrammes      ActionProgramme[]
  actionItems           ActionItem[]
  actionDependencies    ActionDependency[]
  actionProgressUpdates ActionProgressUpdate[]
  actionStatusHistory   ActionStatusHistory[]

  // Audit programme and audit execution (T60).
  auditProgrammes          AuditProgramme[]
  auditProgrammeItems      AuditProgrammeItem[]
  auditProgrammeItemScopes AuditProgrammeItemScope[]
  emsAudits                EmsAudit[]
  emsAuditScopes           EmsAuditScope[]
  auditTeamMembers         AuditTeamMember[]

  // Checklists, evidence, findings and frozen report (T61).
  auditChecklistVersions AuditChecklistVersion[]
  auditChecklistItems    AuditChecklistItem[]
  auditQuestionResponses AuditQuestionResponse[]
  auditFindings          AuditFinding[]
  auditReportRevisions   AuditReportRevision[]
  auditCoverageSnapshots AuditCoverageSnapshot[]

  // Environmental incident intake (T62).
  incidentSeverityLevels          IncidentSeverityLevel[]
  incidentEscalationRules         IncidentEscalationRule[]
  environmentalIncidents          EnvironmentalIncident[]
  incidentCorrections             IncidentCorrection[]
  incidentNotificationAssessments IncidentNotificationAssessment[]

  // Nonconformity workflow (T63).
  nonconformityClassifications NonconformityClassification[]
  nonconformityClosurePolicies NonconformityClosurePolicy[]
  nonconformities               Nonconformity[]
  nonconformitySourceLinks      NonconformitySourceLink[]
  containmentRecords            ContainmentRecord[]

  @@index([status])
}

model OrganisationMembership {
  id             String               @id @default(cuid())
  organisationId String
  userId         String
  status         MembershipStatus     @default(INVITED)
  accessMode     MembershipAccessMode @default(ORGANISATION_WIDE)
  invitedAt      DateTime             @default(now())
  activatedAt    DateTime?
  suspendedAt    DateTime?
  removedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Phase 1 tenancy (T19): stubbed invitation-token lifecycle — no email is
  // ever sent; the admin UI surfaces the plaintext token as a copyable link
  // once, at issue/resend time, and only its SHA-256 hash is persisted.
  inviteTokenHash      String?
  inviteTokenExpiresAt DateTime?

  organisation Organisation            @relation(fields: [organisationId], references: [id])
  user         User                    @relation(fields: [userId], references: [id])
  roles        MembershipRole[]
  entityScopes MembershipEntityScope[]
  siteScopes   MembershipSiteScope[]

  // Controlled documents (T22): document ownership and distribution audience.
  ownedControlledDocuments ControlledDocument[]   @relation("ControlledDocumentOwner")
  documentDistributions    DocumentDistribution[] @relation("DocumentDistributionMember")

  // EMS programme foundation (T23): record ownership.
  ownedEmsProgrammes           EmsProgramme[]           @relation("EmsProgrammeOwner")
  ownedStandardRequirementMaps StandardRequirementMap[] @relation("StandardRequirementMapOwner")
  ownedContextIssues           ContextIssue[]           @relation("ContextIssueOwner")
  ownedInterestedParties       InterestedParty[]        @relation("InterestedPartyOwner")
  ownedEmsRiskOpportunities    EmsRiskOpportunity[]     @relation("EmsRiskOpportunityOwner")

  // Notifications and reminders (T24): notifications addressed to this membership.
  receivedNotifications Notification[] @relation("NotificationRecipient")

  // Process/activity profiles (T30): record authorship.
  createdActivityProcesses ActivityProcess[] @relation("ActivityProcessCreatedBy")

  // Significance method and assessment authorship/approval (T32).
  preparedSignificanceMethods SignificanceMethod[] @relation("SignificanceMethodPreparedBy")
  approvedSignificanceMethods SignificanceMethod[] @relation("SignificanceMethodApprovedBy")
  assessedAspectAssessments   AspectAssessment[]   @relation("AspectAssessmentAssessedBy")
  approvedAspectAssessments   AspectAssessment[]   @relation("AspectAssessmentApprovedBy")

  // Operational-control ownership and check review (T33).
  ownedOperationalControls OperationalControl[] @relation("OperationalControlOwner")
  reviewedControlChecks    ControlCheck[]       @relation("ControlCheckReviewer")

  // External providers, communications and emergency preparedness (T35).
  ownedExternalProviderControls ExternalProviderControl[]    @relation("ExternalProviderControlOwner")
  reviewedExternalProviderEvals ExternalProviderEvaluation[] @relation("ExternalProviderEvaluationReviewer")
  ownedCommunicationPlans       CommunicationPlan[]          @relation("CommunicationPlanOwner")
  sentCommunicationRecords      CommunicationRecord[]        @relation("CommunicationRecordSender")
  approvedCommunicationRecords  CommunicationRecord[]        @relation("CommunicationRecordApprover")
  ownedEmergencyExerciseActions EmergencyExerciseAction[]    @relation("EmergencyExerciseActionOwner")

  // Legal applicability workflow (T43).
  assessedApplicabilityAssessments ApplicabilityAssessment[] @relation("ApplicabilityAssessmentAssessedBy")
  reviewedApplicabilityAssessments ApplicabilityAssessment[] @relation("ApplicabilityAssessmentReviewedBy")
  followUpApplicabilityAssessments ApplicabilityAssessment[] @relation("ApplicabilityAssessmentFollowUpOwner")

  // Compliance obligation versioning and approval (T44).
  ownedComplianceObligationVersions ComplianceObligationVersion[]  @relation("ComplianceObligationVersionOwner")
  complianceObligationApprovals     ComplianceObligationApproval[] @relation("ComplianceObligationApprovalApprover")
  obligationChangeReviews           ObligationChangeReview[]       @relation("ObligationChangeReviewReviewer")

  // Other requirements and manual legal sources (T46).
  ownedOtherRequirementSources OtherRequirementSource[] @relation("OtherRequirementSourceOwner")

  // Compliance evaluation (T45).
  ledComplianceEvaluationProgrammes         ComplianceEvaluationProgramme[]   @relation("ComplianceEvaluationProgrammeLead")
  ledComplianceEvaluations                  ComplianceEvaluation[]            @relation("ComplianceEvaluationLead")
  evaluatedComplianceEvaluationItems        ComplianceEvaluationItem[]        @relation("ComplianceEvaluationItemEvaluator")
  requestedComplianceEvaluationFindingLinks ComplianceEvaluationFindingLink[] @relation("ComplianceEvaluationFindingLinkRequestedBy")

  // Objectives and metric definitions (T50).
  ownedEnvironmentalObjectiveVersions EnvironmentalObjectiveVersion[] @relation("EnvironmentalObjectiveVersionOwner")
  objectiveApprovals                  ObjectiveApproval[]             @relation("ObjectiveApprovalApprover")

  // Action programmes and reminders (T52).
  ownedActionProgrammes ActionProgramme[] @relation("ActionProgrammeOwner")
  ownedActionItems      ActionItem[]      @relation("ActionItemOwner")

  // Audit programme and audit execution (T60).
  ownedAuditProgrammes AuditProgramme[]  @relation("AuditProgrammeOwner")
  ledEmsAudits         EmsAudit[]        @relation("EmsAuditLead")
  auditTeamMemberships AuditTeamMember[] @relation("AuditTeamMembership")

  // Checklists, evidence, findings and frozen report (T61).
  auditQuestionResponses AuditQuestionResponse[]
  ownedAuditFindings     AuditFinding[]

  // Environmental incident intake (T62).
  reportedIncidents                  EnvironmentalIncident[]          @relation("EnvironmentalIncidentReporter")
  reviewedIncidentNotificationChecks IncidentNotificationAssessment[] @relation("IncidentNotificationAssessmentReviewer")

  // Nonconformity workflow (T63).
  ownedNonconformities            Nonconformity[]           @relation("NonconformityOwner")
  nonconformitySourceLinksLinked  NonconformitySourceLink[] @relation("NonconformitySourceLinkedBy")
  ownedContainmentRecords         ContainmentRecord[]       @relation("ContainmentRecordOwner")
  reviewedContainmentAdequacy     ContainmentRecord[]       @relation("ContainmentRecordAdequacyReviewer")

  @@unique([organisationId, userId])
  @@unique([organisationId, id])
  @@unique([inviteTokenHash])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Phase 1 RBAC (T11): permission catalogue and configurable role templates.
//
// PermissionDefinition rows are a global, immutable catalogue (codes are
// stable API identifiers and are never reused). RoleDefinition/RolePermission
// are organisation-owned: system templates are cloned into each Organisation
// at provisioning time (T12/T13) rather than referenced from a shared mutable
// role, so editing one organisation's "Sustainability Lead" role can never
// change another organisation's grants.
// ---------------------------------------------------------------------------

model PermissionDefinition {
  code        String   @id
  domain      String
  description String
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([domain])
}

model RoleDefinition {
  id             String           @id @default(cuid())
  organisationId String
  name           String
  description    String?
  templateKey    RoleTemplateKey?
  isSystemSeeded Boolean          @default(false)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id])
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organisationId, name])
  @@unique([organisationId, id])
  @@unique([organisationId, templateKey])
  @@index([organisationId, isActive])
}

model RolePermission {
  organisationId  String
  roleId          String
  permissionCode  String
  grantedAt       DateTime @default(now())
  grantedByUserId String?

  role       RoleDefinition       @relation(fields: [organisationId, roleId], references: [organisationId, id])
  permission PermissionDefinition @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@index([organisationId, permissionCode])
}

model MembershipRole {
  organisationId   String
  membershipId     String
  roleId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String?

  membership OrganisationMembership @relation(fields: [organisationId, membershipId], references: [organisationId, id])
  role       RoleDefinition         @relation(fields: [organisationId, roleId], references: [organisationId, id])

  @@id([membershipId, roleId])
  @@index([organisationId, roleId])
}

model MembershipEntityScope {
  organisationId String
  membershipId   String
  entityId       String

  membership OrganisationMembership @relation(fields: [organisationId, membershipId], references: [organisationId, id])
  entity     Entity                 @relation(fields: [organisationId, entityId], references: [organisationId, id])

  @@id([membershipId, entityId])
  @@index([organisationId, entityId])
}

model MembershipSiteScope {
  organisationId String
  membershipId   String
  siteId         String

  membership OrganisationMembership @relation(fields: [organisationId, membershipId], references: [organisationId, id])
  site       Site                   @relation(fields: [organisationId, siteId], references: [organisationId, id])

  @@id([membershipId, siteId])
  @@index([organisationId, siteId])
}

model Entity {
  id                    String                @id @default(cuid())
  organisationId        String
  organisation          Organisation          @relation(fields: [organisationId], references: [id])
  name                  String
  consolidationApproach ConsolidationApproach @default(OPERATIONAL_CONTROL)
  createdAt             DateTime              @default(now())
  sites                 Site[]

  // Product LCA / PCF
  products            Product[]
  suppliers           Supplier[]
  methodologyProfiles LcaMethodologyProfile[]
  lcaAssessments      LcaAssessment[]
  supplierPcfs        LcaSupplierPcf[]

  // Phase 1 RBAC (T11): membership entity-scope grants
  membershipScopes MembershipEntityScope[]

  // EMS programme foundation (T23): scope-version boundary membership.
  emsScopeEntities EmsScopeEntity[]

  // Process/activity profiles (T30).
  activityProcesses ActivityProcess[]

  // Operational-control applicability (T33).
  controlApplicabilities ControlApplicability[]

  // Legal applicability assessment scopes (T43).
  applicabilityAssessmentScopes ApplicabilityAssessmentScope[]

  // Compliance obligation version scopes (T44).
  complianceObligationVersionScopes ComplianceObligationVersionScope[]

  // Compliance evaluation scopes (T45).
  complianceEvaluationScopes ComplianceEvaluationScope[]

  // Audit programme/execution scopes (T60).
  auditProgrammeItemScopes AuditProgrammeItemScope[]
  emsAuditScopes           EmsAuditScope[]

  // Environmental incident intake (T62).
  environmentalIncidents EnvironmentalIncident[]

  @@unique([organisationId, id])
  // T1A contract migration: replaces the legacy global-unique Entity name —
  // two organisations may now use the same Entity name.
  @@unique([organisationId, name])
  @@index([organisationId])
}

model Site {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  entityId       String
  entity         Entity       @relation(fields: [entityId], references: [id])
  name           String
  address        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  activityEntries  ActivityEntry[]
  energyContracts  SiteEnergyContract[]
  commutingSurveys CommutingSurvey[]

  // Product LCA / PCF
  productManufacturingLocations ProductManufacturingLocation[]
  lcaCorporateDataLinks         LcaCorporateDataLink[]

  // AI layer / evidence documents
  sourceDocuments SourceDocument[]

  // Phase 1 RBAC (T11): membership site-scope grants
  membershipScopes MembershipSiteScope[]

  // Controlled documents (T22): distribution audience by site.
  documentDistributions DocumentDistribution[]

  // EMS programme foundation (T23): scope-version boundary membership.
  emsScopeSites      EmsScopeSite[]
  emsScopeActivities EmsScopeActivity[]

  // Process/activity profiles (T30).
  activityProcesses ActivityProcess[]

  // Operational-control applicability (T33).
  controlApplicabilities ControlApplicability[]

  // Emergency preparedness scenarios (T35).
  emergencyScenarios EmergencyScenario[]

  // Legal applicability assessment scopes (T43).
  applicabilityAssessmentScopes ApplicabilityAssessmentScope[]

  // Compliance obligation version scopes (T44).
  complianceObligationVersionScopes ComplianceObligationVersionScope[]

  // Compliance evaluation scopes (T45).
  complianceEvaluationScopes ComplianceEvaluationScope[]

  // Audit programme/execution scopes (T60).
  auditProgrammeItemScopes AuditProgrammeItemScope[]
  emsAuditScopes           EmsAuditScope[]

  // Environmental incident intake (T62).
  environmentalIncidents EnvironmentalIncident[]

  @@unique([organisationId, id])
  // T1A contract migration: replaces the legacy [entityId, name] unique —
  // now organisation-scoped too, matching Entity's own constraint above.
  @@unique([organisationId, entityId, name])
  @@index([organisationId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// @deprecated Legacy single-tenant role. Superseded by
  /// OrganisationMembership + RBAC (Phase 1); kept for the dual-read/dual-write
  /// compatibility window. Do not use for new authorisation decisions.
  role         Role
  createdAt    DateTime @default(now())

  memberships OrganisationMembership[]

  enteredEntries     ActivityEntry[]      @relation("EnteredBy")
  enteredContracts   SiteEnergyContract[] @relation("ContractEnteredBy")
  calculations       Calculation[]        @relation("CalculatedBy")
  reportSnapshots    ReportSnapshot[]     @relation("GeneratedBy")
  enteredSurveys     CommutingSurvey[]    @relation("SurveyEnteredBy")
  importedFactorSets EmissionFactorSet[]  @relation("FactorSetImportedBy")

  // Product LCA / PCF
  ownedLcaAssessments      LcaAssessment[]        @relation("LcaAssessmentOwner")
  issuedLcaAssessments     LcaAssessment[]        @relation("LcaAssessmentIssuer")
  lcaCalculationRuns       LcaCalculationRun[]    @relation("LcaRunBy")
  issuedLcaVersions        LcaAssessmentVersion[] @relation("LcaVersionIssuer")
  uploadedLcaEvidence      LcaEvidence[]          @relation("LcaEvidenceUploader")
  ownedLcaAssumptions      LcaAssumption[]        @relation("LcaAssumptionOwner")
  approvedLcaAssumptions   LcaAssumption[]        @relation("LcaAssumptionApprover")
  ownedLcaExclusions       LcaExclusion[]         @relation("LcaExclusionOwner")
  approvedLcaExclusions    LcaExclusion[]         @relation("LcaExclusionApprover")
  recordedLcaVerifications LcaVerification[]      @relation("LcaVerificationRecorder")
  lcaAuditEvents           LcaAuditEvent[]        @relation("LcaAuditActor")

  // Platform audit log (T20).
  auditEvents AuditEvent[] @relation("AuditEventActor")

  // --- AI layer / evidence documents ---
  aiSettingsUpdates    AiSettings[]         @relation("AiSettingsUpdatedBy")
  aiInteractions       AiInteraction[]      @relation("AiInteractionUser")
  aiSuggestionsRaised  AiSuggestion[]       @relation("AiSuggestionRaisedBy")
  aiSuggestionsDecided AiSuggestion[]       @relation("AiSuggestionDecidedBy")
  uploadedDocuments    SourceDocument[]     @relation("DocumentUploadedBy")
  createdExtractions   DocumentExtraction[] @relation("ExtractionCreatedBy")
  reviewedExtractions  DocumentExtraction[] @relation("ExtractionReviewedBy")

  // Controlled documents and shared evidence (T22).
  preparedControlledDocumentRevisions ControlledDocumentRevision[] @relation("ControlledDocumentRevisionPreparedBy")
  reviewedControlledDocumentRevisions ControlledDocumentRevision[] @relation("ControlledDocumentRevisionReviewedBy")
  approvedControlledDocumentRevisions ControlledDocumentRevision[] @relation("ControlledDocumentRevisionApprovedBy")
  uploadedEvidenceObjects             EvidenceObject[]             @relation("EvidenceObjectUploadedBy")
  linkedEvidence                      EvidenceLink[]               @relation("EvidenceLinkLinkedBy")

  // EMS programme foundation (T23).
  preparedEmsScopeVersions      EmsScopeVersion[]           @relation("EmsScopeVersionPreparedBy")
  approvedEmsScopeVersions      EmsScopeVersion[]           @relation("EmsScopeVersionApprovedBy")
  preparedChangeAssessments     ChangeAssessment[]          @relation("ChangeAssessmentPreparedBy")
  approvedChangeAssessments     ChangeAssessment[]          @relation("ChangeAssessmentApprovedBy")
  approvedEnvironmentalPolicies EnvironmentalPolicyRecord[] @relation("EnvironmentalPolicyRecordApprovedBy")
  operationalControls           OperationalControl[]

  // External providers, communications and emergency preparedness (T35).
  createdExternalProviderControls ExternalProviderControl[]
  createdEmergencyPlans           EmergencyPlan[]
  recordedEmergencyExercises      EmergencyExercise[]
}

// ---------------------------------------------------------------------------
// Catalog / configuration (seeded from the Data Requirements Map)
// ---------------------------------------------------------------------------

/// One row per data-map entry (S1-01..S1-05, S2-01..S2-04, and future Scope 3
/// rows). Data-entry forms are rendered from this table, not hand-coded per
/// field, so extending scope later is a data change, not a rebuild.
model ActivityDataPoint {
  id               String          @id @default(cuid())
  code             String          @unique // e.g. "S1-01"
  scope            Scope
  category         String // e.g. "Stationary combustion"
  dataPointName    String // e.g. "Natural gas — facilities"
  promptTemplate   String // verbatim plain-English prompt, with [site]/[period] placeholders
  helpText         String? // "Why are we asking this?" tooltip content (technical framing)
  sourceSystemHint String?
  unitOptions      String[] // e.g. ["kWh", "m3"]
  frequency        String // e.g. "Monthly"
  defaultTier      DataQualityTier
  formType         FormType
  buildPriority    String // as tagged in the data map, kept for traceability
  notes            String?
  sortOrder        Int             @default(0)
  factorCategory   String // matches EmissionFactor.category for this data point
  /// GHG Protocol Scope 3 category label (e.g. "Cat 1 — Purchased goods &
  /// services"), null for Scope 1/2. Copied onto every Calculation this
  /// data point produces so reports can group Scope 3 totals by category
  /// without going through this table (needed for Cat 3, which has no
  /// data point of its own — see Calculation.scope3Category).
  scope3Category   String?

  factorOptions FactorOption[]
  entries       ActivityEntry[]
}

/// Selectable sub-type options for a data point that needs one (fuel type,
/// vehicle type, refrigerant type, business-travel mode, commuting mode).
/// subtypeKey matches EmissionFactor.subtypeKey.
model FactorOption {
  id                  String            @id @default(cuid())
  activityDataPointId String
  activityDataPoint   ActivityDataPoint @relation(fields: [activityDataPointId], references: [id])
  label               String // shown in the dropdown, e.g. "Diesel"
  subtypeKey          String // e.g. "diesel", "petrol", "car_average_diesel", "r410a"
  /// Per-option unit override (e.g. "miles" for a rail/flight option,
  /// "nights" for a hotel option) — only set where a data point's options
  /// don't share one common unit (unitOptions). When set, the entry form
  /// uses this instead of showing a unit picker.
  unit                String?
  sortOrder           Int               @default(0)

  entries                  ActivityEntry[]
  commutingSurveyResponses CommutingSurveyResponse[]

  @@unique([activityDataPointId, subtypeKey])
}

// ---------------------------------------------------------------------------
// Emission factors (versioned, never edited in place — only superseded)
// ---------------------------------------------------------------------------

model EmissionFactorSet {
  id               String           @id @default(cuid())
  name             String // e.g. "UK Gov GHG Conversion Factors for Company Reporting 2024 (placeholder)"
  publisher        String // e.g. "DEFRA/DESNZ"
  sourceType       FactorSourceType @default(OFFICIAL_DEFRA_DESNZ)
  /// Only set for sourceType SUPPLIER_SPECIFIC — the named supplier this
  /// set's factors apply to. Matched against ActivityEntry.supplierName
  /// (methodology Section 7: supplier-specific data overrides EEIO/DEFRA
  /// defaults where the Group has entered it).
  supplierName     String?
  vintageYear      Int // year of publication
  publishedDate    DateTime?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  sourceUrl        String?
  isPlaceholder    Boolean          @default(true) // true until a real official file is imported
  notes            String?
  /// Set when this EmissionFactorSet was created via the admin factor
  /// import (Part B) rather than seeded — traceability for who loaded
  /// which file, and when.
  sourceFileName   String?
  importedByUserId String?
  importedBy       User?            @relation("FactorSetImportedBy", fields: [importedByUserId], references: [id])
  createdAt        DateTime         @default(now())

  /// Phase 1 tenancy (T18): PLATFORM for official/global reference sets
  /// (visible to every tenant); ORGANISATION for a supplier-specific or
  /// customer-created set (visible/mutable only to `ownerOrganisationId`).
  /// Assigned from the importing request's OrganisationContext, never from
  /// form input.
  visibility          FactorVisibility @default(PLATFORM)
  ownerOrganisationId String?
  ownerOrganisation   Organisation?    @relation(fields: [ownerOrganisationId], references: [id])

  factors EmissionFactor[]

  @@index([visibility, ownerOrganisationId])
}

model EmissionFactor {
  id          String            @id @default(cuid())
  factorSetId String
  factorSet   EmissionFactorSet @relation(fields: [factorSetId], references: [id])
  scope       Scope
  category    String // e.g. "natural_gas", "grid_electricity", "refrigerant"
  subtypeKey  String? // matches FactorOption.subtypeKey where applicable
  basis       FactorBasis       @default(STANDARD)
  region      String            @default("UK")
  unit        String // the unit the factor is expressed per, e.g. "kWh", "litre", "mile", "kg"
  co2eFactor  Decimal           @db.Decimal(18, 8) // kgCO2e per unit
  notes       String?

  /// Lifecycle metadata, only meaningful for factors used in product LCA
  /// work. Nullable so the corporate factor library is unaffected: a
  /// corporate Scope 1/2 factor has no LCA boundary to declare, while a
  /// cradle-to-gate material factor must declare one or the product model
  /// can silently double-count or gap a stage.
  boundary           LcaFactorBoundary?
  gwpBasis           String? // e.g. "IPCC AR6 (2021), GWP100"
  referenceYear      Int? // the year the factor's underlying data represents
  lcaDataSource      String? // dataset/process name within the publisher's library
  uncertaintyPercent Decimal?           @db.Decimal(9, 4)

  calculations Calculation[]

  lcaInventoryItems         LcaInventoryItem[]     @relation("LcaItemFactor")
  lcaRecycledInventoryItems LcaInventoryItem[]     @relation("LcaItemRecycledFactor")
  lcaTransportLegs          LcaTransportLeg[]      @relation("LcaLegFactor")
  lcaEndOfLifeRoutes        LcaEndOfLifeRoute[]    @relation("LcaEolFactor")
  lcaResults                LcaCalculationResult[] @relation("LcaResultFactor")
  lcaEvidence               LcaEvidence[]          @relation("LcaEvidenceFactor")

  @@unique([factorSetId, category, subtypeKey, basis])
}

// ---------------------------------------------------------------------------
// Transactional data
// ---------------------------------------------------------------------------

/// Supplier/tariff/REGO metadata for a site's electricity, needed for the
/// Scope 2 market-based calculation (data map rows S2-02 / S2-03).
model SiteEnergyContract {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id])
  siteId          String
  site            Site         @relation(fields: [siteId], references: [id])
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  supplierName    String
  tariffType      TariffType
  regoBacked      Boolean      @default(false)
  regoVolumeKwh   Decimal?     @db.Decimal(18, 3)
  source          String?
  enteredByUserId String
  enteredBy       User         @relation("ContractEnteredBy", fields: [enteredByUserId], references: [id])
  enteredAt       DateTime     @default(now())

  @@index([organisationId])
}

model ActivityEntry {
  id                  String            @id @default(cuid())
  organisationId      String
  organisation        Organisation      @relation(fields: [organisationId], references: [id])
  activityDataPointId String
  activityDataPoint   ActivityDataPoint @relation(fields: [activityDataPointId], references: [id])
  siteId              String
  site                Site              @relation(fields: [siteId], references: [id])
  periodStart         DateTime
  periodEnd           DateTime

  rawValue       Decimal @db.Decimal(18, 4)
  rawUnit        String
  canonicalValue Decimal @db.Decimal(18, 8)
  canonicalUnit  String

  factorOptionId String?
  factorOption   FactorOption? @relation(fields: [factorOptionId], references: [id])

  /// Cat 1 (purchased goods & services) only — matched against
  /// EmissionFactorSet.supplierName to look up a supplier-specific factor
  /// override before falling back to EEIO/DEFRA (methodology Section 7).
  /// Null/unused for every other data point.
  supplierName String?

  dataQualityTier     DataQualityTier
  status              EntryStatus     @default(SUBMITTED)
  plausibilityFlagged Boolean         @default(false)
  plausibilityReason  String?
  notes               String?

  /// How this row's activity data reached the platform. AI never writes an
  /// entry on its own: AI_EXTRACTED means a human reviewed and accepted an
  /// AI extraction, and `enteredBy`/`enteredAt` record who accepted it and
  /// when. Defaults to USER_ENTERED so every pre-existing row keeps its
  /// original meaning.
  dataOrigin DataOrigin @default(USER_ENTERED)

  /// The uploaded evidence document this entry was created from, kept
  /// linked for audit (methodology Section 8 evidence trail).
  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])

  /// The AI extraction a human accepted to create this entry, if any.
  acceptedFromExtractionId String?
  acceptedFromExtraction   DocumentExtraction? @relation("ExtractionAcceptedEntries", fields: [acceptedFromExtractionId], references: [id])

  enteredByUserId String
  enteredBy       User     @relation("EnteredBy", fields: [enteredByUserId], references: [id])
  enteredAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  calculations            Calculation[]
  commutingSurveyResponse CommutingSurveyResponse?
  /// Product assessments that cite this corporate record as their source.
  /// Reference only — see LcaCorporateDataLink.
  lcaCorporateDataLinks   LcaCorporateDataLink[]

  @@index([activityDataPointId, siteId, periodStart])
  @@index([sourceDocumentId])
  @@index([organisationId])
}

/// Cat 7 employee commuting (data map row S3-07) — "survey-based initially
/// ... extrapolated across headcount" (methodology Section 9). One header
/// row per site/period capturing the survey-level inputs (headcount,
/// commuting days), so the raw inputs stay in the audit trail; the
/// per-mode responses each become a normal ActivityEntry/Calculation once
/// resolved, reusing the existing calculation + audit-trail pipeline
/// rather than a bespoke one.
model CommutingSurvey {
  id                    String       @id @default(cuid())
  organisationId        String
  organisation          Organisation @relation(fields: [organisationId], references: [id])
  siteId                String
  site                  Site         @relation(fields: [siteId], references: [id])
  periodStart           DateTime
  periodEnd             DateTime
  headcount             Int
  /// User-entered, not assumed — neither source document gives a default
  /// commuting-frequency figure (see README assumptions).
  commutingDaysInPeriod Int
  enteredByUserId       String
  enteredBy             User         @relation("SurveyEnteredBy", fields: [enteredByUserId], references: [id])
  enteredAt             DateTime     @default(now())

  responses CommutingSurveyResponse[]

  @@index([siteId, periodStart])
  @@index([organisationId])
}

model CommutingSurveyResponse {
  id                     String          @id @default(cuid())
  surveyId               String
  survey                 CommutingSurvey @relation(fields: [surveyId], references: [id])
  factorOptionId         String
  factorOption           FactorOption    @relation(fields: [factorOptionId], references: [id])
  percentOfHeadcount     Decimal         @db.Decimal(5, 2)
  avgOneWayDistanceMiles Decimal         @db.Decimal(10, 3)

  /// The derived ActivityEntry once a distance figure has been calculated
  /// and run through the normal calculation pipeline.
  activityEntryId String?        @unique
  activityEntry   ActivityEntry? @relation(fields: [activityEntryId], references: [id])

  @@unique([surveyId, factorOptionId])
}

/// One row per emission figure. Scope 2 electricity entries produce two rows
/// (LOCATION_BASED and MARKET_BASED) from a single entry. Key factor details
/// are snapshotted onto the row itself (not just FK'd) so the audit trail is
/// self-contained even if the EmissionFactor catalog changes later.
model Calculation {
  id              String        @id @default(cuid())
  // Denormalised from the parent ActivityEntry at write time (spec §4:
  // "recommended for export/RLS"). Guarded against a foreign-tenant
  // ActivityEntry ID at the repository layer, same as Site/Entry
  // substitution checks.
  organisationId  String
  organisation    Organisation  @relation(fields: [organisationId], references: [id])
  activityEntryId String
  activityEntry   ActivityEntry @relation(fields: [activityEntryId], references: [id])

  emissionFactorId String
  emissionFactor   EmissionFactor @relation(fields: [emissionFactorId], references: [id])

  scope          Scope
  basis          FactorBasis
  /// GHG Protocol Scope 3 category label, copied from
  /// ActivityDataPoint.scope3Category for Cat 1/6/7 entries, or set
  /// directly by the Cat 3 (fuel/energy-related) auto-derivation job,
  /// which has no ActivityDataPoint of its own to read it from. Null for
  /// Scope 1/2.
  scope3Category String?

  inputValue Decimal @db.Decimal(18, 8)
  inputUnit  String

  // Snapshot of the factor at calculation time (compliance audit trail)
  factorValueSnapshot   Decimal @db.Decimal(18, 8)
  factorUnitSnapshot    String
  factorSourceSnapshot  String // publisher + set name
  factorVintageSnapshot String // vintage year as string, e.g. "2024"
  formulaApplied        String

  resultKgCo2e    Decimal         @db.Decimal(18, 8)
  dataQualityTier DataQualityTier

  calculatedByUserId String?
  calculatedBy       User?    @relation("CalculatedBy", fields: [calculatedByUserId], references: [id])
  calculatedAt       DateTime @default(now())
  engineVersion      String   @default("calc-engine-v1")
  supersededById     String? // if a later recalculation replaced this row's relevance

  /// Set only on Cat 3 (fuel/energy-related) rows auto-derived from a
  /// Scope 1/2 calculation (well-to-tank / T&D losses) — points back at
  /// the Scope 1/2 Calculation it was derived from. The unique constraint
  /// makes re-running the derivation job idempotent: at most one Cat 3
  /// companion row per source calculation, ever.
  derivedFromCalculationId String?      @unique
  derivedFromCalculation   Calculation? @relation("Cat3DerivedFrom", fields: [derivedFromCalculationId], references: [id])
  derivedCategory3Row      Calculation? @relation("Cat3DerivedFrom")

  reportLinks ReportSnapshotCalculation[]

  @@index([activityEntryId])
  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Reporting (append-only, versioned snapshots — never overwritten)
// ---------------------------------------------------------------------------

model ReportSnapshot {
  id                String       @id @default(cuid())
  // An issued snapshot's payload is immutable (spec §4: "cannot mix
  // tenants") — set once at generation from the resolved
  // OrganisationContext, never backfilled by inspecting the frozen payload.
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id])
  version           Int          @default(autoincrement())
  periodStart       DateTime
  periodEnd         DateTime
  generatedByUserId String
  generatedBy       User         @relation("GeneratedBy", fields: [generatedByUserId], references: [id])
  generatedAt       DateTime     @default(now())

  payload Json // frozen computed report: totals, breakdowns, narrative, DQ summary

  calculationLinks ReportSnapshotCalculation[]

  @@index([organisationId])
}

model ReportSnapshotCalculation {
  id               String         @id @default(cuid())
  reportSnapshotId String
  reportSnapshot   ReportSnapshot @relation(fields: [reportSnapshotId], references: [id])
  calculationId    String
  calculation      Calculation    @relation(fields: [calculationId], references: [id])

  @@unique([reportSnapshotId, calculationId])
}

// ===========================================================================
// Product Life Cycle Assessment (LCA) / Product Carbon Footprint (PCF)
//
// A product-level system that sits alongside — never inside — the corporate
// GHG inventory above. Corporate totals (Calculation rows) and product
// totals (LcaCalculationResult rows) are never summed together: a product
// footprint is an intensity figure for one product, a corporate inventory
// is an absolute figure for one organisation. Where a product assessment
// reuses a corporate record as its data source, that reuse is recorded
// explicitly as an LcaCorporateDataLink (reference only, never a transfer
// of emissions in either direction).
// ===========================================================================

enum LcaAssessmentStatus {
  DRAFT
  DATA_COLLECTION
  CALCULATION
  INTERNAL_REVIEW
  READY_FOR_VERIFICATION
  VERIFIED
  SUPERSEDED
}

/// Lifecycle boundary of an assessment. Cradle-to-gate assessments normally
/// report against a declared unit rather than a functional unit, because a
/// function cannot be fully described without the use and end-of-life stages.
enum LcaBoundary {
  CRADLE_TO_GATE
  CRADLE_TO_GRAVE
  CRADLE_TO_CRADLE
  GATE_TO_GATE
  GATE_TO_GRAVE
  CUSTOM
}

enum LcaLifecycleStage {
  RAW_MATERIALS
  INBOUND_TRANSPORT
  MANUFACTURING
  PACKAGING
  DISTRIBUTION
  USE_PHASE
  END_OF_LIFE
  OTHER
}

enum LcaAllocationMethod {
  NONE
  MASS
  PHYSICAL
  ECONOMIC
  MANUAL
}

/// Kept separate on every result row so gross fossil emissions can never be
/// netted down by removals, stored carbon or purchased offsets without that
/// being visible (see LcaCalculationRun totals, which report each class).
enum LcaEmissionClassification {
  FOSSIL
  BIOGENIC
  BIOGENIC_REMOVAL
  TECHNOLOGICAL_REMOVAL
  STORED_CARBON
  /// Credit for a burden avoided elsewhere (e.g. recovered material
  /// displacing virgin production). Only produced when the assessment's
  /// methodology selects an avoided-burden or circular-footprint treatment,
  /// and always carried as its own class so it can be seen rather than
  /// quietly shrinking the gross figure.
  AVOIDED_BURDEN
  OFFSET
}

enum LcaDataType {
  PRIMARY
  SUPPLIER_SPECIFIC
  SECONDARY
  PROXY
  MODELLED
}

enum LcaItemType {
  MATERIAL
  ENERGY
  FUEL
  TRANSPORT
  MANUFACTURING_PROCESS
  PACKAGING
  WASTE
  WATER
  USE_PHASE
  END_OF_LIFE
  SUPPLIER_PCF
  OTHER
}

enum LcaTransportMode {
  ROAD
  RAIL
  SEA
  AIR
  INLAND_WATERWAY
  MULTIMODAL
  CUSTOM
}

enum LcaEndOfLifeRouteType {
  LANDFILL
  RECYCLING
  INCINERATION_ENERGY_RECOVERY
  INCINERATION_NO_RECOVERY
  REUSE
  COMPOSTING
  CUSTOM
}

enum LcaUncertaintyStatus {
  NOT_ASSESSED
  QUALITATIVE
  ESTIMATED
  QUANTIFIED
}

enum LcaMateriality {
  LOW
  MEDIUM
  HIGH
}

enum LcaAssuranceType {
  NONE
  INTERNAL_REVIEW
  CRITICAL_REVIEW
  LIMITED_ASSURANCE
  REASONABLE_ASSURANCE
}

enum LcaPcfVerificationStatus {
  UNVERIFIED
  SELF_DECLARED
  SECOND_PARTY_REVIEWED
  THIRD_PARTY_VERIFIED
}

/// What a factor actually covers. Selecting a cradle-to-grave factor for a
/// cradle-to-gate model (or applying a combustion-only factor as if it were
/// well-to-wheel) is a silent double-count or gap, so it is recorded and
/// validated rather than assumed.
enum LcaFactorBoundary {
  UNKNOWN
  CRADLE_TO_GATE
  CRADLE_TO_GRAVE
  GATE_TO_GATE
  UPSTREAM
  DOWNSTREAM
  COMBUSTION_ONLY
  WELL_TO_TANK
  WELL_TO_WHEEL
  END_OF_LIFE
}

enum LcaFactorSelectionMode {
  NONE
  LIBRARY_FACTOR
  SUPPLIER_PCF
  MANUAL
}

enum LcaVersionStatus {
  DRAFT_REVISION
  ISSUED
  SUPERSEDED
}

enum LcaBiogenicTreatment {
  EXCLUDED
  REPORTED_SEPARATELY
  INCLUDED_IN_TOTAL
}

/// No single universal recycling methodology is hard-coded — the choice is
/// recorded per methodology profile and applied by the engine.
enum LcaRecyclingMethod {
  CUT_OFF
  AVOIDED_BURDEN
  CIRCULAR_FOOTPRINT_FORMULA
  MANUAL
}

enum LcaElectricityApproach {
  LOCATION_BASED
  MARKET_BASED
  DUAL_REPORTED
}

enum LcaOffsetTreatment {
  EXCLUDED
  DISCLOSED_SEPARATELY
}

enum LcaProductStatus {
  ACTIVE
  DISCONTINUED
}

enum LcaEvidenceKind {
  EXTERNAL_LINK
  UPLOADED_FILE
  SYSTEM_RECORD
}

enum LcaCorporateLinkType {
  FACILITY_ENERGY
  SUPPLIER_RECORD
  SCOPE3_ACTIVITY
  OTHER
}

// ---------------------------------------------------------------------------
// Suppliers, products
// ---------------------------------------------------------------------------

/// A first-class supplier record. The corporate side of the platform matches
/// suppliers by free-text name (ActivityEntry.supplierName /
/// EmissionFactorSet.supplierName); `name` is kept aligned with that string
/// so a supplier-specific corporate factor set and a product-level supplier
/// PCF can be recognised as the same counterparty.
model Supplier {
  id             String       @id @default(cuid())
  entityId       String
  entity         Entity       @relation(fields: [entityId], references: [id])
  // Denormalised from the owning Entity at write time; the tenant
  // repository asserts it against ctx.organisationId rather than trusting a
  // client-supplied value.
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  identifier     String? // internal supplier code, DUNS, VAT number...
  country        String?
  contact        String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  productPcfs    LcaSupplierPcf[]
  inventoryItems LcaInventoryItem[]

  @@unique([entityId, name])
  @@index([organisationId])
}

model Product {
  id             String           @id @default(cuid())
  entityId       String
  entity         Entity           @relation(fields: [entityId], references: [id])
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id])
  name           String
  sku            String
  description    String?
  category       String?
  status         LcaProductStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  versions ProductVersion[]

  @@unique([entityId, sku])
  @@index([entityId])
  @@index([organisationId])
}

model ProductVersion {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  versionLabel  String // e.g. "Rev A", "2026 build"
  description   String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  manufacturingLocations ProductManufacturingLocation[]
  assessments            LcaAssessment[]

  @@unique([productId, versionLabel])
}

/// Where this product version is made. Optionally points at an internal Site
/// so a product assessment can pull facility energy from the corporate
/// inventory for the right building (see LcaCorporateDataLink).
model ProductManufacturingLocation {
  id               String         @id @default(cuid())
  productVersionId String
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  name             String
  country          String?
  siteId           String?
  site             Site?          @relation(fields: [siteId], references: [id])
  isPrimary        Boolean        @default(false)
  notes            String?
}

// ---------------------------------------------------------------------------
// Methodology register — structured configuration, not prose
// ---------------------------------------------------------------------------

model LcaMethodologyProfile {
  id             String        @id @default(cuid())
  entityId       String?
  entity         Entity?       @relation(fields: [entityId], references: [id])
  // Deliberately excluded from the T1A contract migration's NOT NULL pass:
  // null stays possible for a genuinely platform-shared profile (entityId
  // is already optional for the same reason); the LCA repository's
  // visibility resolver treats null organisationId here as platform-shared,
  // never as "belongs to no one so anyone may edit it".
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  name    String
  version String
  summary String?

  defaultBoundary           LcaBoundary            @default(CRADLE_TO_GATE)
  gwpBasis                  String // e.g. "IPCC AR6 (2021), GWP100"
  defaultAllocationMethod   LcaAllocationMethod    @default(MASS)
  allocationRules           String?
  recyclingMethod           LcaRecyclingMethod     @default(CUT_OFF)
  recyclingRules            String?
  electricityApproach       LcaElectricityApproach @default(LOCATION_BASED)
  electricityRules          String?
  biogenicTreatment         LcaBiogenicTreatment   @default(REPORTED_SEPARATELY)
  biogenicRules             String?
  removalsRules             String?
  offsetTreatment           LcaOffsetTreatment     @default(DISCLOSED_SEPARATELY)
  offsetRules               String?
  cutOffRules               String? // e.g. "exclude flows < 1% of mass and < 1% of estimated impact, max 5% total"
  cutOffThresholdPercent    Decimal?               @db.Decimal(6, 3)
  /// Ordered list of factor sources, most preferred first — the hierarchy the
  /// factor resolver and the validation engine both read.
  factorHierarchy           String[]
  dataQualityRequirements   String?
  /// Minimum acceptable pedigree score (1 best .. 5 worst) for an assessment
  /// to be considered ready for independent review.
  minimumDataQualityScore   Decimal?               @db.Decimal(4, 2)
  requireEvidenceForPrimary Boolean                @default(true)
  standardsReferenced       String[]
  notes                     String?
  isDefault                 Boolean                @default(false)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  assessments LcaAssessment[]

  @@unique([name, version])
  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

model LcaAssessment {
  id               String         @id @default(cuid())
  entityId         String
  entity           Entity         @relation(fields: [entityId], references: [id])
  productVersionId String
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id])
  // This is the externally addressable root every LCA detail page, export
  // route and evidence/version lookup starts from, so it gets a direct
  // column rather than relying solely on the Entity join (spec §4: "Add
  // direct organisation ID to externally addressable/exportable roots").
  organisationId   String
  organisation     Organisation   @relation(fields: [organisationId], references: [id])

  reference String
  title     String

  status LcaAssessmentStatus @default(DRAFT)

  // --- versioning -------------------------------------------------------
  version                  Int             @default(1)
  versionLabel             String?
  parentAssessmentId       String?
  parentAssessment         LcaAssessment?  @relation("AssessmentRevisions", fields: [parentAssessmentId], references: [id])
  revisions                LcaAssessment[] @relation("AssessmentRevisions")
  supersededByAssessmentId String?         @unique
  supersededBy             LcaAssessment?  @relation("AssessmentSupersession", fields: [supersededByAssessmentId], references: [id])
  supersedes               LcaAssessment?  @relation("AssessmentSupersession")

  // --- scenario modelling ----------------------------------------------
  /// A scenario is a full, independent copy of a baseline assessment, so a
  /// scenario edit can never write over baseline data.
  isScenario           Boolean         @default(false)
  baselineAssessmentId String?
  baselineAssessment   LcaAssessment?  @relation("ScenarioOf", fields: [baselineAssessmentId], references: [id])
  scenarioCopies       LcaAssessment[] @relation("ScenarioOf")
  scenarioDescription  String?

  // --- goal & scope -----------------------------------------------------
  goal                          String?
  intendedApplication           String?
  intendedAudience              String?
  comparativeAssertionDisclosed Boolean             @default(false)
  scopeDescription              String?
  boundary                      LcaBoundary         @default(CRADLE_TO_GATE)
  boundaryNotes                 String?
  includedStages                LcaLifecycleStage[]
  periodStart                   DateTime?
  periodEnd                     DateTime?
  ownerUserId                   String?
  owner                         User?               @relation("LcaAssessmentOwner", fields: [ownerUserId], references: [id])

  // --- functional / declared unit and reference flow ---------------------
  functionalUnitDescription String?
  functionalUnitQuantity    Decimal @default(1) @db.Decimal(24, 10)
  functionalUnitUnit        String?
  isDeclaredUnit            Boolean @default(false)
  declaredUnitDescription   String?
  referenceFlowDescription  String?
  referenceFlowQuantity     Decimal @default(1) @db.Decimal(24, 10)
  referenceFlowUnit         String?
  /// How much product the entered inventory represents (e.g. one batch of
  /// 500 units). The engine divides model totals by the number of functional
  /// units this represents to get the per-functional-unit figure.
  modelledOutputQuantity    Decimal @default(1) @db.Decimal(24, 10)
  modelledOutputUnit        String?
  modelledOutputDescription String?

  // --- methodology ------------------------------------------------------
  methodologyProfileId String?
  methodologyProfile   LcaMethodologyProfile? @relation(fields: [methodologyProfileId], references: [id])
  /// Frozen copy of the methodology profile taken when a version is issued,
  /// so an issued assessment's methodology can never change under it.
  methodologySnapshot  Json?
  methodologyNotes     String?

  usePhaseLifetimeYears Decimal? @db.Decimal(12, 4)
  usePhaseAssumptions   String?

  // --- narrative --------------------------------------------------------
  completenessNotes String?
  limitations       String?
  interpretation    String?

  engineVersion        String    @default("lca-engine-v1")
  lastCalculationRunId String?   @unique
  issuedAt             DateTime?
  issuedByUserId       String?
  issuedBy             User?     @relation("LcaAssessmentIssuer", fields: [issuedByUserId], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  processes       LcaProcess[]
  inventoryItems  LcaInventoryItem[]
  assumptions     LcaAssumption[]
  exclusions      LcaExclusion[]
  evidence        LcaEvidence[]
  calculationRuns LcaCalculationRun[]    @relation("RunsOfAssessment")
  results         LcaCalculationResult[]
  versions        LcaAssessmentVersion[]
  verifications   LcaVerification[]
  auditEvents     LcaAuditEvent[]

  @@unique([entityId, reference])
  @@index([entityId, status])
  @@index([productVersionId])
  @@index([organisationId, status])
}

/// A unit process in the lifecycle model. Self-referencing so a stage can be
/// broken down as deeply as the modeller needs (e.g. Manufacturing ->
/// Injection moulding -> Drying), with allocation applied at whichever level
/// the multi-output split actually happens.
model LcaProcess {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  parentProcessId String?
  parentProcess   LcaProcess?  @relation("ProcessTree", fields: [parentProcessId], references: [id])
  childProcesses  LcaProcess[] @relation("ProcessTree")

  stage       LcaLifecycleStage
  name        String
  description String?
  sortOrder   Int               @default(0)
  isIncluded  Boolean           @default(true)

  allocationMethod           LcaAllocationMethod @default(NONE)
  /// Share of this process's emissions attributed to the assessed product,
  /// as a percentage. Derived from process outputs for MASS/PHYSICAL/ECONOMIC,
  /// entered directly for MANUAL, always 100 for NONE.
  allocationPercent          Decimal             @default(100) @db.Decimal(9, 6)
  allocationRationale        String?
  allocationBasisDescription String?

  geography String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outputs        LcaProcessOutput[]
  inventoryItems LcaInventoryItem[]
  results        LcaCalculationResult[]
  assumptions    LcaAssumption[]
  exclusions     LcaExclusion[]
  evidence       LcaEvidence[]

  @@index([assessmentId, stage])
}

/// Co-products of a multi-output process. The engine computes the allocation
/// factor from these according to the process's allocation method, so the
/// split is reproducible and auditable rather than a typed-in number.
model LcaProcessOutput {
  id        String     @id @default(cuid())
  processId String
  process   LcaProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  name              String
  isAssessedProduct Boolean  @default(false)
  massValue         Decimal? @db.Decimal(24, 10)
  massUnit          String?
  physicalValue     Decimal? @db.Decimal(24, 10)
  physicalUnit      String?
  economicValue     Decimal? @db.Decimal(24, 10)
  economicCurrency  String?
  manualPercent     Decimal? @db.Decimal(9, 6)
  notes             String?
  sortOrder         Int      @default(0)
}

/// One activity-data line: a material, an energy input, a freight movement,
/// a waste flow, a supplier PCF, and so on. Everything the calculation
/// engine consumes comes from this table.
model LcaInventoryItem {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  processId    String
  process      LcaProcess    @relation(fields: [processId], references: [id], onDelete: Cascade)

  itemType    LcaItemType
  name        String
  description String?
  sortOrder   Int         @default(0)

  // --- bill of materials attributes (material/packaging items) ----------
  componentName          String?
  partNumber             String?
  materialName           String?
  recycledContentPercent Decimal? @db.Decimal(9, 6)
  /// Manufacturing loss on this input: gross input = quantity / (1 - waste%).
  wastePercent           Decimal? @db.Decimal(9, 6)

  // --- activity data ----------------------------------------------------
  quantity            Decimal @db.Decimal(24, 10)
  unit                String
  // The quantity expressed in the factor's own unit is NOT stored here: it is
  // an output of a calculation run and lives on the result row, which also
  // records the conversion that produced it. Copying it back onto the
  // inventory would give the same figure two homes and, because writing it
  // touches the row, would make every line read as changed the moment it was
  // calculated.
  /// Extra multiplier applied after unit conversion — e.g. "x 3 uses per year
  /// x 5 years". Always shown as its own provenance step, never folded in.
  adjustmentFactor    Decimal @default(1) @db.Decimal(24, 10)
  adjustmentRationale String?

  // --- provenance of the activity data ----------------------------------
  dataType    LcaDataType @default(SECONDARY)
  dataSource  String?
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  geography   String?
  periodStart DateTime?
  periodEnd   DateTime?
  notes       String?

  // --- factor selection --------------------------------------------------
  factorSelectionMode      LcaFactorSelectionMode @default(NONE)
  emissionFactorId         String?
  emissionFactor           EmissionFactor?        @relation("LcaItemFactor", fields: [emissionFactorId], references: [id])
  /// Optional second factor used for the recycled share of a material, so
  /// recycled content changes the result only when a sourced recycled-route
  /// factor actually exists — never through an invented discount.
  recycledEmissionFactorId String?
  recycledEmissionFactor   EmissionFactor?        @relation("LcaItemRecycledFactor", fields: [recycledEmissionFactorId], references: [id])
  supplierPcfId            String?
  supplierPcf              LcaSupplierPcf?        @relation(fields: [supplierPcfId], references: [id])

  manualFactorValue     Decimal?           @db.Decimal(24, 10)
  manualFactorUnit      String?
  manualFactorSource    String?
  manualFactorVersion   String?
  manualFactorBoundary  LcaFactorBoundary?
  manualFactorGeography String?
  manualFactorYear      Int?
  manualFactorGwpBasis  String?
  manualFactorRationale String?

  // --- carbon classification --------------------------------------------
  classification        LcaEmissionClassification @default(FOSSIL)
  /// Biogenic carbon taken out of the atmosphere and held in this input,
  /// expressed as kgCO2e per unit of the item's own quantity. Always
  /// reported as its own class — never netted off the fossil total.
  biogenicUptakePerUnit Decimal?                  @db.Decimal(24, 10)
  storedCarbonPerUnit   Decimal?                  @db.Decimal(24, 10)

  // --- data quality (pedigree, 1 best .. 5 worst) ------------------------
  temporalScore      Int?
  geographicalScore  Int?
  technologicalScore Int?
  completenessScore  Int?
  reliabilityScore   Int?

  // --- uncertainty -------------------------------------------------------
  uncertaintyStatus  LcaUncertaintyStatus @default(NOT_ASSESSED)
  uncertaintyPercent Decimal?             @db.Decimal(9, 4)
  uncertaintyLower   Decimal?             @db.Decimal(24, 10)
  uncertaintyUpper   Decimal?             @db.Decimal(24, 10)
  uncertaintyNotes   String?

  isExcluded      Boolean @default(false)
  exclusionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportLegs   LcaTransportLeg[]
  endOfLifeRoutes LcaEndOfLifeRoute[]
  results         LcaCalculationResult[]
  evidence        LcaEvidence[]
  assumptions     LcaAssumption[]
  corporateLinks  LcaCorporateDataLink[]

  @@index([assessmentId, itemType])
  @@index([processId])
}

/// One movement in a freight chain. A multimodal journey is several legs on
/// one TRANSPORT item; each leg produces its own result row so the register
/// export shows the tonne-km arithmetic leg by leg.
model LcaTransportLeg {
  id              String           @id @default(cuid())
  inventoryItemId String
  inventoryItem   LcaInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  sequence        Int              @default(0)
  mode            LcaTransportMode
  modeDescription String?
  originName      String?
  destinationName String?

  distanceValue      Decimal  @db.Decimal(24, 10)
  distanceUnit       String   @default("km")
  massValue          Decimal  @db.Decimal(24, 10)
  massUnit           String   @default("kg")
  /// Share of the vehicle's payload attributable to this consignment, and
  /// whether the return leg is included — both change the answer materially
  /// and neither is assumed.
  loadFactorPercent  Decimal? @db.Decimal(9, 6)
  includesReturnTrip Boolean  @default(false)

  emissionFactorId   String?
  emissionFactor     EmissionFactor? @relation("LcaLegFactor", fields: [emissionFactorId], references: [id])
  manualFactorValue  Decimal?        @db.Decimal(24, 10)
  manualFactorUnit   String?
  manualFactorSource String?

  assumptions String?
  notes       String?

  results LcaCalculationResult[]

  @@index([inventoryItemId])
}

/// One end-of-life (or production-waste) route for an item's mass. Route
/// percentages for an item must total 100%, which the validation engine
/// enforces rather than silently normalising.
model LcaEndOfLifeRoute {
  id              String           @id @default(cuid())
  inventoryItemId String
  inventoryItem   LcaInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  route            LcaEndOfLifeRouteType
  routeDescription String?
  percent          Decimal               @db.Decimal(9, 6)

  emissionFactorId   String?
  emissionFactor     EmissionFactor? @relation("LcaEolFactor", fields: [emissionFactorId], references: [id])
  manualFactorValue  Decimal?        @db.Decimal(24, 10)
  manualFactorUnit   String?
  manualFactorSource String?

  /// Recovery/credit figures are only applied when the assessment's
  /// methodology profile says to (AVOIDED_BURDEN / CIRCULAR_FOOTPRINT), and
  /// are always reported as their own line, never merged into gross.
  recoveryRatePercent Decimal? @db.Decimal(9, 6)
  avoidedFactorValue  Decimal? @db.Decimal(24, 10)
  avoidedFactorUnit   String?
  avoidedFactorSource String?
  recoveryAssumptions String?
  notes               String?

  results LcaCalculationResult[]

  @@index([inventoryItemId])
}

// ---------------------------------------------------------------------------
// Supplier product carbon footprints
// ---------------------------------------------------------------------------

model LcaSupplierPcf {
  id             String       @id @default(cuid())
  entityId       String
  entity         Entity       @relation(fields: [entityId], references: [id])
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  // Distinguishes this tenant-owned supplier PCF register from the
  // platform-shared EmissionFactor library (spec T17 acceptance: "shared/
  // global factors are explicitly distinguished from tenant-owned supplier
  // factors") — a supplier PCF is never resolved into another organisation's
  // inventory item even though EmissionFactorSet itself stays platform-global.
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  productName       String
  productIdentifier String?
  productCategory   String?

  /// kgCO2e per declared unit, excluding biogenic where the supplier reports
  /// the two separately.
  pcfValue                Decimal  @db.Decimal(24, 10)
  pcfBiogenicValue        Decimal? @db.Decimal(24, 10)
  declaredUnitQuantity    Decimal  @default(1) @db.Decimal(24, 10)
  declaredUnitUnit        String
  declaredUnitDescription String?

  boundary             LcaBoundary
  boundaryNotes        String?
  methodology          String?
  methodologyVersion   String?
  gwpBasis             String?
  reportingPeriodStart DateTime?
  reportingPeriodEnd   DateTime?
  geography            String?

  verificationStatus LcaPcfVerificationStatus @default(UNVERIFIED)
  verifierName       String?
  verificationDate   DateTime?
  assuranceType      LcaAssuranceType         @default(NONE)

  primaryDataSharePercent Decimal? @db.Decimal(9, 6)
  temporalScore           Int?
  geographicalScore       Int?
  technologicalScore      Int?
  completenessScore       Int?
  reliabilityScore        Int?
  uncertaintyPercent      Decimal? @db.Decimal(9, 4)

  /// Set when this record was created by importing a PACT-aligned exchange
  /// document, with the source payload kept verbatim for audit.
  sourceFormat  String?
  sourcePayload Json?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems LcaInventoryItem[]
  evidence       LcaEvidence[]

  @@index([entityId])
  @@index([supplierId])
  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Registers: assumptions, exclusions, corporate links, evidence
// ---------------------------------------------------------------------------

model LcaAssumption {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  assumption  String
  category    String
  rationale   String
  source      String?
  uncertainty String?
  materiality LcaMateriality @default(MEDIUM)

  ownerUserId      String?
  owner            User?     @relation("LcaAssumptionOwner", fields: [ownerUserId], references: [id])
  approvedByUserId String?
  approvedBy       User?     @relation("LcaAssumptionApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  recordedAt       DateTime  @default(now())

  processId       String?
  process         LcaProcess?       @relation(fields: [processId], references: [id])
  inventoryItemId String?
  inventoryItem   LcaInventoryItem? @relation(fields: [inventoryItemId], references: [id])

  evidence LcaEvidence[]

  @@index([assessmentId])
}

model LcaExclusion {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  excludedItem            String
  rationale               String
  estimatedRelevance      String
  estimatedPercentOfTotal Decimal? @db.Decimal(9, 4)

  ownerUserId      String?
  owner            User?     @relation("LcaExclusionOwner", fields: [ownerUserId], references: [id])
  approvedByUserId String?
  approvedBy       User?     @relation("LcaExclusionApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  recordedAt       DateTime  @default(now())

  processId String?
  process   LcaProcess? @relation(fields: [processId], references: [id])

  evidence LcaEvidence[]

  @@index([assessmentId])
}

/// Records that a product inventory line was sourced from an existing
/// corporate record. Reference only: no emissions move between the corporate
/// inventory and the product footprint in either direction, and both figures
/// remain complete in their own right.
model LcaCorporateDataLink {
  id              String           @id @default(cuid())
  inventoryItemId String
  inventoryItem   LcaInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  linkType        LcaCorporateLinkType
  activityEntryId String?
  activityEntry   ActivityEntry?       @relation(fields: [activityEntryId], references: [id])
  siteId          String?
  site            Site?                @relation(fields: [siteId], references: [id])
  supplierName    String?

  /// Share of the corporate figure attributed to this product line, and how
  /// that share was arrived at.
  allocationPercent Decimal  @default(100) @db.Decimal(9, 6)
  allocationBasis   String?
  notes             String?
  createdAt         DateTime @default(now())

  @@index([inventoryItemId])
}

model LcaEvidence {
  id             String        @id @default(cuid())
  assessmentId   String
  assessment     LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  // Evidence has its own externally addressable download route
  // (/api/lca/evidence/[id]), so — like ReportSnapshot/Calculation — it gets
  // a direct column rather than requiring every lookup to join through
  // assessment -> entity -> organisation first.
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id])

  title       String
  description String?
  kind        LcaEvidenceKind @default(EXTERNAL_LINK)

  externalUrl     String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  checksumSha256  String?
  /// Storage backend that holds the bytes. "database" is the built-in
  /// fallback used when no object-storage credentials are configured; the
  /// service layer can route to another provider without a schema change.
  storageProvider String?
  storageKey      String?

  uploadedByUserId String?
  uploadedBy       User?    @relation("LcaEvidenceUploader", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now())

  processId        String?
  process          LcaProcess?       @relation(fields: [processId], references: [id])
  inventoryItemId  String?
  inventoryItem    LcaInventoryItem? @relation(fields: [inventoryItemId], references: [id])
  emissionFactorId String?
  emissionFactor   EmissionFactor?   @relation("LcaEvidenceFactor", fields: [emissionFactorId], references: [id])
  supplierPcfId    String?
  supplierPcf      LcaSupplierPcf?   @relation(fields: [supplierPcfId], references: [id])
  assumptionId     String?
  assumption       LcaAssumption?    @relation(fields: [assumptionId], references: [id])
  exclusionId      String?
  exclusion        LcaExclusion?     @relation(fields: [exclusionId], references: [id])
  verificationId   String?
  verification     LcaVerification?  @relation(fields: [verificationId], references: [id])

  blob LcaEvidenceBlob?

  @@index([assessmentId])
  @@index([organisationId])
}

/// Bytes for evidence held by the built-in database storage provider, kept in
/// its own table so listing evidence never loads file contents.
model LcaEvidenceBlob {
  id         String      @id @default(cuid())
  evidenceId String      @unique
  evidence   LcaEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  data       Bytes
}

// ---------------------------------------------------------------------------
// Calculations
// ---------------------------------------------------------------------------

model LcaCalculationRun {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation("RunsOfAssessment", fields: [assessmentId], references: [id], onDelete: Cascade)

  runAt               DateTime  @default(now())
  runByUserId         String?
  runBy               User?     @relation("LcaRunBy", fields: [runByUserId], references: [id])
  /// The assessment's updatedAt as it stood once this run finished writing.
  /// Staleness is judged against this rather than against runAt, because
  /// storing a run itself touches the assessment row — comparing to runAt
  /// would make every assessment read as out of date the instant it was
  /// calculated.
  assessmentUpdatedAt DateTime?
  engineVersion       String
  methodologyVersion  String?
  /// Everything needed to reproduce this run: methodology configuration and
  /// the factor set(s) each result drew on.
  methodologySnapshot Json?
  factorSnapshot      Json?
  totals              Json
  itemCount           Int       @default(0)
  notes               String?

  results LcaCalculationResult[]

  @@index([assessmentId, runAt])
}

/// One emission figure, with every input to it snapshotted so the row stays
/// readable even if the factor library, methodology or inventory changes.
model LcaCalculationResult {
  id           String            @id @default(cuid())
  runId        String
  run          LcaCalculationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   LcaAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  inventoryItemId  String?
  inventoryItem    LcaInventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  processId        String?
  process          LcaProcess?        @relation(fields: [processId], references: [id])
  transportLegId   String?
  transportLeg     LcaTransportLeg?   @relation(fields: [transportLegId], references: [id])
  endOfLifeRouteId String?
  endOfLifeRoute   LcaEndOfLifeRoute? @relation(fields: [endOfLifeRouteId], references: [id])

  stage          LcaLifecycleStage
  processName    String
  itemName       String
  itemType       LcaItemType
  classification LcaEmissionClassification @default(FOSSIL)
  /// Snapshotted alongside the figure so supplier and material contribution
  /// breakdowns can be rebuilt from a historical run without depending on the
  /// inventory still saying the same thing.
  supplierName   String?
  materialName   String?

  activityValue    Decimal @db.Decimal(24, 10)
  activityUnit     String
  conversionFactor Decimal @db.Decimal(30, 15)
  normalizedValue  Decimal @db.Decimal(24, 10)
  normalizedUnit   String

  factorValue         Decimal                @db.Decimal(24, 10)
  factorUnit          String
  factorSource        String
  factorVersion       String
  factorBoundary      LcaFactorBoundary      @default(UNKNOWN)
  factorGeography     String?
  factorYear          Int?
  factorGwpBasis      String?
  factorSelectionMode LcaFactorSelectionMode
  emissionFactorId    String?
  emissionFactor      EmissionFactor?        @relation("LcaResultFactor", fields: [emissionFactorId], references: [id])
  isPlaceholderFactor Boolean                @default(false)

  allocationMethod LcaAllocationMethod @default(NONE)
  allocationFactor Decimal             @default(1) @db.Decimal(24, 10)
  adjustmentFactor Decimal             @default(1) @db.Decimal(24, 10)

  grossKgCo2e             Decimal @db.Decimal(24, 10)
  allocatedKgCo2e         Decimal @db.Decimal(24, 10)
  perFunctionalUnitKgCo2e Decimal @db.Decimal(24, 10)

  dataType           LcaDataType
  dataQualityScore   Decimal?    @db.Decimal(6, 3)
  uncertaintyPercent Decimal?    @db.Decimal(9, 4)

  formula    String
  /// Ordered activity -> unit -> conversion -> factor -> methodology ->
  /// adjustment/allocation -> calculation -> result steps behind this figure.
  provenance Json

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([assessmentId, stage])
}

// ---------------------------------------------------------------------------
// Versions, verification, audit
// ---------------------------------------------------------------------------

/// A frozen, immutable copy of an assessment at a point in time. Issued
/// versions are never rewritten — a change means a new revision.
model LcaAssessmentVersion {
  id             String        @id @default(cuid())
  assessmentId   String
  assessment     LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  // Spec §4: "No report snapshot, LCA issued version, document, export, AI
  // context, or job payload may combine more than one Organisation" — an
  // issued version is immutable and frozen, so it gets the same direct
  // column as ReportSnapshot rather than relying only on the parent
  // assessment join.
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id])

  version        Int
  label          String?
  status         LcaVersionStatus @default(DRAFT_REVISION)
  issuedAt       DateTime?
  issuedByUserId String?
  issuedBy       User?            @relation("LcaVersionIssuer", fields: [issuedByUserId], references: [id])

  engineVersion      String
  methodologyVersion String?
  calculationRunId   String?
  /// The complete assessment as it stood: goal and scope, model, inventory,
  /// factor snapshots, results, registers, validation and readiness.
  payload            Json

  createdAt DateTime @default(now())

  @@unique([assessmentId, version])
  @@index([organisationId])
}

model LcaVerification {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   LcaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  organisation        String
  verifierName        String
  verificationDate    DateTime
  assuranceType       LcaAssuranceType
  scopeOfVerification String
  statementReference  String?
  statementUrl        String?
  conclusion          String?
  notes               String?

  recordedByUserId String?
  recordedBy       User?    @relation("LcaVerificationRecorder", fields: [recordedByUserId], references: [id])
  recordedAt       DateTime @default(now())

  evidence LcaEvidence[]

  @@index([assessmentId])
}

/// Append-only record of every material change. Never updated or deleted.
model LcaAuditEvent {
  id           String         @id @default(cuid())
  assessmentId String?
  assessment   LcaAssessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  entityType String // "assessment", "inventory_item", "process", "supplier_pcf", ...
  entityId   String?
  action     String // "created", "updated", "deleted", "status_changed", "calculated", ...
  summary    String

  actorUserId String?
  actor       User?    @relation("LcaAuditActor", fields: [actorUserId], references: [id])
  occurredAt  DateTime @default(now())

  before   Json?
  after    Json?
  metadata Json?

  @@index([assessmentId, occurredAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Phase 2 (T20) — generic append-only platform audit log.
//
// Supplements, not replaces, the domain-specific provenance above
// (LcaAuditEvent) and every immutable Calculation/ReportSnapshot/
// LcaAssessmentVersion history — those keep recording what they already
// record. This table exists for tenant-administration events (membership,
// role/permission changes, organisation settings, access reviews — the
// vocabulary fixed in Docs/PHASE1_TENANCY_RBAC_SPEC.md §10) and, later,
// other Phase 2+ EMS events, in one place applications can query/export by
// organisation regardless of which resource type changed.
//
// Immutability is enforced twice, independently:
//  - No update/delete method exists on the repository
//    (src/lib/repositories/audit-repository.ts) — the application layer
//    simply cannot call one.
//  - A `BEFORE UPDATE OR DELETE` trigger (this table's migration) rejects
//    any UPDATE/DELETE at the database level, regardless of which Postgres
//    role issues it — deliberately not dependent on the T1B RLS
//    owner/runtime-role split, which is an unadopted spike with no Neon
//    role-provisioning automation yet (Docs/T1B_RLS_SPIKE_FINDINGS.md).
//
// `contentHash`/`previousEventHash` form a per-organisation hash chain
// (src/lib/audit/integrity.ts): each row hashes its own safe fields, and
// records the previous row's hash for the same organisation. Recomputing
// hashes and checking the chain detects tampering or a deleted/reordered
// row even though the application itself never performs those operations.
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
}

model AuditEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  // Monotonic per-row insertion order, independent of `occurredAt` (clock
  // skew/backdating never affects ordering). Used to find "the previous
  // event for this organisation" when computing the hash chain.
  sequence BigInt @default(autoincrement())

  actorUserId String?
  actor       User?          @relation("AuditEventActor", fields: [actorUserId], references: [id])
  actorType   AuditActorType @default(USER)

  // Dot-namespaced, e.g. "membership.suspended", "role.permission_granted" —
  // the fixed Phase 1 vocabulary (PHASE1_TENANCY_RBAC_SPEC.md §10) plus
  // later Phase 2+ additions. Plain string, not a Postgres enum, so new
  // event types never require a schema migration.
  eventType    String
  resourceType String
  resourceId   String?

  // Safe, human-readable description plus a bounded before/after summary or
  // field-level diff. Never secrets, invitation tokens, file bytes, raw AI
  // prompts, or environmental values — enforced by convention at every call
  // site (src/lib/audit/types.ts), not by this schema.
  summary String
  before  Json?
  after   Json?

  correlationId String
  source        String
  occurredAt    DateTime @default(now())

  contentHash       String
  previousEventHash String?

  @@index([organisationId, occurredAt])
  @@index([organisationId, resourceType, resourceId])
  @@index([organisationId, correlationId])
  @@index([organisationId, sequence])
}

// ---------------------------------------------------------------------------
// Transactional outbox and job framework (Phase 2 spec §§2,3 "Audit, outbox
// and notifications", task T21). `OutboxMessage` is the reliability
// boundary: a domain write and its outbox row commit in the same Prisma
// transaction (src/lib/jobs/outbox-service.ts), so a job is never enqueued
// for a write that didn't happen, and never lost for a write that did.
//
// `organisationId` is nullable only for a declared allowlist of platform
// jobs (PLATFORM_JOB_TOPICS in src/lib/jobs/types.ts) — every other topic is
// rejected by the service layer unless a tenant context supplies it, so
// tenant scope on a tenant job is explicit at the call site, not inferred.
// ---------------------------------------------------------------------------

enum OutboxMessageStatus {
  PENDING
  LEASED
  RETRY
  COMPLETED
  DEAD_LETTER
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model OutboxMessage {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  // Dot-namespaced job topic, e.g. "legal.sync", "reminder.dispatch" — a
  // plain string so later phases add topics without a migration; the
  // service layer, not this schema, enforces the known-topic/tenant-nullable
  // rule via PLATFORM_JOB_TOPICS.
  topic   String
  version Int    @default(1)
  payload Json

  // Unique per topic: enqueueing the same (topic, idempotencyKey) twice
  // collapses to the existing row instead of creating a duplicate job.
  idempotencyKey String

  status      OutboxMessageStatus @default(PENDING)
  availableAt DateTime            @default(now())

  // Lease fields: a worker claims a batch of due messages with a single
  // conditional UPDATE (SELECT ... FOR UPDATE SKIP LOCKED), so two workers
  // can never both win the same row — whichever UPDATE commits first moves
  // the row out of the leaseable set for the other.
  leaseOwner String?
  leaseUntil DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(8)

  // Structured error from the most recent failed attempt. Never a raw stack
  // trace or payload dump — a stable code plus a safe, bounded message.
  lastErrorCode    String?
  lastErrorMessage String?

  correlationId String
  source        String

  completedAt    DateTime?
  deadLetteredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobRuns JobRun[]

  @@unique([topic, idempotencyKey])
  @@index([status, availableAt])
  @@index([organisationId, topic])
  @@index([leaseUntil])
}

/**
 * One worker's attempt at one outbox message — the execution history behind
 * "worker health": recent JobRun rows for a topic/worker reveal failure
 * rate and stuck workers without a separate heartbeat table.
 */
model JobRun {
  id String @id @default(cuid())

  outboxMessageId String
  outboxMessage   OutboxMessage @relation(fields: [outboxMessageId], references: [id])

  jobType        String
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  workerId       String
  correlationId  String

  status     JobRunStatus @default(RUNNING)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  errorCode    String?
  errorMessage String?

  @@index([organisationId, jobType, startedAt])
  @@index([outboxMessageId])
  @@index([status, startedAt])
}

// ---------------------------------------------------------------------------
// Controlled documents and shared evidence (task T22,
// Docs/PHASE2_EMS_FOUNDATION_SPEC.md §3 "Controlled documents and evidence").
//
// Fixed decisions this section encodes directly in the schema:
//  - a ControlledDocumentRevision is immutable once APPROVED/EFFECTIVE — the
//    service layer (document-control-service.ts), not this schema, enforces
//    that no field on an approved/effective/obsolete row may change and that
//    a replacement always creates a new revision row, linked back via
//    `supersedesRevision`;
//  - evidence bytes live behind one provider interface
//    (src/lib/documents/storage/provider.ts); this schema stores only
//    metadata, checksum, and an opaque storage key — never bytes;
//  - `EvidenceLink.resourceType` is a plain string, not a Postgres enum, so
//    later phases (T23+) can attach evidence to new resource types without a
//    migration; the service layer validates it against an explicit allow
//    list and same-Organisation ownership of the target before writing.
// ---------------------------------------------------------------------------

enum ControlledDocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  EFFECTIVE
  OBSOLETE
}

/// Shared by ControlledDocument/Revision and EvidenceObject — deliberately
/// one small fixed set rather than a per-domain enum, so a download check can
/// compare a caller's clearance to one classification value regardless of
/// which kind of record it guards.
enum EvidenceClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum RetentionCategory {
  STANDARD
  LONG_TERM
  LEGAL_HOLD
}

/// The malware-scanning interface (src/lib/documents/malware-scan.ts) always
/// runs and always sets this field — PENDING until a scanner decides,
/// SKIPPED only for the explicit no-op development scanner, never silently
/// left unset.
enum MalwareScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  FAILED
}

/// A controlled document's identity: its reference/title/category/owner and
/// a pointer at whichever revision is currently in force. The document row
/// itself is mutable (owner, review interval); the content and lifecycle
/// state live on ControlledDocumentRevision, which is not.
model ControlledDocument {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// Stable human-facing code, e.g. "POL-ENV-001". Unique per organisation,
  /// never reused.
  reference String
  title     String
  /// Free-text/dot-namespaced document category (e.g. "policy", "procedure",
  /// "form") — a plain string, matching the AuditEvent.eventType convention,
  /// so new categories never require a migration.
  category  String

  classification EvidenceClassification @default(INTERNAL)

  ownerMembershipId String?
  owner             OrganisationMembership? @relation("ControlledDocumentOwner", fields: [ownerMembershipId], references: [id])

  reviewIntervalMonths Int?

  currentRevisionId String?                     @unique
  currentRevision   ControlledDocumentRevision? @relation("ControlledDocumentCurrentRevision", fields: [currentRevisionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions ControlledDocumentRevision[] @relation("ControlledDocumentRevisions")

  @@unique([organisationId, reference])
  @@unique([organisationId, id])
  @@index([organisationId, category])
}

/// One immutable-once-approved revision of a controlled document. Draft
/// revisions may be edited freely; APPROVED/EFFECTIVE/OBSOLETE revisions may
/// not — a replacement is always a new row (`supersedesRevision`), never an
/// update to this one (T22 acceptance: "approved revision immutable;
/// replacement creates successor").
model ControlledDocumentRevision {
  id         String             @id @default(cuid())
  documentId String
  document   ControlledDocument @relation("ControlledDocumentRevisions", fields: [documentId], references: [id])

  /// Opposite side of ControlledDocument.currentRevision — no FK column here.
  currentForDocument ControlledDocument? @relation("ControlledDocumentCurrentRevision")

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  revisionNumber Int
  status         ControlledDocumentStatus @default(DRAFT)
  changeSummary  String?

  /// Content lives behind the shared evidence provider — this row never
  /// stores bytes. Nullable because a revision may exist as metadata before
  /// content is attached (mirrors LcaEvidence's upload-then-link pattern).
  evidenceObjectId String?         @unique
  evidenceObject   EvidenceObject? @relation(fields: [evidenceObjectId], references: [id])

  /// Denormalised onto the revision (in addition to EvidenceObject's own
  /// checksum) so a revision's identity is provable even if the evidence
  /// link is ever cleared — matches the T22 acceptance criterion that
  /// checksums are part of the controlled-document record itself.
  checksumSha256 String?
  mimeType       String?
  sizeBytes      Int?

  classification    EvidenceClassification @default(INTERNAL)
  retentionCategory RetentionCategory      @default(STANDARD)
  retentionUntil    DateTime?

  preparedByUserId String?
  preparedBy       User?   @relation("ControlledDocumentRevisionPreparedBy", fields: [preparedByUserId], references: [id])
  reviewedByUserId String?
  reviewedBy       User?   @relation("ControlledDocumentRevisionReviewedBy", fields: [reviewedByUserId], references: [id])
  approvedByUserId String?
  approvedBy       User?   @relation("ControlledDocumentRevisionApprovedBy", fields: [approvedByUserId], references: [id])

  reviewedAt    DateTime?
  approvedAt    DateTime?
  effectiveDate DateTime?
  reviewDueDate DateTime?
  obsoleteDate  DateTime?

  /// The revision this one replaces, once effective. Unique: an old revision
  /// can have at most one successor.
  supersedesRevisionId String?                     @unique
  supersedesRevision   ControlledDocumentRevision? @relation("ControlledDocumentRevisionSuccessor", fields: [supersedesRevisionId], references: [id])
  successorRevision    ControlledDocumentRevision? @relation("ControlledDocumentRevisionSuccessor")

  distributions DocumentDistribution[]

  /// EMS programme foundation (T23): the policy record whose content this
  /// revision carries, when this document is the environmental policy.
  environmentalPolicyRecord EnvironmentalPolicyRecord?

  // Exact procedure revision pinned by an operational-control version (T33).
  operationalControls OperationalControl[]

  // Exact revision pinned by an emergency-plan version, and approved-content
  // references from external communication records (T35).
  emergencyPlans       EmergencyPlan[]
  communicationRecords CommunicationRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, revisionNumber])
  @@unique([organisationId, id])
  @@index([organisationId, status])
}

/// Shared attachment/evidence metadata — the T22 generalisation of the LCA
/// module's LcaEvidence/LcaEvidenceBlob pair. Bytes are held by whichever
/// EvidenceStorageProvider `storageProvider` names; this row is only ever
/// metadata, checksum, classification and retention state, and download
/// access is checked (organisation + classification) before any provider
/// read (src/lib/documents/evidence-service.ts).
model EvidenceObject {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  filename       String
  mimeType       String
  byteSize       Int
  checksumSha256 String

  /// "database" is the built-in fallback provider; the service layer can
  /// route to another registered provider without a schema change (same
  /// pattern as LcaEvidence.storageProvider/storageKey). Nullable because
  /// the row is created first (to get an id to store bytes under), then
  /// updated with the provider result — mirrors LcaEvidence's own
  /// create-then-attach sequence.
  storageProvider String?
  storageKey      String?

  classification    EvidenceClassification @default(INTERNAL)
  retentionCategory RetentionCategory      @default(STANDARD)
  retentionUntil    DateTime?
  /// Deletion is prohibited while this is true, regardless of retention
  /// category — checked in the service layer before any remove() call.
  legalHold         Boolean                @default(false)

  /// Always set by the malware-scanning interface — PENDING immediately
  /// after upload, until a scanner (no-op in development) updates it.
  malwareScanStatus MalwareScanStatus @default(PENDING)
  malwareScannedAt  DateTime?
  malwareScanner    String?

  uploadedByUserId String?
  uploadedBy       User?    @relation("EvidenceObjectUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links                      EvidenceLink[]
  controlledDocumentRevision ControlledDocumentRevision?
  blob                       EvidenceObjectBlob?

  @@unique([organisationId, id])
  @@index([organisationId, classification])
}

/// Bytes for the shared evidence provider's built-in "database" backend —
/// the EvidenceObject counterpart to LcaEvidenceBlob. Deliberately its own
/// table rather than a reuse of LcaEvidenceBlob: LcaEvidenceBlob carries a
/// hard FK to LcaEvidence, and T22 explicitly does not migrate existing LCA
/// evidence bytes into the new shared model. Nothing but the shared
/// download route selects from this table.
model EvidenceObjectBlob {
  id               String         @id @default(cuid())
  evidenceObjectId String         @unique
  evidenceObject   EvidenceObject @relation(fields: [evidenceObjectId], references: [id], onDelete: Cascade)
  data             Bytes
}

/// Generic evidence-to-resource attachment. `resourceType` is validated
/// against an explicit allow list and `resourceId` against same-Organisation
/// ownership of the target in the service layer before this row is ever
/// written — "no generic polymorphic link may skip target validation"
/// (Phase 2 spec §3).
model EvidenceLink {
  id         String         @id @default(cuid())
  evidenceId String
  evidence   EvidenceObject @relation(fields: [evidenceId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  resourceType String
  resourceId   String
  purpose      String?

  linkedByUserId String?
  linkedBy       User?    @relation("EvidenceLinkLinkedBy", fields: [linkedByUserId], references: [id])
  linkedAt       DateTime @default(now())

  @@unique([evidenceId, resourceType, resourceId])
  @@index([organisationId, resourceType, resourceId])
}

/// A record that a controlled-document revision was issued to a member,
/// role, or site, with an optional acknowledgement — distinct from
/// permission-based read access, and never itself a grant of access.
model DocumentDistribution {
  id         String                     @id @default(cuid())
  revisionId String
  revision   ControlledDocumentRevision @relation(fields: [revisionId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  audienceMembershipId String?
  audienceMembership   OrganisationMembership? @relation("DocumentDistributionMember", fields: [audienceMembershipId], references: [id])
  /// Informational role label (not a RoleDefinition FK) for a distribution
  /// addressed to "everyone holding this role" rather than one member.
  audienceRole         String?
  audienceSiteId       String?
  audienceSite         Site?                   @relation(fields: [audienceSiteId], references: [id])

  issuedAt       DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([organisationId, revisionId])
}

// ---------------------------------------------------------------------------
// EMS programme, scope, context and interested parties (task T23,
// Docs/PHASE2_EMS_FOUNDATION_SPEC.md §3 "EMS root and scope" /
// "Context, interested parties, risk and change"). This is the EMS root and
// planning layer: it does not seed copyrighted ISO clause text (fields below
// hold internal identifiers/keys only, never a "licensedText" column) and it
// does not seed environmental performance data — every fixture used to
// exercise this schema is synthetic.
//
// `EmsScopeVersion` reuses the T22 ControlledDocumentRevision pattern
// exactly: a version is freely editable in DRAFT/IN_REVIEW, immutable once
// APPROVED/SUPERSEDED, and a replacement is always a new row linked back via
// `supersedesVersion` — enforced in the service layer and, defence-in-depth,
// by a BEFORE UPDATE trigger (migration
// 20260811170000_add_ems_programme_foundation) mirroring
// controlled_document_revision_immutable_once_approved.
// ---------------------------------------------------------------------------

enum EmsProgrammeStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum EmsCertificationIntent {
  NONE
  PLANNED
  CERTIFIED_EXTERNALLY
}

enum EmsScopeVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
}

enum EmsRequirementImplementationStatus {
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  NOT_APPLICABLE
}

enum ContextIssueType {
  INTERNAL
  EXTERNAL
  ENVIRONMENTAL_CONDITION
}

enum ContextIssueDirection {
  AFFECTS_ORGANISATION
  AFFECTED_BY_ORGANISATION
  BOTH
}

enum InterestedPartyInfluence {
  LOW
  MEDIUM
  HIGH
}

enum EmsRiskOpportunityKind {
  RISK
  OPPORTUNITY
}

enum EmsRiskOpportunityStatus {
  OPEN
  MONITORING
  CLOSED
}

enum ChangeAssessmentStatus {
  DRAFT
  REVIEW
  APPROVED
  IMPLEMENTED
  EFFECTIVENESS_REVIEWED
}

/// The EMS root for an Organisation. "One active EMS programme may contain
/// many versioned scopes; historical programmes/scopes remain readable"
/// (Phase 2 spec §1) — enforced by a partial unique index
/// (`EmsProgramme_organisationId_active_key`, one ACTIVE programme per
/// organisation) rather than a schema-level singleton, so a suspended/closed
/// programme's history is never deleted to make room for a new one.
model EmsProgramme {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name   String
  status EmsProgrammeStatus @default(DRAFT)

  /// Internal identifier/version of the standards profile this programme
  /// maps to (e.g. "ISO14001", "2015") — identifiers only, never clause text.
  standardsProfile        String
  standardsProfileVersion String

  certificationIntent EmsCertificationIntent @default(NONE)

  ownerMembershipId String?
  owner             OrganisationMembership? @relation("EmsProgrammeOwner", fields: [ownerMembershipId], references: [id])

  /// Points at whichever EmsScopeVersion is the current approved boundary —
  /// same pointer pattern as ControlledDocument.currentRevision.
  currentScopeVersionId String?          @unique
  currentScopeVersion   EmsScopeVersion? @relation("EmsProgrammeCurrentScopeVersion", fields: [currentScopeVersionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scopeVersions           EmsScopeVersion[]           @relation("EmsProgrammeScopeVersions")
  standardRequirementMaps StandardRequirementMap[]
  contextIssues           ContextIssue[]
  interestedParties       InterestedParty[]
  riskOpportunities       EmsRiskOpportunity[]
  changeAssessments       ChangeAssessment[]
  policyRecords           EnvironmentalPolicyRecord[]
  activityProcesses       ActivityProcess[]
  significanceMethods     SignificanceMethod[]

  @@unique([organisationId, name])
  @@unique([organisationId, id])
  @@index([organisationId, status])
}

/// One versioned statement of the EMS boundary. Immutable once
/// APPROVED/SUPERSEDED — see the trigger note above.
model EmsScopeVersion {
  id          String       @id @default(cuid())
  programmeId String
  programme   EmsProgramme @relation("EmsProgrammeScopeVersions", fields: [programmeId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  versionNumber Int
  statement     String
  status        EmsScopeVersionStatus @default(DRAFT)

  exclusions          String?
  exclusionsRationale String?

  effectiveDate DateTime?
  reviewDueDate DateTime?

  preparedByUserId String?
  preparedBy       User?     @relation("EmsScopeVersionPreparedBy", fields: [preparedByUserId], references: [id])
  approvedByUserId String?
  approvedBy       User?     @relation("EmsScopeVersionApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?

  /// The version this one replaces, once approved. Unique: an old version can
  /// have at most one successor (same shape as
  /// ControlledDocumentRevision.supersedesRevision).
  supersedesVersionId String?          @unique
  supersedesVersion   EmsScopeVersion? @relation("EmsScopeVersionSuccessor", fields: [supersedesVersionId], references: [id])
  successorVersion    EmsScopeVersion? @relation("EmsScopeVersionSuccessor")

  /// Opposite side of EmsProgramme.currentScopeVersion — no FK column here.
  currentForProgramme EmsProgramme? @relation("EmsProgrammeCurrentScopeVersion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities   EmsScopeEntity[]
  sites      EmsScopeSite[]
  activities EmsScopeActivity[]

  @@unique([programmeId, versionNumber])
  @@unique([organisationId, id])
  @@index([organisationId, status])
}

/// A tenant-scoped Entity included in a scope version's boundary.
model EmsScopeEntity {
  id             String          @id @default(cuid())
  scopeVersionId String
  scopeVersion   EmsScopeVersion @relation(fields: [scopeVersionId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  createdAt DateTime @default(now())

  @@unique([scopeVersionId, entityId])
  @@unique([organisationId, id])
  @@index([organisationId, entityId])
}

/// A tenant-scoped Site included in a scope version's boundary. The service
/// layer, not this schema, enforces "Site must belong to an included Entity"
/// (Phase 2 spec §3) by checking `site.entityId` against the version's
/// `EmsScopeEntity` rows.
model EmsScopeSite {
  id             String          @id @default(cuid())
  scopeVersionId String
  scopeVersion   EmsScopeVersion @relation(fields: [scopeVersionId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  createdAt DateTime @default(now())

  @@unique([scopeVersionId, siteId])
  @@unique([organisationId, id])
  @@index([organisationId, siteId])
}

/// A free-text structural activity/product/service included in the
/// boundary, optionally tied to one Site (Phase 2 spec §3).
model EmsScopeActivity {
  id             String          @id @default(cuid())
  scopeVersionId String
  scopeVersion   EmsScopeVersion @relation(fields: [scopeVersionId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  description String
  siteId      String?
  site        Site?   @relation(fields: [siteId], references: [id])

  createdAt DateTime @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, scopeVersionId])
}

/// Maps an internal requirement key (e.g. a clause number) from a standards
/// profile to this programme's implementation status. `standardProfile` and
/// `requirementKey` are bare identifiers — never the standard's text; no
/// `licensedText` column exists here or anywhere else in this schema (Phase 2
/// spec §1: "ISO references store identifiers/internal mappings only").
model StandardRequirementMap {
  id          String       @id @default(cuid())
  programmeId String
  programme   EmsProgramme @relation(fields: [programmeId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  standardProfile String
  requirementKey  String

  implementationStatus EmsRequirementImplementationStatus @default(NOT_STARTED)

  ownerMembershipId String?
  owner             OrganisationMembership? @relation("StandardRequirementMapOwner", fields: [ownerMembershipId], references: [id])

  reviewDate DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit programme/execution scopes (T60).
  auditProgrammeItemScopes AuditProgrammeItemScope[]
  emsAuditScopes           EmsAuditScope[]

  @@unique([programmeId, standardProfile, requirementKey])
  @@unique([organisationId, id])
  @@index([organisationId, programmeId])
}

/// An internal or external factor, or environmental condition, relevant to
/// the EMS (Phase 2 spec §3). No environmental performance data — this is a
/// qualitative register entry, not a measurement.
model ContextIssue {
  id          String       @id @default(cuid())
  programmeId String
  programme   EmsProgramme @relation(fields: [programmeId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  type         ContextIssueType
  title        String
  description  String?
  direction    ContextIssueDirection
  significance String?

  ownerMembershipId String?
  owner             OrganisationMembership? @relation("ContextIssueOwner", fields: [ownerMembershipId], references: [id])

  reviewDate  DateTime?
  activeFrom  DateTime?
  activeUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, id])
  @@index([organisationId, programmeId, type])
}

/// A party with an interest in, or influence over, the EMS.
model InterestedParty {
  id          String       @id @default(cuid())
  programmeId String
  programme   EmsProgramme @relation(fields: [programmeId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name      String
  type      String
  influence InterestedPartyInfluence?

  relationshipOwnerMembershipId String?
  relationshipOwner             OrganisationMembership? @relation("InterestedPartyOwner", fields: [relationshipOwnerMembershipId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements InterestedPartyRequirement[]

  @@unique([organisationId, id])
  @@index([organisationId, programmeId])
}

/// One requirement an interested party holds, and whether it is mandatory.
/// "source/evidence" (Phase 2 spec §3) is a free-text citation plus, when
/// needed, an EvidenceLink (`resourceType = "interested_party_requirement"`)
/// pointed at this row's id — validated by the shared evidence service, same
/// as every other allow-listed resource type.
model InterestedPartyRequirement {
  id                String          @id @default(cuid())
  interestedPartyId String
  interestedParty   InterestedParty @relation(fields: [interestedPartyId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  summary         String
  sourceReference String?
  isMandatory     Boolean @default(false)

  evaluationDate DateTime?
  reviewDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, id])
  @@index([organisationId, interestedPartyId])
}

/// A risk or opportunity register entry. Ratings are organisation-configured
/// snapshots (`initialRating`/`residualRating` JSON plus a
/// `ratingScaleVersion` pointer) — "no universal significance formula is
/// seeded" (Phase 2 spec §3).
model EmsRiskOpportunity {
  id          String       @id @default(cuid())
  programmeId String
  programme   EmsProgramme @relation(fields: [programmeId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  kind        EmsRiskOpportunityKind
  category    String
  description String
  consequence String?
  likelihood  String?

  ratingScaleVersion String
  initialRating      Json
  residualRating     Json?

  status EmsRiskOpportunityStatus @default(OPEN)

  ownerMembershipId String?
  owner             OrganisationMembership? @relation("EmsRiskOpportunityOwner", fields: [ownerMembershipId], references: [id])

  /// Free-text pointer at the record this risk/opportunity was raised from
  /// (e.g. a context issue) — a plain string pair, not a hard FK, so later
  /// phases (aspects, obligations — not yet built) can be a `sourceType`
  /// without a migration; the service layer validates same-Organisation
  /// ownership of the target before writing.
  sourceType String?
  sourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Objective source links (T50).
  objectiveSourceLinks ObjectiveSourceLink[]

  @@unique([organisationId, id])
  @@index([organisationId, programmeId, status])
}

/// A proposed or implemented change to the EMS and its planned impact.
/// `affectedRefs` is a structured, generic list of `{ resourceType,
/// resourceId }` pairs — the same generic-reference shape as EvidenceLink —
/// so this row can point at scope/context/policy records that exist today
/// without a hard FK to aspects/obligations/controls/competence records that
/// later phases (T30+/T40+/T70+) have not built yet.
model ChangeAssessment {
  id          String       @id @default(cuid())
  programmeId String
  programme   EmsProgramme @relation(fields: [programmeId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  proposedChange String
  triggerType    String
  triggerDate    DateTime?

  affectedRefs Json?

  assessment String?
  decision   String?

  status ChangeAssessmentStatus @default(DRAFT)

  preparedByUserId String?
  preparedBy       User?     @relation("ChangeAssessmentPreparedBy", fields: [preparedByUserId], references: [id])
  approvedByUserId String?
  approvedBy       User?     @relation("ChangeAssessmentApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?

  implementedAt           DateTime?
  effectivenessReview     String?
  effectivenessReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, id])
  @@index([organisationId, programmeId, status])
}

/// Links the EMS policy to its controlled-document content (the actual
/// policy text lives in the T22 ControlledDocumentRevision, never here) plus
/// the top-management approval this record type specifically requires.
model EnvironmentalPolicyRecord {
  id          String       @id @default(cuid())
  programmeId String
  programme   EmsProgramme @relation(fields: [programmeId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  controlledDocumentRevisionId String                     @unique
  controlledDocumentRevision   ControlledDocumentRevision @relation(fields: [controlledDocumentRevisionId], references: [id])

  approvedByUserId String?
  approvedBy       User?     @relation("EnvironmentalPolicyRecordApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  effectiveDate    DateTime?
  reviewDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Objective source links (T50).
  objectiveSourceLinks ObjectiveSourceLink[]

  @@unique([organisationId, id])
  @@index([organisationId, programmeId])
}

// ---------------------------------------------------------------------------
// Notifications and reminders (task T24, Docs/PHASE2_EMS_FOUNDATION_SPEC.md
// §3 "Audit, outbox and notifications", §7 "P2-07").
//
// Fixed decisions this section encodes:
//  - "Notifications are derived delivery records, not evidence of task
//    completion" (Phase 2 spec §1) — a Notification never gates a workflow
//    transition; it is created *after* the domain event it describes.
//  - In-app delivery only for T24. `NotificationChannel` exists so a later
//    task can add an email adapter without a migration; the email adapter
//    itself (src/lib/notifications/delivery/email-adapter.ts) is a no-op
//    interface stub in T24, never real sending.
//  - `title`/`body` must be generic, safe text — never a raw record field,
//    environmental value, or other sensitive detail — enforced by the
//    service layer's fixed per-eventType message templates, not by this
//    schema.
//  - `dedupeKey` is unique per (organisationId, recipientMembershipId,
//    dedupeKey): re-triggering the same event for the same recipient before
//    it is superseded collapses to the existing row instead of creating a
//    duplicate notification.
//  - Recipient membership is revalidated ACTIVE/in-scope at delivery time,
//    not just at creation time (spec §6 "Notification recipient is
//    revalidated as active/in-scope at delivery").
// ---------------------------------------------------------------------------

enum NotificationStatus {
  PENDING
  DELIVERED
  READ
  DISMISSED
  SUPPRESSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  recipientMembershipId String
  recipientMembership   OrganisationMembership @relation("NotificationRecipient", fields: [recipientMembershipId], references: [id])

  // Dot-namespaced, e.g. "ems.review_due", "compliance_obligation.overdue" —
  // a plain string, not an enum, so later phases add notification types
  // without a migration (mirrors OutboxMessage.topic, T21).
  type String

  channel NotificationChannel @default(IN_APP)
  status  NotificationStatus  @default(PENDING)

  // Generic, non-disclosing copy only — see fixed decisions above.
  title String
  body  String

  resourceType String
  resourceId   String

  // Unique per (organisationId, recipientMembershipId, dedupeKey) — see
  // fixed decisions above.
  dedupeKey String

  reminderRuleId String?
  reminderRule   ReminderRule? @relation(fields: [reminderRuleId], references: [id])

  deliveredAt  DateTime?
  readAt       DateTime?
  dismissedAt  DateTime?
  suppressedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, recipientMembershipId, dedupeKey])
  @@index([organisationId, recipientMembershipId, status])
  @@index([organisationId, resourceType, resourceId])
}

/// A standing rule that generates reminder notifications for a resource
/// type/event (e.g. "controlled document review due in N days"). Recipients
/// are resolved at evaluation time from `recipientsPolicy`, never stored as
/// a fixed list, so a reassignment changes who is reminded without editing
/// the rule.
model ReminderRule {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  resourceType String
  event        String

  // Days before/after the triggering date; negative means "before".
  offsetDays Int

  // "ONCE" or a simple recurrence key (e.g. "DAILY_UNTIL_RESOLVED") — a
  // plain string, not an enum, evaluated by the service layer.
  recurrence String @default("ONCE")

  // Structured recipient-resolution policy (e.g. { "kind": "owner" } or
  // { "kind": "permission", "permission": "ems.controlled_document.approve" })
  // resolved against live membership state at evaluation time, never a
  // stored membership id list.
  recipientsPolicy Json

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@unique([organisationId, resourceType, event])
  @@index([organisationId, resourceType, isActive])
}

// ---------------------------------------------------------------------------
// Process/activity profiles (task T30, Docs/PHASE3_ASPECTS_OPERATIONS_SPEC.md
// §§1-2 "Process/activity structure").
//
// Fixed decisions this section encodes:
//  - "Process starter profiles contain structure only; users must confirm
//    before application" (spec §1) — ProcessProfileTemplate/ProcessTemplateItem
//    carry no environmental values, and process-service.ts requires an
//    explicit `confirm: true` before any ActivityProcess is created from one.
//  - Applying a template creates DRAFT ActivityProcesses only, never
//    aspects/scores/measurements — those models do not exist until T31/T34.
//  - Template application is idempotent: the service layer looks for an
//    existing non-superseded ActivityProcess with the same
//    (organisationId, siteId, sourceTemplateItemId) before creating one, and
//    reuses it instead of duplicating — the same "check inside the write
//    transaction" shape T23 uses for its one-ACTIVE-programme guard.
//  - Revising a profile never mutates an existing ActivityProcess row — it
//    creates a new row and links back via `supersedesProcessId`, the same
//    supersede-chain shape as `EmsScopeVersion`/`ControlledDocumentRevision`,
//    so anything that already references the old row (a future aspect/
//    assessment) keeps pointing at unchanged data.
//  - Templates are platform content (no organisationId) — structural
//    starters, not tenant data — matching `EmissionFactorSet`/
//    `LcaMethodologyProfile`'s shared/platform-owned pattern.
// ---------------------------------------------------------------------------

enum ProcessActivityType {
  ACTIVITY
  PRODUCT
  SERVICE
}

enum EmsLifecycleStage {
  RAW_MATERIAL_ACQUISITION
  DESIGN
  PRODUCTION
  TRANSPORTATION_DELIVERY
  USE
  END_OF_LIFE_TREATMENT
  OTHER
}

enum EmsOperatingCondition {
  NORMAL
  ABNORMAL
  STARTUP_SHUTDOWN
  MAINTENANCE
  EMERGENCY
}

enum ActivityProcessStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum AspectControlRelationship {
  DIRECT_CONTROL
  INFLUENCE
}

enum EnvironmentalEffect {
  BENEFICIAL
  ADVERSE
}

enum EnvironmentalImpactExtent {
  LOCAL
  GLOBAL
  LOCAL_AND_GLOBAL
}

enum SignificanceFormula {
  WEIGHTED_SUM
  MAX_CRITERION
  RULE_SET
}

enum SignificanceMethodStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum AspectAssessmentStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

/// A platform-owned structural starter template (Hull/Rayleigh/Milton Keynes
/// operations). Never tenant data — no organisationId, no environmental
/// values; see ProcessTemplateItem.
model ProcessProfileTemplate {
  id           String  @id @default(cuid())
  key          String  @unique
  name         String
  siteLabel    String
  description  String
  version      Int     @default(1)
  isStructural Boolean @default(true)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            ProcessTemplateItem[]
  appliedProcesses ActivityProcess[]

  @@index([isActive])
}

/// One structural node of a ProcessProfileTemplate — name/type/suggested
/// lifecycle stage and operating condition only. No environmental values or
/// aspects: applying this produces a draft ActivityProcess, never an aspect
/// or measurement.
model ProcessTemplateItem {
  id         String                 @id @default(cuid())
  templateId String
  template   ProcessProfileTemplate @relation(fields: [templateId], references: [id])

  parentId String?
  parent   ProcessTemplateItem?  @relation("ProcessTemplateItemParent", fields: [parentId], references: [id])
  children ProcessTemplateItem[] @relation("ProcessTemplateItemParent")

  name                        String
  description                 String?
  activityType                ProcessActivityType   @default(ACTIVITY)
  suggestedLifecycleStage     EmsLifecycleStage?
  suggestedOperatingCondition EmsOperatingCondition @default(NORMAL)
  sortOrder                   Int                   @default(0)

  appliedProcesses ActivityProcess[]

  @@index([templateId])
  @@index([parentId])
}

/// One site/organisation process, activity, product, or service, and the
/// lifecycle/operating conditions it runs under (Phase 3 spec §2). Tenant-
/// and site-scoped; revising creates a new row via `supersedesProcessId`
/// rather than mutating an existing row.
model ActivityProcess {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  programmeId String
  programme   EmsProgramme @relation(fields: [programmeId], references: [id])

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  parentId String?
  parent   ActivityProcess?  @relation("ActivityProcessParent", fields: [parentId], references: [id])
  children ActivityProcess[] @relation("ActivityProcessParent")

  name               String
  description        String?
  activityType       ProcessActivityType   @default(ACTIVITY)
  lifecycleStage     EmsLifecycleStage?
  operatingCondition EmsOperatingCondition @default(NORMAL)
  status             ActivityProcessStatus @default(DRAFT)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  // Template provenance — null for a hand-authored process.
  sourceTemplateId     String?
  sourceTemplate       ProcessProfileTemplate? @relation(fields: [sourceTemplateId], references: [id])
  sourceTemplateItemId String?
  sourceTemplateItem   ProcessTemplateItem?    @relation(fields: [sourceTemplateItemId], references: [id])

  // Revision chain (never mutate in place): the process this one replaces.
  // Unique — an old process can have at most one successor, same shape as
  // EmsScopeVersion.supersedesVersionId.
  supersedesProcessId String?          @unique
  supersedesProcess   ActivityProcess? @relation("ActivityProcessRevision", fields: [supersedesProcessId], references: [id])
  successorProcess    ActivityProcess? @relation("ActivityProcessRevision")

  createdByMembershipId String?
  createdBy             OrganisationMembership? @relation("ActivityProcessCreatedBy", fields: [createdByMembershipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  environmentalAspects   EnvironmentalAspect[]
  controlApplicabilities ControlApplicability[]
  emergencyScenarios     EmergencyScenario[]

  // Legal applicability assessment scopes (T43).
  applicabilityAssessmentScopes ApplicabilityAssessmentScope[]

  // Audit programme/execution scopes (T60).
  auditProgrammeItemScopes AuditProgrammeItemScope[]
  emsAuditScopes           EmsAuditScope[]

  // Environmental incident intake (T62).
  environmentalIncidents EnvironmentalIncident[]

  @@unique([organisationId, id])
  @@index([organisationId, programmeId, status])
  @@index([organisationId, siteId])
  @@index([organisationId, entityId])
  @@index([organisationId, sourceTemplateItemId])
}

/// A tenant-owned environmental aspect associated with one T30 process.
/// Lifecycle and operating-condition values are recorded explicitly on the
/// aspect so the register captures the perspective under which it was
/// identified without reusing or changing any LCA model or calculation.
model EnvironmentalAspect {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  processId String
  process   ActivityProcess @relation(fields: [organisationId, processId], references: [organisationId, id])

  name                String
  description         String?
  sourceInputOutput   String?
  scopeDescription    String?
  existingControls    String?
  controlRelationship AspectControlRelationship
  lifecycleStage      EmsLifecycleStage?
  operatingCondition  EmsOperatingCondition
  effect              EnvironmentalEffect
  activeFrom          DateTime                  @default(now())
  activeTo            DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  impactLinks             AspectImpactLink[]
  assessments             AspectAssessment[]
  operationalControlLinks OperationalControlAspect[]

  // External providers and emergency preparedness (T35).
  externalProviderControlLinks ExternalProviderControlAspect[]
  emergencyScenarios           EmergencyScenario[]

  // Legal applicability assessment scopes (T43).
  applicabilityAssessmentScopes ApplicabilityAssessmentScope[]

  // Compliance obligation version scopes (T44).
  complianceObligationVersionScopes ComplianceObligationVersionScope[]

  // Audit programme/execution scopes (T60).
  auditProgrammeItemScopes AuditProgrammeItemScope[]
  emsAuditScopes           EmsAuditScope[]

  // Environmental incident intake (T62).
  environmentalIncidents EnvironmentalIncident[]

  @@unique([organisationId, id])
  @@index([organisationId, processId])
  @@index([organisationId, operatingCondition])
}

/// Organisation-level impact catalogue. Impacts deliberately contain no
/// carbon/LCA totals: those domains may only be linked later by provenance.
model EnvironmentalImpact {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name        String
  category    String
  receptor    String?
  extent      EnvironmentalImpactExtent
  effect      EnvironmentalEffect
  description String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  aspectLinks AspectImpactLink[]

  @@unique([organisationId, id])
  @@unique([organisationId, name])
  @@index([organisationId, category])
}

/// Tenant-enforced many-to-many aspect/impact relation. Repeating
/// organisationId in both composite foreign keys makes a mixed-tenant link
/// invalid at the database boundary as well as in the service layer.
model AspectImpactLink {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  aspectId String
  aspect   EnvironmentalAspect @relation(fields: [organisationId, aspectId], references: [organisationId, id], onDelete: Cascade)

  impactId String
  impact   EnvironmentalImpact @relation(fields: [organisationId, impactId], references: [organisationId, id], onDelete: Cascade)

  causalDescription String?
  createdAt         DateTime @default(now())

  @@unique([organisationId, aspectId, impactId])
  @@index([organisationId, impactId])
}

/// An organisation-configured significance method. Approved versions are
/// immutable; changing criteria/formula creates a successor version.
model SignificanceMethod {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  programmeId String
  programme   EmsProgramme @relation(fields: [organisationId, programmeId], references: [organisationId, id])

  methodKey     String
  name          String
  version       Int
  status        SignificanceMethodStatus @default(DRAFT)
  formula       SignificanceFormula
  formulaConfig Json
  threshold     Decimal                  @db.Decimal(24, 10)

  preparedByMembershipId String
  preparedBy             OrganisationMembership  @relation("SignificanceMethodPreparedBy", fields: [organisationId, preparedByMembershipId], references: [organisationId, id])
  approvedByMembershipId String?
  approvedBy             OrganisationMembership? @relation("SignificanceMethodApprovedBy", fields: [organisationId, approvedByMembershipId], references: [organisationId, id])
  approvedAt             DateTime?

  supersedesMethodId String?
  supersedesMethod   SignificanceMethod? @relation("SignificanceMethodSuccessor", fields: [organisationId, supersedesMethodId], references: [organisationId, id])
  successorMethod    SignificanceMethod? @relation("SignificanceMethodSuccessor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria    SignificanceCriterion[]
  assessments AspectAssessment[]

  @@unique([organisationId, id])
  @@unique([organisationId, methodKey, version])
  @@unique([organisationId, supersedesMethodId])
  @@index([organisationId, programmeId, status])
}

/// One stable-key criterion belonging to an exact method version.
model SignificanceCriterion {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  methodId String
  method   SignificanceMethod @relation(fields: [organisationId, methodId], references: [organisationId, id], onDelete: Cascade)

  key         String
  label       String
  scaleConfig Json
  weight      Decimal? @db.Decimal(24, 10)
  required    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([organisationId, methodId, key])
  @@index([organisationId, methodId, sortOrder])
}

/// A significance calculation pinned to exact method/criteria/input/result
/// snapshots. Approval freezes it; reassessment creates a successor row.
model AspectAssessment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  aspectId String
  aspect   EnvironmentalAspect @relation(fields: [organisationId, aspectId], references: [organisationId, id])
  methodId String
  method   SignificanceMethod  @relation(fields: [organisationId, methodId], references: [organisationId, id])

  assessmentVersion Int
  status            AspectAssessmentStatus @default(DRAFT)

  methodKeySnapshot     String
  methodVersionSnapshot Int
  formulaSnapshot       SignificanceFormula
  formulaConfigSnapshot Json
  thresholdSnapshot     Decimal             @db.Decimal(24, 10)
  criteriaSnapshot      Json
  criterionInputs       Json
  calculatedScore       Decimal             @db.Decimal(24, 10)
  calculatedSignificant Boolean
  calculationTrace      Json
  overrideSignificant   Boolean?
  overrideRationale     String?
  finalSignificant      Boolean

  assessedByMembershipId String
  assessedBy             OrganisationMembership  @relation("AspectAssessmentAssessedBy", fields: [organisationId, assessedByMembershipId], references: [organisationId, id])
  assessedAt             DateTime                @default(now())
  approvedByMembershipId String?
  approvedBy             OrganisationMembership? @relation("AspectAssessmentApprovedBy", fields: [organisationId, approvedByMembershipId], references: [organisationId, id])
  approvedAt             DateTime?

  supersedesAssessmentId String?
  supersedesAssessment   AspectAssessment? @relation("AspectAssessmentSuccessor", fields: [organisationId, supersedesAssessmentId], references: [organisationId, id])
  successorAssessment    AspectAssessment? @relation("AspectAssessmentSuccessor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Objective source links (T50).
  objectiveSourceLinks ObjectiveSourceLink[]

  @@unique([organisationId, id])
  @@unique([organisationId, aspectId, assessmentVersion])
  @@unique([organisationId, supersedesAssessmentId])
  @@index([organisationId, aspectId, status])
  @@index([organisationId, methodId])
}

// ---------------------------------------------------------------------------
// Operational controls and review cycle (task T33).
//
// Controls are versioned records: a review/revision creates a successor and
// marks the prior version SUPERSEDED. Aspect links and applicability belong to
// the exact version so historic decisions remain traceable. A procedure link
// pins an exact controlled-document revision rather than a mutable document.
// ---------------------------------------------------------------------------

enum OperationalControlType {
  ENGINEERING
  PROCEDURAL
  MONITORING
  COMPETENCE
  PROCUREMENT
  EMERGENCY
  OTHER
}

enum OperationalControlStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum ControlCheckResult {
  PENDING
  PASS
  FAIL
  NOT_APPLICABLE
}

model OperationalControl {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  controlKey            String
  version               Int
  title                 String
  type                  OperationalControlType
  status                OperationalControlStatus @default(ACTIVE)
  description           String?
  frequency             String?
  acceptanceCriteria    String?
  effectivenessCriteria String?

  ownerMembershipId String
  owner             OrganisationMembership @relation("OperationalControlOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id])

  controlledDocumentRevisionId String?
  controlledDocumentRevision   ControlledDocumentRevision? @relation(fields: [organisationId, controlledDocumentRevisionId], references: [organisationId, id], onDelete: Restrict)

  effectiveFrom DateTime  @default(now())
  reviewDueDate DateTime
  reviewedAt    DateTime?

  supersedesControlId String?
  supersedesControl   OperationalControl? @relation("OperationalControlSuccessor", fields: [organisationId, supersedesControlId], references: [organisationId, id], onDelete: Restrict)
  successorControl    OperationalControl? @relation("OperationalControlSuccessor")

  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aspectLinks     OperationalControlAspect[]
  applicabilities ControlApplicability[]
  checks          ControlCheck[]

  // Compliance obligation version control links (T44).
  complianceObligationVersionLinks ComplianceObligationVersionControl[]

  // Nonconformity workflow (T63).
  nonconformities Nonconformity[]

  @@unique([organisationId, id])
  @@unique([organisationId, controlKey, version])
  @@unique([organisationId, supersedesControlId])
  @@index([organisationId, status, reviewDueDate])
  @@index([organisationId, ownerMembershipId])
}

model OperationalControlAspect {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  controlId String
  control   OperationalControl  @relation(fields: [organisationId, controlId], references: [organisationId, id], onDelete: Cascade)
  aspectId  String
  aspect    EnvironmentalAspect @relation(fields: [organisationId, aspectId], references: [organisationId, id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@unique([organisationId, controlId, aspectId], map: "OperationalControlAspect_control_aspect_key")
  @@index([organisationId, aspectId])
}

model ControlApplicability {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  controlId                 String
  control                   OperationalControl @relation(fields: [organisationId, controlId], references: [organisationId, id], onDelete: Cascade)
  entityId                  String?
  entity                    Entity?            @relation(fields: [organisationId, entityId], references: [organisationId, id], onDelete: Restrict)
  siteId                    String?
  site                      Site?              @relation(fields: [organisationId, siteId], references: [organisationId, id], onDelete: Restrict)
  processId                 String?
  process                   ActivityProcess?   @relation(fields: [organisationId, processId], references: [organisationId, id], onDelete: Restrict)
  externalProviderReference String?
  createdAt                 DateTime           @default(now())

  @@unique([organisationId, controlId, entityId, siteId, processId, externalProviderReference], map: "ControlApplicability_scope_key")
  @@index([organisationId, controlId])
  @@index([organisationId, entityId])
  @@index([organisationId, siteId])
  @@index([organisationId, processId])
}

model ControlCheck {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  controlId        String
  control          OperationalControl @relation(fields: [organisationId, controlId], references: [organisationId, id])
  scheduledAt      DateTime
  performedAt      DateTime?
  result           ControlCheckResult @default(PENDING)
  notes            String?
  exceptionSummary String?
  actionReference  String?

  reviewerMembershipId String?
  reviewer             OrganisationMembership? @relation("ControlCheckReviewer", fields: [organisationId, reviewerMembershipId], references: [organisationId, id], onDelete: Restrict)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([organisationId, id])
  @@index([organisationId, controlId, scheduledAt])
  @@index([organisationId, result])
}

// ---------------------------------------------------------------------------
// External providers, communications and emergency preparedness (task T35,
// Docs/PHASE3_ASPECTS_OPERATIONS_SPEC.md §2 "Communications and emergency
// preparedness", §5 "External-provider controls/evaluations"). Continues the
// T33 pattern exactly: a provider control/emergency plan is a versioned,
// owner-reviewed record; an emergency plan revision is always a controlled
// document; exercise records never fabricate real contact details and never
// auto-create an incident/nonconformity — Phase 6 (T60-T64) owns those
// models, so any such link here stays a plain task-local text reference,
// same convention as ControlCheck.actionReference above.
// ---------------------------------------------------------------------------

enum ExternalProviderControlStatus {
  ACTIVE
  SUSPENDED
  RETIRED
}

enum ExternalProviderEvaluationResult {
  PASS
  CONDITIONAL
  FAIL
}

enum CommunicationAudience {
  INTERNAL
  EXTERNAL
  BOTH
}

enum CommunicationPlanStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum EmergencyScenarioPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyScenarioStatus {
  ACTIVE
  RETIRED
}

enum EmergencyPlanStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum EmergencyExerciseType {
  TABLETOP
  DRILL
  FULL_SCALE
}

enum EmergencyExerciseOutcome {
  SUCCESSFUL
  PARTIAL
  FAILED
}

enum EmergencyExerciseActionStatus {
  OPEN
  COMPLETE
}

/// A value-chain provider whose activity affects an aspect, and the
/// communicated environmental requirements/evaluation cadence for it.
/// `providerReference` is the same stable identifier T33's
/// `ControlApplicability.externalProviderReference` was left as a
/// task-local text hook for — this is where that reference now resolves to
/// a real, permission-checked record.
model ExternalProviderControl {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  providerReference        String
  providerName             String
  providedDescription      String
  communicatedRequirements String
  evaluationFrequency      String
  status                   ExternalProviderControlStatus @default(ACTIVE)

  ownerMembershipId String
  owner             OrganisationMembership @relation("ExternalProviderControlOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id])

  lastReviewedAt    DateTime?
  nextReviewDueDate DateTime

  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aspectLinks ExternalProviderControlAspect[]
  evaluations ExternalProviderEvaluation[]

  @@unique([organisationId, id])
  @@unique([organisationId, providerReference])
  @@index([organisationId, status, nextReviewDueDate])
}

model ExternalProviderControlAspect {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  providerControlId String
  providerControl   ExternalProviderControl @relation(fields: [organisationId, providerControlId], references: [organisationId, id], onDelete: Cascade)
  aspectId          String
  aspect            EnvironmentalAspect     @relation(fields: [organisationId, aspectId], references: [organisationId, id], onDelete: Cascade)
  createdAt         DateTime                @default(now())

  @@unique([organisationId, providerControlId, aspectId], map: "ExternalProviderControlAspect_provider_aspect_key")
  @@index([organisationId, aspectId])
}

/// One evaluation event against a snapshot of the provider's criteria at
/// evaluation time — never overwrites a prior evaluation.
model ExternalProviderEvaluation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  providerControlId String
  providerControl   ExternalProviderControl @relation(fields: [organisationId, providerControlId], references: [organisationId, id])

  evaluatedAt      DateTime
  criteriaSnapshot Json
  result           ExternalProviderEvaluationResult
  notes            String?
  actionReference  String?

  reviewerMembershipId String
  reviewer             OrganisationMembership @relation("ExternalProviderEvaluationReviewer", fields: [organisationId, reviewerMembershipId], references: [organisationId, id], onDelete: Restrict)
  createdAt            DateTime               @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, providerControlId, evaluatedAt])
}

/// A planned internal/external environmental communication — subject,
/// audience, method, and whether content requires approval before an
/// actual CommunicationRecord may reference it.
model CommunicationPlan {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  subject            String
  audience           CommunicationAudience
  triggerFrequency   String
  method             String
  approvalRequired   Boolean                 @default(false)
  sourceRequirements String?
  status             CommunicationPlanStatus @default(ACTIVE)

  ownerMembershipId String
  owner             OrganisationMembership @relation("CommunicationPlanOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records        CommunicationRecord[]
  emergencyPlans EmergencyPlan[]

  @@unique([organisationId, id])
  @@index([organisationId, status])
}

/// A single occurred communication. When the linked plan requires approval
/// (T35 acceptance: "external communications follow configured approval"),
/// the service layer requires `approverMembershipId`/`approvedAt` to be set
/// before the record may be created — never mutated onto an existing row.
model CommunicationRecord {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  planId String?
  plan   CommunicationPlan? @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Restrict)

  occurredAt     DateTime
  audience       CommunicationAudience
  parties        String
  contentSummary String

  approvedContentRevisionId String?
  approvedContentRevision   ControlledDocumentRevision? @relation(fields: [organisationId, approvedContentRevisionId], references: [organisationId, id], onDelete: Restrict)

  senderMembershipId String
  sender             OrganisationMembership @relation("CommunicationRecordSender", fields: [organisationId, senderMembershipId], references: [organisationId, id])

  approverMembershipId String?
  approver             OrganisationMembership? @relation("CommunicationRecordApprover", fields: [organisationId, approverMembershipId], references: [organisationId, id], onDelete: Restrict)
  approvedAt           DateTime?

  responseFollowUp String?
  createdAt        DateTime @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, planId])
  @@index([organisationId, occurredAt])
}

/// A credible emergency scenario linked to the aspect/process/site it
/// arises from. `controlsSummary` is a plain description — the scenario's
/// actual operational controls remain queryable through its linked aspect's
/// own OperationalControlAspect links rather than a duplicate join table.
model EmergencyScenario {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  aspectId  String?
  aspect    EnvironmentalAspect? @relation(fields: [organisationId, aspectId], references: [organisationId, id], onDelete: Restrict)
  processId String?
  process   ActivityProcess?     @relation(fields: [organisationId, processId], references: [organisationId, id], onDelete: Restrict)
  siteId    String?
  site      Site?                @relation(fields: [organisationId, siteId], references: [organisationId, id], onDelete: Restrict)

  name                String
  triggerDescription  String
  receptors           String
  credibleConsequence String
  priority            EmergencyScenarioPriority
  controlsSummary     String?
  reviewDueDate       DateTime
  status              EmergencyScenarioStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans     EmergencyPlan[]
  exercises EmergencyExercise[]

  @@unique([organisationId, id])
  @@index([organisationId, status, reviewDueDate])
}

/// A versioned emergency plan for a scenario. Follows the OperationalControl
/// versioning pattern exactly: `controlledDocumentRevisionId` is mandatory
/// (T35 acceptance: "emergency plan revisions are controlled documents") and
/// a revision creates a new row via `supersedesPlanId`, never a mutation.
/// `roles` records role labels/responsibilities only — never a real name,
/// phone number or address, per the "no fabricated contact details" rule.
model EmergencyPlan {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  scenarioId String
  scenario   EmergencyScenario @relation(fields: [organisationId, scenarioId], references: [organisationId, id])

  version Int
  status  EmergencyPlanStatus @default(ACTIVE)

  controlledDocumentRevisionId String
  controlledDocumentRevision   ControlledDocumentRevision @relation(fields: [organisationId, controlledDocumentRevisionId], references: [organisationId, id], onDelete: Restrict)

  roles     String
  resources String

  communicationPlanId String?
  communicationPlan   CommunicationPlan? @relation(fields: [organisationId, communicationPlanId], references: [organisationId, id], onDelete: Restrict)

  effectiveDate DateTime
  reviewDueDate DateTime

  supersedesPlanId String?
  supersedesPlan   EmergencyPlan? @relation("EmergencyPlanSuccessor", fields: [organisationId, supersedesPlanId], references: [organisationId, id], onDelete: Restrict)
  successorPlan    EmergencyPlan? @relation("EmergencyPlanSuccessor")

  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exercises EmergencyExercise[]

  @@unique([organisationId, id])
  @@unique([organisationId, scenarioId, version])
  @@unique([organisationId, supersedesPlanId])
  @@index([organisationId, status, reviewDueDate])
}

/// One exercise event against one exact, pinned plan version.
/// `participantMembershipIds` is a snapshot taken at recording time, so the
/// exercise's history stays traceable even if a participant's membership is
/// later suspended or removed.
model EmergencyExercise {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  scenarioId String
  scenario   EmergencyScenario @relation(fields: [organisationId, scenarioId], references: [organisationId, id])
  planId     String
  plan       EmergencyPlan     @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Restrict)

  type                     EmergencyExerciseType
  exerciseDate             DateTime
  participantMembershipIds String[]
  objectives               String
  outcome                  EmergencyExerciseOutcome
  observations             String?
  lessons                  String?

  recordedByUserId String
  recordedBy       User     @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())

  actions EmergencyExerciseAction[]

  @@unique([organisationId, id])
  @@index([organisationId, scenarioId, exerciseDate])
  @@index([organisationId, planId])
}

/// A follow-up action from a (typically failed/partial) exercise.
/// `actionReference`/`incidentReference`/`nonconformityReference` are plain
/// task-local text — Phase 5/6 (T52/T62-T64) own the real Action/Incident/
/// Nonconformity models; linking one here is always an explicit, separate
/// step the service layer never performs automatically.
model EmergencyExerciseAction {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  exerciseId  String
  exercise    EmergencyExercise @relation(fields: [organisationId, exerciseId], references: [organisationId, id], onDelete: Cascade)
  description String

  ownerMembershipId String?
  owner             OrganisationMembership?       @relation("EmergencyExerciseActionOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)
  dueDate           DateTime?
  status            EmergencyExerciseActionStatus @default(OPEN)

  actionReference        String?
  incidentReference      String?
  nonconformityReference String?

  createdAt DateTime @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, exerciseId])
}

// ---------------------------------------------------------------------------
// AI layer
//
// Design rule enforced by this schema: AI never owns an accounting number.
// Everything AI produces lands in AiSuggestion / DocumentExtraction, which a
// human must accept before it becomes an ActivityEntry. The deterministic
// calculation engines then do the arithmetic against approved EmissionFactor
// rows, exactly as they already did before AI existed.
//
// The AI layer deliberately adds no life-cycle models of its own: product
// assessment already has a full schema above (LcaAssessment and friends), and
// the LCA copilot reads that rather than a parallel one.
// ---------------------------------------------------------------------------

/// The task types the model router knows about. A model is chosen per task
/// (AiTaskModel), never hard-coded at a call site.
enum AiTaskType {
  GENERAL_CHAT
  CARBON_REASONING
  EMISSION_CLASSIFICATION
  DOCUMENT_EXTRACTION
  DOCUMENT_VISION
  LCA_ASSISTANT
  DATA_QUALITY_REVIEW
  REPORT_ASSISTANT
}

enum AiCallStatus {
  SUCCESS
  VALIDATION_FAILED
  PROVIDER_ERROR
  RATE_LIMITED
  TIMEOUT
  DISABLED
  NO_MODEL_AVAILABLE
  NOT_CONFIGURED
  FORBIDDEN
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
  SUPERSEDED
}

/// How much of an AI call is retained. Full prompts are never stored at any
/// level — see src/lib/ai/audit.ts for what each level keeps and why.
enum AiLoggingLevel {
  MINIMAL
  STANDARD
  VERBOSE
}

/// Provenance of a stored value, so a reader can always tell user-entered
/// data apart from imported, AI-extracted and derived data.
enum DataOrigin {
  USER_ENTERED
  IMPORTED
  AI_EXTRACTED
  DERIVED
}

/// Per-Organisation AI configuration (Phase 1 tenancy, T18 —
/// PHASE1_TENANCY_RBAC_SPEC.md §4: "Replace singleton with one settings root
/// per Organisation"). Environment variables provide the safe defaults; this
/// table lets an organisation's own administrator change model routing and
/// safety settings for their tenant only, without a code change or redeploy.
/// No API key is ever stored here — the key is read from OPENROUTER_API_KEY
/// server-side only, shared across every tenant.
///
/// The T1A contract migration dropped the pre-tenancy singleton row (`id`
/// literally `"singleton"`, `organisationId` null) that predated
/// Organisation and was already unread by application code, which always
/// resolves a settings row by `organisationId`.
model AiSettings {
  id                   String         @id @default(cuid())
  organisationId       String         @unique
  organisation         Organisation   @relation(fields: [organisationId], references: [id])
  aiEnabled            Boolean        @default(true)
  openRouterEnabled    Boolean        @default(true)
  /// When true the router will only ever call a model whose OpenRouter
  /// pricing metadata confirms it is free. If no free model is available for
  /// a task, the call fails closed with NO_MODEL_AVAILABLE — it never
  /// silently falls through to a paid model.
  freeOnly             Boolean        @default(true)
  /// Whether OpenRouter's own free-model router (openrouter/free) may be used.
  allowFreeRouter      Boolean        @default(true)
  /// Deliberately defaults to OFF: an extraction always goes to a human
  /// review screen before it becomes accounting data.
  autoAcceptExtraction Boolean        @default(false)
  /// Suggestions below this confidence are always marked requiresReview.
  minConfidence        Decimal        @default(0.7) @db.Decimal(4, 3)
  loggingLevel         AiLoggingLevel @default(STANDARD)
  requestsPerMinute    Int            @default(12)
  requestsPerDay       Int            @default(300)

  updatedByUserId String?
  updatedBy       User?    @relation("AiSettingsUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt       DateTime @updatedAt

  taskModels AiTaskModel[]
}

/// Platform-global cache of the provider's live model catalogue (GET
/// /api/v1/models) — shared by every tenant, distinct from the
/// per-Organisation `AiSettings` above (Phase 1 tenancy, T18: "Separate
/// platform model catalogue from organisation settings"). Free/paid
/// classification and capability checks use this provider metadata rather
/// than a hand-maintained list in source. Single row, `id` always
/// `"platform"`.
model AiModelCatalog {
  id                 String    @id @default("platform")
  catalogJson        Json?
  catalogRefreshedAt DateTime?
  updatedAt          DateTime  @updatedAt
}

/// Per-task model assignment, editable by an administrator in the UI.
model AiTaskModel {
  id              String     @id @default(cuid())
  settingsId      String
  settings        AiSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  task            AiTaskType
  modelId         String
  fallbackModelId String?
  updatedAt       DateTime   @updatedAt

  @@unique([settingsId, task])
}

/// One row per AI call attempt — the audit trail for AI activity. Full
/// prompts and raw document text are deliberately not stored (see
/// AiLoggingLevel); API keys never are, at any level.
model AiInteraction {
  id             String       @id @default(cuid())
  task           AiTaskType
  /// Which AIProvider implementation handled the call, e.g. "openrouter".
  provider       String
  feature        String
  modelRequested String
  modelUsed      String?
  status         AiCallStatus
  usedFallback   Boolean      @default(false)
  attempts       Int          @default(1)

  userId String?
  user   User?   @relation("AiInteractionUser", fields: [userId], references: [id])

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  entityId    String?
  siteId      String?
  relatedType String?
  relatedId   String?

  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])

  confidence       Decimal? @db.Decimal(4, 3)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  /// Only populated when OpenRouter itself reports a cost — never estimated.
  costUsd          Decimal? @db.Decimal(14, 8)
  latencyMs        Int?

  errorCode     String?
  errorMessage  String?
  outputSummary Json?

  createdAt DateTime @default(now())

  suggestions AiSuggestion[]

  @@index([createdAt])
  @@index([organisationId, createdAt])
  @@index([userId, createdAt])
  @@index([task, createdAt])
  @@index([status, createdAt])
}

/// An AI-produced proposal awaiting a human decision. Nothing here is
/// authoritative: accepting one is what writes real data, and that write is
/// attributed to the accepting user.
model AiSuggestion {
  id         String             @id @default(cuid())
  task       AiTaskType
  feature    String
  /// What the suggestion is about, e.g. "ACTIVITY_ENTRY", "EMISSION_FACTOR",
  /// "LCA_ASSESSMENT", "DOCUMENT".
  targetType String
  targetId   String?
  status     AiSuggestionStatus @default(PENDING)

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  confidence       Decimal? @db.Decimal(4, 3)
  requiresReview   Boolean  @default(true)
  /// Short auditable justification ("Classified as Scope 2 because ...").
  /// Never a chain-of-thought transcript.
  reasoningSummary String?
  payload          Json
  /// What the human actually accepted, when they edited before accepting.
  finalPayload     Json?
  modelUsed        String?

  interactionId String?
  interaction   AiInteraction? @relation(fields: [interactionId], references: [id])

  raisedByUserId String
  raisedBy       User     @relation("AiSuggestionRaisedBy", fields: [raisedByUserId], references: [id])
  createdAt      DateTime @default(now())

  decidedByUserId String?
  decidedBy       User?     @relation("AiSuggestionDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([organisationId, createdAt])
}

// ---------------------------------------------------------------------------
// Evidence documents (invoices, Waste Transfer Notes, meter statements ...)
// ---------------------------------------------------------------------------

enum SourceDocumentKind {
  ELECTRICITY_INVOICE
  GAS_INVOICE
  WATER_INVOICE
  FUEL_INVOICE
  WASTE_TRANSFER_NOTE
  WASTE_INVOICE
  TRANSPORT_RECORD
  SUPPLIER_DOCUMENT
  METER_STATEMENT
  OTHER
  UNKNOWN
}

enum DocumentStatus {
  UPLOADED
  EXTRACTED
  EXTRACTION_FAILED
  PARTIALLY_ACCEPTED
  ACCEPTED
  REJECTED
}

/// Uploaded evidence. Bytes live in Postgres so the platform stays a single
/// deployable with no object-store dependency — size-capped in application
/// code (AI_MAX_DOCUMENT_BYTES). Document text is always treated as
/// untrusted content when it reaches a model.
model SourceDocument {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  filename       String
  mimeType       String
  byteSize       Int
  /// Content hash — lets a re-upload of the same file be recognised rather
  /// than silently duplicated, and pins the exact bytes an extraction ran on.
  sha256         String
  content        Bytes

  kind   SourceDocumentKind @default(UNKNOWN)
  status DocumentStatus     @default(UPLOADED)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  uploadedByUserId String
  uploadedBy       User     @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now())
  notes            String?

  extractions     DocumentExtraction[]
  activityEntries ActivityEntry[]
  aiInteractions  AiInteraction[]

  @@index([siteId, uploadedAt])
  @@index([sha256])
  @@index([organisationId])
}

/// One AI extraction attempt against a document. `payload` is a validated
/// DocumentExtractionResult (see src/lib/ai/schemas.ts) — never raw model
/// output.
model DocumentExtraction {
  id         String         @id @default(cuid())
  documentId String
  document   SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  modelUsed     String?
  status        AiCallStatus
  payload       Json?
  confidence    Decimal?     @db.Decimal(4, 3)
  warnings      String[]
  missingFields String[]
  errorMessage  String?
  interactionId String?

  createdByUserId String
  createdBy       User     @relation("ExtractionCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  reviewedByUserId String?
  reviewedBy       User?     @relation("ExtractionReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?

  acceptedEntries ActivityEntry[] @relation("ExtractionAcceptedEntries")

  @@index([documentId, createdAt])
}

// ---------------------------------------------------------------------------
// T1B — PostgreSQL RLS defence-in-depth spike (Docs/PHASE1_TENANCY_RBAC_SPEC.md
// §9 "Optional RLS migration C"; findings in Docs/T1B_RLS_SPIKE_FINDINGS.md).
//
// This table exists only to prove the Prisma + Neon-pooling + Postgres RLS
// pattern is safe before any rollout decision. It is deliberately isolated:
// no relation to Organisation or any other model, no application code path
// reads or writes it, and no real environmental/tenant data is ever stored
// here. `organisationId` is a plain scalar (not a foreign key) so this slice
// never touches the real tenancy schema. Application repositories continue
// to enforce tenant isolation exactly as before T1B; this table's isolation
// is enforced only by the RLS policy created in this table's migration and
// exercised by src/lib/rls-spike.
// ---------------------------------------------------------------------------
model RlsSpikeRecord {
  id             String   @id @default(cuid())
  organisationId String
  note           String
  createdAt      DateTime @default(now())

  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Phase 4 — provider-neutral legal register (task T40,
// Docs/PHASE4_LEGAL_COMPLIANCE_SPEC.md §§1-3 "Fixed decisions" and
// "Provider-neutral source model").
//
// Everything below is a platform-global authoritative reference, not tenant
// data — same pattern as `AiModelCatalog` (T18): one shared record set that
// every Organisation reads, never scoped by `organisationId`. Per-Organisation
// review/applicability/obligation state (`LegalReviewCandidate` and later
// Phase 4 tasks) is deliberately out of scope here — T42 adds it once a
// sync worker exists to populate it.
//
// Immutability: `LegalInstrumentVersion` is the retrieved, checksummed
// snapshot of an instrument at a point in time — the "source provenance"
// the T40 acceptance criteria requires stay immutable — so its migration
// adds an append-only trigger (deny UPDATE/DELETE) exactly like
// `AuditEvent`'s. `LegalChangeEvent`'s detection/evidence columns get a
// narrower trigger that blocks changes to those columns specifically while
// still allowing `status` to progress through its DETECTED -> ... state
// machine in a later task (T42 triage) — the same partial-immutability
// shape as `EmsScopeVersion`/`AspectAssessment`.
// ---------------------------------------------------------------------------

enum LegalSourceAuthorityType {
  OFFICIAL
  EDITORIAL
}

enum LegalSourceProviderStatus {
  ENABLED
  DISABLED
}

enum LegalSyncStream {
  PUBLICATIONS
  EFFECTS
  VERSIONS
}

enum LegalSyncCursorStatus {
  ACTIVE
  STALE
  ERROR
}

enum LegalInstrumentStatus {
  ACTIVE
  REVOKED
  SUPERSEDED
  UNKNOWN
}

/// LegalChangeEvent.status state machine (spec §2):
/// DETECTED -> TRIAGED -> REVIEW_REQUIRED -> REVIEWED -> DISMISSED/CLOSED.
/// T40 only ever writes DETECTED; later transitions are T42's triage worker.
enum LegalChangeEventStatus {
  DETECTED
  TRIAGED
  REVIEW_REQUIRED
  REVIEWED
  DISMISSED
  CLOSED
}

/// Stable jurisdiction reference (e.g. "GB-ENG", "GB"). Organisation-neutral;
/// an Organisation's jurisdiction subscriptions are Organisation-owned state
/// added by a later task, not stored here.
model Jurisdiction {
  id   String @id @default(cuid())
  code String @unique

  name        String
  country     String
  subdivision String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instruments LegalInstrumentJurisdiction[]
  syncCursors LegalSyncCursor[]

  @@index([active])
}

/// Organisation-neutral legal taxonomy. An Organisation's own local tags are
/// separate, Organisation-owned state added by a later task, not stored here.
model LegalTopic {
  id  String @id @default(cuid())
  key String @unique

  name        String
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instruments LegalInstrumentTopic[]

  @@index([active])
}

/// One row per legal content source (e.g. "legislation-gov-uk"). Holds a
/// non-secret configuration reference only — credentials live outside the
/// database, in the provider's own configuration (T41 concern).
model LegalSourceProvider {
  id  String @id @default(cuid())
  key String @unique

  name            String
  authorityType   LegalSourceAuthorityType
  configReference String?
  status          LegalSourceProviderStatus @default(ENABLED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cursors      LegalSyncCursor[]
  instruments  LegalInstrument[]
  changeEvents LegalChangeEvent[]

  @@index([status])
}

/// Per (provider, stream, filter) sync position. `filterKey` is the
/// canonical encoding of whatever narrows a poll — a jurisdiction code, or
/// "" when the stream is not jurisdiction-filtered — so uniqueness never
/// depends on a nullable column. Advancing `cursor`/`lastSuccessAt` is the
/// service layer's job (`legal-source-service.ts`): the acceptance
/// criterion "cursors advance transactionally only after batch commit"
/// means the update happens inside the same transaction as the
/// instrument/version/event rows it accounts for, never before or outside
/// it — there is nothing at the schema level that can enforce that by
/// itself.
model LegalSyncCursor {
  id String @id @default(cuid())

  providerId String
  provider   LegalSourceProvider @relation(fields: [providerId], references: [id])

  stream         LegalSyncStream
  jurisdictionId String?
  jurisdiction   Jurisdiction?   @relation(fields: [jurisdictionId], references: [id])
  filterKey      String          @default("")

  cursor         String?
  overlapStartAt DateTime?
  lastSuccessAt  DateTime?
  lastAttemptAt  DateTime?
  status         LegalSyncCursorStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, stream, filterKey])
  @@index([providerId, status])
}

/// A provider's canonical instrument (e.g. one UK statutory instrument).
/// Mutable "current state" pointer — `status`/`latestSourceHash`/
/// `lastCheckedAt` update as new versions/events arrive. The immutable
/// history lives in `LegalInstrumentVersion`, not here.
model LegalInstrument {
  id String @id @default(cuid())

  providerId  String
  provider    LegalSourceProvider @relation(fields: [providerId], references: [id])
  canonicalId String

  instrumentType String
  title          String
  year           Int?
  number         String?

  madeAt         DateTime?
  publishedAt    DateTime?
  commencementAt DateTime?

  status           LegalInstrumentStatus @default(ACTIVE)
  latestSourceHash String?
  lastCheckedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jurisdictions       LegalInstrumentJurisdiction[]
  topics              LegalInstrumentTopic[]
  versions            LegalInstrumentVersion[]
  provisionReferences LegalProvisionReference[]
  sourceOfEvents      LegalChangeEvent[]            @relation("LegalChangeEventSourceInstrument")
  affectedByEvents    LegalChangeEvent[]            @relation("LegalChangeEventAffectedInstrument")

  // Organisation-owned applicability decisions against this instrument (T43).
  applicabilityAssessments ApplicabilityAssessment[]

  // Organisation-owned compliance obligation versions sourced from this instrument (T44).
  complianceObligationVersions ComplianceObligationVersion[]

  @@unique([providerId, canonicalId])
  @@index([status])
}

model LegalInstrumentJurisdiction {
  id String @id @default(cuid())

  instrumentId String
  instrument   LegalInstrument @relation(fields: [instrumentId], references: [id])

  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([instrumentId, jurisdictionId])
}

model LegalInstrumentTopic {
  id String @id @default(cuid())

  instrumentId String
  instrument   LegalInstrument @relation(fields: [instrumentId], references: [id])

  topicId String
  topic   LegalTopic @relation(fields: [topicId], references: [id])

  createdAt DateTime @default(now())

  @@unique([instrumentId, topicId])
}

/// The immutable, checksummed snapshot behind an instrument at one provider
/// retrieval — "source provenance" in the T40 acceptance criteria. Never
/// updated or deleted once written (see migration trigger); a corrected or
/// newer retrieval is always a new row, never an edit of this one.
/// `documentStorageRef` is an opaque storage key, never inline document
/// bytes — same convention as `EvidenceObject` (T22).
model LegalInstrumentVersion {
  id String @id @default(cuid())

  instrumentId String
  instrument   LegalInstrument @relation(fields: [instrumentId], references: [id])

  providerVersionId  String
  retrievedAt        DateTime
  metadata           Json
  documentStorageRef String?
  checksum           String
  sourceUrl          String

  createdAt DateTime @default(now())

  provisionReferences LegalProvisionReference[]
  sourceOfEvents      LegalChangeEvent[]        @relation("LegalChangeEventSourceVersion")

  @@unique([instrumentId, providerVersionId])
}

/// A pointer to one provision within an instrument/version — the provider's
/// identifier/URI and a short label only. Never stores copied legislative
/// prose (spec §3: "no unlicensed copied prose").
model LegalProvisionReference {
  id String @id @default(cuid())

  instrumentId String
  instrument   LegalInstrument @relation(fields: [instrumentId], references: [id])

  versionId String?
  version   LegalInstrumentVersion? @relation(fields: [versionId], references: [id])

  providerProvisionId String
  label               String?
  uri                 String?

  createdAt DateTime @default(now())

  affectedByEvents LegalChangeEvent[] @relation("LegalChangeEventAffectedProvision")

  // Organisation-owned compliance obligation versions citing this provision (T44).
  complianceObligationVersions ComplianceObligationVersion[]

  @@unique([instrumentId, providerProvisionId])
}

/// One provider-reported change (new publication, amendment, effect, ...).
/// `dedupeKey` is the provider's own identifier for the change (falls back
/// to a content-derived key when a provider doesn't supply one) — the
/// `(providerId, dedupeKey)` unique constraint is what makes replaying a
/// provider's feed, or an overlapping poll window, idempotent: a repeat
/// insert collapses onto the existing row instead of creating a duplicate
/// (T40 acceptance: "unique idempotency constraints prevent duplicate
/// events"). Detecting a change never decides applicability or creates an
/// obligation — that is Organisation-owned state a later task adds.
model LegalChangeEvent {
  id String @id @default(cuid())

  providerId      String
  provider        LegalSourceProvider @relation(fields: [providerId], references: [id])
  providerEventId String

  /// Provider-specific, e.g. "NEW_PUBLICATION", "AMENDMENT", "EFFECT" — a
  /// plain string, not an enum, so a new provider's vocabulary never forces
  /// a migration (same reasoning as `OutboxMessage.topic`).
  eventType String

  sourceInstrumentId String
  sourceInstrument   LegalInstrument @relation("LegalChangeEventSourceInstrument", fields: [sourceInstrumentId], references: [id])

  affectedInstrumentId String?
  affectedInstrument   LegalInstrument? @relation("LegalChangeEventAffectedInstrument", fields: [affectedInstrumentId], references: [id])

  affectedProvisionId String?
  affectedProvision   LegalProvisionReference? @relation("LegalChangeEventAffectedProvision", fields: [affectedProvisionId], references: [id])

  sourceVersionId String?
  sourceVersion   LegalInstrumentVersion? @relation("LegalChangeEventSourceVersion", fields: [sourceVersionId], references: [id])
  sourceHash      String?

  detectedAt  DateTime
  effectiveAt DateTime?
  rawEvidence Json
  dedupeKey   String

  status LegalChangeEventStatus @default(DETECTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organisation-owned applicability decisions prompted by this event (T43).
  applicabilityAssessments ApplicabilityAssessment[]

  // Organisation-owned obligation-change reviews prompted by this event (T44).
  obligationChangeReviews ObligationChangeReview[]

  @@unique([providerId, dedupeKey])
  @@index([providerId, detectedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Applicability workflow (task T43, Docs/PHASE4_LEGAL_COMPLIANCE_SPEC.md
// §§1-2,5,9). Organisation-owned: unlike everything above in this section,
// `ApplicabilityAssessment`/`ApplicabilityAssessmentScope` carry
// `organisationId` because a legal-change candidate's applicability is a
// human, per-tenant judgement, not shared platform reference data.
//
// State machine (spec §2): DRAFT -> IN_REVIEW -> APPLICABLE / NOT_APPLICABLE
// / UNCERTAIN -> SUPERSEDED. A decided assessment (any of the three decision
// statuses) is never edited in place — re-assessing an instrument/event
// creates a new DRAFT via `supersedesAssessmentId`, exactly the
// AspectAssessment/SignificanceMethod revision-chain shape, so a
// NOT_APPLICABLE decision "remains reviewable history" (T43 acceptance)
// rather than being overwritten. Detecting/recording the underlying
// LegalChangeEvent (T40/T42) never itself changes this table — an
// assessment is always a distinct, human-authored write.
// ---------------------------------------------------------------------------

enum ApplicabilityAssessmentStatus {
  DRAFT
  IN_REVIEW
  APPLICABLE
  NOT_APPLICABLE
  UNCERTAIN
  SUPERSEDED
}

/// One organisation's applicability judgement against a legal instrument or
/// a T46 `OtherRequirementSource` (optionally, for an instrument, prompted
/// by one specific change event). `rationale`, `evidence` (via
/// `EvidenceLink`, resourceType "applicability_assessment"),
/// `reviewedByMembershipId` and `nextReviewAt` are required before
/// `decide()` may move this row out of IN_REVIEW (service-layer rule, spec
/// §9 "decision/rationale/reviewer/evidence/review date required") —
/// nullable here only because a DRAFT may not have them yet.
/// `followUpOwnerMembershipId` is required specifically for an UNCERTAIN
/// decision (spec §2 "UNCERTAIN requires an owner and follow-up date").
///
/// Exactly one of `instrumentId`/`otherRequirementSourceId` is set
/// (service-layer rule, defence-in-depth `applicability_assessment_source`
/// CHECK constraint below) — spec §5 "source/instrument/change/other
/// requirement" — so a manual T46 source follows the identical DRAFT ->
/// IN_REVIEW -> decided state machine an automated legal instrument does.
model ApplicabilityAssessment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  instrumentId String?
  instrument   LegalInstrument? @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  otherRequirementSourceId String?
  otherRequirementSource   OtherRequirementSource? @relation(fields: [organisationId, otherRequirementSourceId], references: [organisationId, id])

  changeEventId String?
  changeEvent   LegalChangeEvent? @relation(fields: [changeEventId], references: [id])

  status    ApplicabilityAssessmentStatus @default(DRAFT)
  rationale String?

  // The assessor's proposed decision, entered at DRAFT/IN_REVIEW time.
  // Reuses `ApplicabilityAssessmentStatus` rather than a second enum, but
  // is only ever set to one of the three decision members (service-layer
  // rule) — `status` is what the reviewer actually decides, and may agree
  // with or override this proposal.
  proposedDecision ApplicabilityAssessmentStatus?

  assessedByMembershipId String
  assessedBy             OrganisationMembership @relation("ApplicabilityAssessmentAssessedBy", fields: [organisationId, assessedByMembershipId], references: [organisationId, id])
  assessedAt             DateTime               @default(now())

  reviewedByMembershipId String?
  reviewedBy             OrganisationMembership? @relation("ApplicabilityAssessmentReviewedBy", fields: [organisationId, reviewedByMembershipId], references: [organisationId, id])
  reviewedAt             DateTime?

  // Next scheduled/change-triggered review date — the spec §9 "review date"
  // acceptance item. Required by the service before a decision is recorded.
  nextReviewAt DateTime?

  // UNCERTAIN-only follow-up owner (spec §2). Restrict, not cascade: the
  // owning membership must be explicitly reassigned, never silently dropped.
  followUpOwnerMembershipId String?
  followUpOwner             OrganisationMembership? @relation("ApplicabilityAssessmentFollowUpOwner", fields: [organisationId, followUpOwnerMembershipId], references: [organisationId, id], onDelete: Restrict)

  supersedesAssessmentId String?
  supersedesAssessment   ApplicabilityAssessment? @relation("ApplicabilityAssessmentSuccessor", fields: [organisationId, supersedesAssessmentId], references: [organisationId, id])
  successorAssessment    ApplicabilityAssessment? @relation("ApplicabilityAssessmentSuccessor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scopes ApplicabilityAssessmentScope[]

  // Compliance obligation versions created from this decided assessment (T44).
  complianceObligationVersions ComplianceObligationVersion[]

  @@unique([organisationId, id])
  @@unique([organisationId, supersedesAssessmentId])
  @@index([organisationId, instrumentId, status])
  @@index([organisationId, otherRequirementSourceId, status])
  @@index([organisationId, changeEventId])
  @@index([organisationId, status])
  @@index([organisationId, assessedByMembershipId])
}

/// One Entity/Site/Process/Aspect this assessment's decision covers — the
/// spec §5 "assessed scopes" list. Exactly one of the four columns is set
/// per row (service-layer rule, mirroring `ControlApplicability`'s shape);
/// an assessment may have several scope rows to cover multiple sites/
/// processes/aspects at once.
model ApplicabilityAssessmentScope {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  assessmentId String
  assessment   ApplicabilityAssessment @relation(fields: [organisationId, assessmentId], references: [organisationId, id], onDelete: Cascade)

  entityId  String?
  entity    Entity?              @relation(fields: [organisationId, entityId], references: [organisationId, id], onDelete: Restrict)
  siteId    String?
  site      Site?                @relation(fields: [organisationId, siteId], references: [organisationId, id], onDelete: Restrict)
  processId String?
  process   ActivityProcess?     @relation(fields: [organisationId, processId], references: [organisationId, id], onDelete: Restrict)
  aspectId  String?
  aspect    EnvironmentalAspect? @relation(fields: [organisationId, aspectId], references: [organisationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([organisationId, assessmentId, entityId, siteId, processId, aspectId], map: "ApplicabilityAssessmentScope_scope_key")
  @@index([organisationId, assessmentId])
  @@index([organisationId, entityId])
  @@index([organisationId, siteId])
  @@index([organisationId, processId])
  @@index([organisationId, aspectId])
}

// ---------------------------------------------------------------------------
// Compliance obligation versioning and approval (task T44,
// Docs/PHASE4_LEGAL_COMPLIANCE_SPEC.md §§1-2,5,9). Organisation-owned, same
// shape family as T22 ControlledDocument/ControlledDocumentRevision:
// `ComplianceObligation` is a stable reference that only ever points at the
// current *active* version; `ComplianceObligationVersion` carries the actual
// content and only ever becomes ACTIVE through `approveComplianceObligationVersion`
// (obligation-service.ts), which is the one place the active pointer moves.
//
// State machine (spec §2): DRAFT -> IN_REVIEW -> APPROVED -> ACTIVE ->
// SUPERSEDED / RETIRED, with an IN_REVIEW -> REJECTED branch and an
// IN_REVIEW -> DRAFT "returned for revision" branch. A version that has left
// DRAFT/IN_REVIEW is never edited in place (T44 acceptance: "approved record
// immutable; edits create successor") — the migration's
// `compliance_obligation_version_immutable_once_approved` trigger is
// defence-in-depth for that rule, mirroring T22's controlled-document
// trigger exactly.
//
// `ComplianceObligationApproval` is the append-only decision log the spec
// §5 asks for in addition to the denormalised `approvedByUserId`/
// `approvedAt` columns on the version itself — it is never updated or
// deleted, so "every decision audited" holds for REJECTED/RETURNED
// decisions too, not just the one that ends up ACTIVE.
// ---------------------------------------------------------------------------

enum ComplianceObligationVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  SUPERSEDED
  RETIRED
  REJECTED
}

enum ComplianceObligationApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
}

enum ObligationChangeReviewDecision {
  NO_CHANGE
  REVISE
  RETIRE
  SEEK_ADVICE
}

/// Stable reference to one compliance obligation. Never carries obligation
/// content itself — only the pointer to whichever `ComplianceObligationVersion`
/// is currently ACTIVE, so "active pointer changes only inside approval
/// transaction" (spec §5) is enforced by there being exactly one write site
/// for `activeVersionId` (`approveComplianceObligationVersion`).
model ComplianceObligation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  activeVersionId String?                      @unique
  activeVersion   ComplianceObligationVersion? @relation("ComplianceObligationActiveVersion", fields: [organisationId, activeVersionId], references: [organisationId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ComplianceObligationVersion[] @relation("ComplianceObligationVersions")

  // Audit programme/execution scopes (T60).
  auditProgrammeItemScopes AuditProgrammeItemScope[]
  emsAuditScopes           EmsAuditScope[]

  // Nonconformity workflow (T63).
  nonconformities Nonconformity[]

  @@unique([organisationId, id])
  @@unique([organisationId, activeVersionId])
  @@index([organisationId])
}

/// One version of one compliance obligation's content — title, requirement
/// summary, source/provisions, owner, frequency/trigger, effective/review
/// dates and controls/aspects/sites/entities scope (spec §5). Only created
/// from an `APPLICABLE` `ApplicabilityAssessment` (T44 acceptance: "create
/// obligations from applicable sources") — `applicabilityAssessmentId` is
/// required, not optional, so that link can never be skipped.
model ComplianceObligationVersion {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  obligationId String
  obligation   ComplianceObligation @relation("ComplianceObligationVersions", fields: [organisationId, obligationId], references: [organisationId, id])
  version      Int

  title              String
  requirementSummary String

  // Source/provisions this obligation traces to (spec §5). Exactly one of
  // `instrumentId`/`otherRequirementSourceId` is set, mirroring
  // `applicabilityAssessment.instrumentId`/`.otherRequirementSourceId` —
  // this obligation version always inherits whichever one is set on its
  // `applicabilityAssessment` (T46: "records follow identical
  // applicability/approval/version rules").
  instrumentId String?
  instrument   LegalInstrument? @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  otherRequirementSourceId String?
  otherRequirementSource   OtherRequirementSource? @relation(fields: [organisationId, otherRequirementSourceId], references: [organisationId, id])

  provisionReferenceId String?
  provisionReference   LegalProvisionReference? @relation(fields: [provisionReferenceId], references: [id])

  applicabilityAssessmentId String
  applicabilityAssessment   ApplicabilityAssessment @relation(fields: [organisationId, applicabilityAssessmentId], references: [organisationId, id], onDelete: Restrict)

  ownerMembershipId String
  owner             OrganisationMembership @relation("ComplianceObligationVersionOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)

  frequency          String?
  triggerDescription String?

  effectiveFrom DateTime?
  reviewDueDate DateTime?

  status ComplianceObligationVersionStatus @default(DRAFT)

  preparedByUserId String
  preparedAt       DateTime @default(now())

  // Denormalised for fast reads — the authoritative decision history lives
  // in `ComplianceObligationApproval` (append-only, includes REJECTED/
  // RETURNED decisions this pair of columns cannot represent).
  approvedByUserId String?
  approvedAt       DateTime?

  supersedesVersionId String?
  supersedesVersion   ComplianceObligationVersion? @relation("ComplianceObligationVersionSuccessor", fields: [organisationId, supersedesVersionId], references: [organisationId, id])
  successorVersion    ComplianceObligationVersion? @relation("ComplianceObligationVersionSuccessor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activeForObligation ComplianceObligation? @relation("ComplianceObligationActiveVersion")

  scopes        ComplianceObligationVersionScope[]
  controlLinks  ComplianceObligationVersionControl[]
  approvals     ComplianceObligationApproval[]
  changeReviews ObligationChangeReview[]

  // Compliance evaluation (T45): every ComplianceEvaluationItem that pins
  // this exact version.
  evaluationItems ComplianceEvaluationItem[]

  // Objective source links (T50).
  objectiveSourceLinks ObjectiveSourceLink[]

  @@unique([organisationId, id])
  @@unique([organisationId, obligationId, version])
  @@unique([organisationId, supersedesVersionId])
  @@index([organisationId, obligationId, status])
  @@index([organisationId, status])
  @@index([organisationId, instrumentId])
  @@index([organisationId, otherRequirementSourceId])
  @@index([organisationId, ownerMembershipId])
}

/// One Entity/Site/Aspect a compliance obligation version applies to (spec
/// §5 "controls/aspects/sites/entities"). Exactly one of the three columns
/// is set per row, the same one-of-N shape as `ApplicabilityAssessmentScope`.
model ComplianceObligationVersionScope {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  obligationVersionId String
  obligationVersion   ComplianceObligationVersion @relation(fields: [organisationId, obligationVersionId], references: [organisationId, id], onDelete: Cascade)

  entityId String?
  entity   Entity?              @relation(fields: [organisationId, entityId], references: [organisationId, id], onDelete: Restrict)
  siteId   String?
  site     Site?                @relation(fields: [organisationId, siteId], references: [organisationId, id], onDelete: Restrict)
  aspectId String?
  aspect   EnvironmentalAspect? @relation(fields: [organisationId, aspectId], references: [organisationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([organisationId, obligationVersionId, entityId, siteId, aspectId], map: "ComplianceObligationVersionScope_scope_key")
  @@index([organisationId, obligationVersionId])
  @@index([organisationId, entityId])
  @@index([organisationId, siteId])
  @@index([organisationId, aspectId])
}

/// Links a compliance obligation version to the T33 operational control(s)
/// that discharge it (spec §5 "controls").
model ComplianceObligationVersionControl {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  obligationVersionId String
  obligationVersion   ComplianceObligationVersion @relation(fields: [organisationId, obligationVersionId], references: [organisationId, id], onDelete: Cascade)

  controlId String
  control   OperationalControl @relation(fields: [organisationId, controlId], references: [organisationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([organisationId, obligationVersionId, controlId], map: "ComplianceObligationVersionControl_link_key")
  @@index([organisationId, obligationVersionId])
  @@index([organisationId, controlId])
}

/// Append-only exact-version approval decision (spec §5). Never updated or
/// deleted — a returned-for-revision or rejected decision stays visible
/// history alongside whichever later decision eventually approves a
/// successor version. `permissionCode` snapshots which permission gated
/// this decision at the time it was made, independent of later catalogue
/// changes.
model ComplianceObligationApproval {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  obligationVersionId String
  obligationVersion   ComplianceObligationVersion @relation(fields: [organisationId, obligationVersionId], references: [organisationId, id], onDelete: Cascade)

  decision       ComplianceObligationApprovalDecision
  permissionCode String
  comment        String?

  approverMembershipId String
  approver             OrganisationMembership @relation("ComplianceObligationApprovalApprover", fields: [organisationId, approverMembershipId], references: [organisationId, id], onDelete: Restrict)
  decidedAt            DateTime               @default(now())

  @@index([organisationId, obligationVersionId])
  @@index([organisationId, approverMembershipId])
}

/// Records a competent user's review of the impact of one `LegalChangeEvent`
/// on one existing compliance obligation version (spec §5, and spec §1
/// "an upstream amendment never silently edits an approved obligation; it
/// opens a review candidate"). This table is that review candidate: a
/// REVISE/RETIRE/SEEK_ADVICE decision here never itself edits the obligation
/// version — a human still has to act on it through the normal successor-
/// version/retire functions, so the source change never directly changes an
/// active obligation.
model ObligationChangeReview {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  changeEventId String
  changeEvent   LegalChangeEvent @relation(fields: [changeEventId], references: [id])

  obligationVersionId String
  obligationVersion   ComplianceObligationVersion @relation(fields: [organisationId, obligationVersionId], references: [organisationId, id], onDelete: Cascade)

  impactAssessment String
  decision         ObligationChangeReviewDecision?

  reviewerMembershipId String
  reviewer             OrganisationMembership @relation("ObligationChangeReviewReviewer", fields: [organisationId, reviewerMembershipId], references: [organisationId, id], onDelete: Restrict)
  reviewedAt           DateTime               @default(now())
  followUpDate         DateTime?

  createdAt DateTime @default(now())

  @@index([organisationId, obligationVersionId])
  @@index([organisationId, changeEventId])
}

// ---------------------------------------------------------------------------
// Other requirements and manual legal sources (task T46,
// Docs/PHASE4_LEGAL_COMPLIANCE_SPEC.md §§1-2,5,9). Unlike `LegalInstrument`
// (global platform reference data ingested by the T41/T42 provider sync),
// an `OtherRequirementSource` is a permit, consent, regulator notice,
// contract, customer requirement or voluntary commitment a competent user
// enters by hand — so it is Organisation-owned from creation, has no
// provider/canonicalId, and is never touched by the legal sync worker.
//
// Spec §1 "official legislation, permits, consents, regulator notices,
// contracts, customer requirements and voluntary commitments share the
// applicability/obligation workflow but retain distinct source types" is
// what `ApplicabilityAssessment.otherRequirementSourceId` and
// `ComplianceObligationVersion.otherRequirementSourceId` exist for (both
// added alongside this model, each mutually exclusive with the
// pre-existing `instrumentId` column on that same row via a CHECK
// constraint the migration adds) — a manual source assessed here moves
// through the exact same DRAFT -> IN_REVIEW -> APPLICABLE/NOT_APPLICABLE/
// UNCERTAIN state machine (T43) and the exact same
// DRAFT -> IN_REVIEW -> APPROVED -> ACTIVE versioning/approval state
// machine (T44) a `LegalInstrument`-sourced one does — "records follow
// identical applicability/approval/version rules" (T46 acceptance). This
// model itself carries no version chain of its own: like
// `ExternalProviderControl` (T35), it is a plain, competent-user-editable
// record with a status and a review/expiry date, not obligation content —
// "manual source gets review/expiry" (T46 acceptance) is `nextReviewAt`/
// `expiryDate` here; the *approved obligation's* content immutability
// still comes entirely from T44's existing
// `compliance_obligation_version_immutable_once_approved` trigger.
// ---------------------------------------------------------------------------

enum OtherRequirementSourceType {
  PERMIT
  CONSENT
  REGULATOR_NOTICE
  CONTRACT
  CUSTOMER_REQUIREMENT
  VOLUNTARY_COMMITMENT
}

enum OtherRequirementSourceStatus {
  ACTIVE
  EXPIRED
  SUPERSEDED
  WITHDRAWN
}

/// A manually entered, Organisation-owned legal/other-requirement source
/// (spec §5 "OtherRequirementSource: type, issuing party, reference,
/// dates, controlled evidence, status"). `type` and `issuingParty` make
/// "source type and authority clear" (T46 acceptance); supporting files are
/// attached the same controlled-evidence way every other EMS record is
/// (`EvidenceLink`, resourceType "other_requirement_source").
model OtherRequirementSource {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  type         OtherRequirementSourceType
  title        String
  issuingParty String
  reference    String?
  description  String?

  issuedAt      DateTime?
  effectiveFrom DateTime?
  expiryDate    DateTime?
  nextReviewAt  DateTime?

  status OtherRequirementSourceStatus @default(ACTIVE)

  ownerMembershipId String
  owner             OrganisationMembership @relation("OtherRequirementSourceOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Organisation-owned applicability decisions against this source (T46, mirrors LegalInstrument.applicabilityAssessments).
  applicabilityAssessments ApplicabilityAssessment[]

  // Organisation-owned compliance obligation versions sourced from this record (T46, mirrors LegalInstrument.complianceObligationVersions).
  complianceObligationVersions ComplianceObligationVersion[]

  @@unique([organisationId, id])
  @@index([organisationId, status])
  @@index([organisationId, type])
  @@index([organisationId, nextReviewAt])
}

// ---------------------------------------------------------------------------
// Compliance evaluation (task T45, Docs/PHASE4_LEGAL_COMPLIANCE_SPEC.md §§1-2,
// 6, 9). Schedules and evidences the human, evidenced check of whether this
// organisation is actually meeting each of its ACTIVE `ComplianceObligation`
// versions — a distinct step from T44's approval (which only ever decides
// what the obligation *requires*, never whether it is being met).
//
// State machine (spec §2):
//   ComplianceEvaluation: PLANNED -> IN_PROGRESS -> COMPLETED -> ISSUED
//   ComplianceEvaluationItem: NOT_EVALUATED -> COMPLIANT / PARTIALLY_COMPLIANT
//                              / NONCOMPLIANT / NOT_APPLICABLE
//
// Fixed decisions this section/evaluation-service.ts enforce (spec §§1,9):
//  - `ComplianceEvaluationItem.obligationVersionId` pins one *exact*
//    `ComplianceObligationVersion` row — since that row is itself immutable
//    once it leaves DRAFT/IN_REVIEW (T44's trigger), pinning the id is
//    already enough to "freeze" the obligation content an issued report
//    describes; `ComplianceEvaluation.reportPayload` additionally snapshots
//    that content into JSON at issue time (the same pattern
//    `LcaAssessmentVersion.payload` uses), so the report reads correctly
//    even if a much later phase ever changes how obligation content is
//    joined/displayed.
//  - only `evaluation-service.ts`'s `recordComplianceEvaluationItemResult`
//    writes an item's status, and only while the parent evaluation is
//    IN_PROGRESS — there is no default/inferred outcome, so "results never
//    auto-decided" holds by construction, not convention.
//  - `completeComplianceEvaluation` refuses to move an evaluation to
//    COMPLETED while any item is still NOT_EVALUATED — every item must have
//    an explicit human decision (including NOT_APPLICABLE) before the
//    evaluation can be completed, let alone issued.
//  - once COMPLETED, an evaluation's items are frozen (the
//    `compliance_evaluation_item_immutable_once_locked` trigger below); once
//    ISSUED, the evaluation row itself is fully frozen (the
//    `compliance_evaluation_immutable_once_issued` trigger) — "issued
//    evaluation pins exact obligation versions and is immutable" (spec §9).
//  - `ComplianceEvaluationFindingLink` only ever records a *request* to link
//    a NONCOMPLIANT/PARTIALLY_COMPLIANT item to a nonconformity or
//    corrective action — the Nonconformity/CorrectiveAction models
//    themselves belong to T63/T64 and do not exist yet. This mirrors T35's
//    `EmergencyExerciseAction.nonconformityReference` plain-reference
//    pattern, but as its own append-only table rather than a text column, so
//    "noncompliance link creates a request/interface call; it does not
//    auto-close or fabricate NC details" (spec §9) is enforced by there
//    being no write path from this module into any NC/CAPA table.
// ---------------------------------------------------------------------------

enum ComplianceEvaluationProgrammeStatus {
  ACTIVE
  CLOSED
}

enum ComplianceEvaluationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ISSUED
}

enum ComplianceEvaluationItemStatus {
  NOT_EVALUATED
  COMPLIANT
  PARTIALLY_COMPLIANT
  NONCOMPLIANT
  NOT_APPLICABLE
}

enum ComplianceEvaluationFindingLinkType {
  NONCONFORMITY
  CORRECTIVE_ACTION
}

/// A standing programme of periodic compliance evaluations (spec §6: "period,
/// scope, evaluator assignment, schedule, status"). Individual
/// `ComplianceEvaluation` cycles are created under a programme; the
/// programme itself carries no obligation content.
model ComplianceEvaluationProgramme {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name        String
  description String?

  periodStart DateTime
  periodEnd   DateTime

  // Plain string, not an enum, matching `ReminderRule.recurrence` (T24) —
  // "ONCE" or a simple recurrence key evaluated by the service layer.
  recurrence String @default("ONCE")

  leadMembershipId String
  lead             OrganisationMembership @relation("ComplianceEvaluationProgrammeLead", fields: [organisationId, leadMembershipId], references: [organisationId, id], onDelete: Restrict)

  status ComplianceEvaluationProgrammeStatus @default(ACTIVE)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evaluations ComplianceEvaluation[]

  @@unique([organisationId, id])
  @@index([organisationId, status])
}

/// One evaluation cycle under a programme (spec §6: "programme, date/range,
/// entities/sites, lead, status, issued snapshot and evidence").
model ComplianceEvaluation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  programmeId String
  programme   ComplianceEvaluationProgramme @relation(fields: [organisationId, programmeId], references: [organisationId, id], onDelete: Restrict)

  periodStart DateTime
  periodEnd   DateTime

  leadMembershipId String
  lead             OrganisationMembership @relation("ComplianceEvaluationLead", fields: [organisationId, leadMembershipId], references: [organisationId, id], onDelete: Restrict)

  status ComplianceEvaluationStatus @default(PLANNED)

  // Populated only by `issueComplianceEvaluation`, in the same transaction
  // that moves status to ISSUED — a snapshot of every item's pinned
  // obligation-version content and outcome, so "report freezes source
  // obligation versions" holds even independent of the version rows'
  // already-immutable content (spec §9, definition of done §11).
  reportPayload  Json?
  issuedAt       DateTime?
  issuedByUserId String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scopes ComplianceEvaluationScope[]
  items  ComplianceEvaluationItem[]

  @@unique([organisationId, id])
  @@index([organisationId, programmeId, status])
  @@index([organisationId, status])
}

/// One Entity/Site an evaluation cycle's scope covers (spec §6
/// "entities/sites"). No rows at all means the evaluation is organisation-
/// wide, the same "empty scope = unscoped" reading `ComplianceObligationVersionScope`
/// does not use (that model requires at least one row) but which this model
/// does, since an evaluation programme legitimately covers "everything
/// currently active" without an evaluator hand-picking every Entity/Site.
model ComplianceEvaluationScope {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  evaluationId String
  evaluation   ComplianceEvaluation @relation(fields: [organisationId, evaluationId], references: [organisationId, id], onDelete: Cascade)

  entityId String?
  entity   Entity? @relation(fields: [organisationId, entityId], references: [organisationId, id], onDelete: Restrict)
  siteId   String?
  site     Site?   @relation(fields: [organisationId, siteId], references: [organisationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([organisationId, evaluationId, entityId, siteId], map: "ComplianceEvaluationScope_scope_key")
  @@index([organisationId, evaluationId])
  @@index([organisationId, entityId])
  @@index([organisationId, siteId])
}

/// One ACTIVE `ComplianceObligationVersion`, pinned by id, evaluated once
/// within one evaluation cycle (spec §6: "evaluation, exact obligation
/// version, status, rationale, evaluator, evaluated time, evidence,
/// follow-up date"). `status` starts NOT_EVALUATED and is only ever written
/// by `recordComplianceEvaluationItemResult` while the parent evaluation is
/// IN_PROGRESS.
model ComplianceEvaluationItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  evaluationId String
  evaluation   ComplianceEvaluation @relation(fields: [organisationId, evaluationId], references: [organisationId, id], onDelete: Cascade)

  obligationVersionId String
  obligationVersion   ComplianceObligationVersion @relation(fields: [organisationId, obligationVersionId], references: [organisationId, id], onDelete: Restrict)

  status ComplianceEvaluationItemStatus @default(NOT_EVALUATED)

  rationale String?

  evaluatorMembershipId String?
  evaluator             OrganisationMembership? @relation("ComplianceEvaluationItemEvaluator", fields: [organisationId, evaluatorMembershipId], references: [organisationId, id], onDelete: Restrict)
  evaluatedAt           DateTime?

  followUpDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findingLinks ComplianceEvaluationFindingLink[]

  @@unique([organisationId, id])
  @@unique([organisationId, evaluationId, obligationVersionId], map: "ComplianceEvaluationItem_unique_per_evaluation")
  @@index([organisationId, evaluationId, status])
  @@index([organisationId, obligationVersionId])
}

/// Append-only record that an evaluator has requested a NONCOMPLIANT/
/// PARTIALLY_COMPLIANT item be linked to a nonconformity or corrective
/// action (spec §6 "item to NC/action interface"). This is the T63/T64
/// interface itself: it never creates, closes, or otherwise reaches into an
/// NC/CAPA record, because those models do not exist until Phase 6.
model ComplianceEvaluationFindingLink {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  evaluationItemId String
  evaluationItem   ComplianceEvaluationItem @relation(fields: [organisationId, evaluationItemId], references: [organisationId, id], onDelete: Cascade)

  linkType      ComplianceEvaluationFindingLinkType
  referenceNote String

  requestedByMembershipId String
  requestedBy             OrganisationMembership @relation("ComplianceEvaluationFindingLinkRequestedBy", fields: [organisationId, requestedByMembershipId], references: [organisationId, id], onDelete: Restrict)
  requestedAt             DateTime               @default(now())

  @@index([organisationId, evaluationItemId])
}

// ---------------------------------------------------------------------------
// Objectives and metric definitions (task T50, Docs/PHASE5_OBJECTIVES_ACTIONS_SPEC.md
// §§1-3). Depends on T23 (EMS programme), T31 (aspect/impact register) and
// T44 (compliance obligation versioning/approval).
//
// `EnvironmentalObjective` is the stable reference; `EnvironmentalObjectiveVersion`
// carries all content and follows the exact DRAFT -> IN_REVIEW ->
// APPROVED -> ACTIVE -> ACHIEVED/NOT_ACHIEVED/CANCELLED/SUPERSEDED state
// machine from spec §2, gated the same way T44 gates
// `ComplianceObligationVersion`: `ems.objective.manage` drafts/edits/submits,
// `ems.objective.approve` (Sustainability Lead default) is the only
// permission that can move a version out of IN_REVIEW or retire/close an
// ACTIVE one, and approval is denied to the version's own preparer whenever
// four-eyes is enabled (same interim decision T22/T23/T44 made). A version
// that has left DRAFT/IN_REVIEW is immutable at the database layer via the
// same trigger pattern as `controlled_document_revision_immutable` /
// `compliance_obligation_version_immutable_once_approved`; content changes
// only ever happen through a successor version linked by
// `supersedesVersionId`. Objective achievement is decided only through an
// explicit review transition on the version itself — no function in this
// module infers it from linked action completion (spec §1 "completing
// actions does not automatically mark an objective achieved" — enforced
// architecturally by T52's action model never writing to this table).
//
// `ObjectiveSourceLink` links a version to the policy, significant aspect,
// compliance obligation or risk/opportunity context it responds to — the
// four source types with an existing backing model today. Spec §3 also
// names a "management-review decision" source type; that link is not
// modelled yet because the management-review record (T70-73, Phase 7) does
// not exist in this codebase, mirroring how `EmsRiskOpportunity.sourceType`/
// `sourceId` already defers to phases not yet built. Adding it is an owner
// decision for whenever Phase 7 lands, not a T50 change.
//
// `ObjectiveMetricDefinition`/`ObjectiveMetricVersion` are deliberately
// separate from measurement values (spec §1 "a metric definition is
// versioned and separate from measurement values") — this task defines what
// a metric *is* (name, source type, unit, frequency, boundary, data-quality
// rules) and versions/approves that definition; resolving actual
// observations through the manual/corporate-carbon/product-LCA/monitoring
// adapters is T51, not built here.
// ---------------------------------------------------------------------------

enum EnvironmentalObjectiveVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  ACHIEVED
  NOT_ACHIEVED
  CANCELLED
  SUPERSEDED
}

enum ObjectiveApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
}

enum ObjectiveSourceLinkType {
  POLICY
  ASPECT_ASSESSMENT
  OBLIGATION_VERSION
  RISK_OPPORTUNITY
}

enum ObjectiveMetricSourceType {
  MANUAL
  CORPORATE_CARBON
  PRODUCT_LCA
  MONITORING
  DERIVED_APPROVED_FORMULA
}

enum ObjectiveMetricVersionStatus {
  DRAFT
  APPROVED
  ACTIVE
  SUPERSEDED
}

/// Stable reference to one environmental objective. Never carries objective
/// content itself — only the pointer to whichever `EnvironmentalObjectiveVersion`
/// is currently ACTIVE, the same single-write-site shape as
/// `ComplianceObligation.activeVersionId`.
model EnvironmentalObjective {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  activeVersionId String?                        @unique
  activeVersion   EnvironmentalObjectiveVersion? @relation("EnvironmentalObjectiveActiveVersion", fields: [organisationId, activeVersionId], references: [organisationId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions          EnvironmentalObjectiveVersion[] @relation("EnvironmentalObjectiveVersions")
  metricDefinitions ObjectiveMetricDefinition[]
  actionProgrammes  ActionProgramme[]

  @@unique([organisationId, id])
  @@unique([organisationId, activeVersionId])
  @@index([organisationId])
}

/// One version of one environmental objective's content — owner, target,
/// unit, baseline description/date, target date and evaluation method are
/// all required (T50 acceptance), plus revision rationale on a successor.
model EnvironmentalObjectiveVersion {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  objectiveId String
  objective   EnvironmentalObjective @relation("EnvironmentalObjectiveVersions", fields: [organisationId, objectiveId], references: [organisationId, id])
  version     Int

  title  String
  intent String

  ownerMembershipId String
  owner             OrganisationMembership @relation("EnvironmentalObjectiveVersionOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)

  baselineDescription String
  baselineDate        DateTime?

  // Exactly one of targetValue/targetQualitative is set — a numeric target
  // (with unit) or a qualitative target description.
  targetValue       Decimal? @db.Decimal(24, 10)
  targetQualitative String?
  unit              String?
  targetDate        DateTime

  evaluationMethod String

  status EnvironmentalObjectiveVersionStatus @default(DRAFT)

  preparedByUserId String
  preparedAt       DateTime @default(now())

  // Denormalised for fast reads — the authoritative decision history lives
  // in `ObjectiveApproval` (append-only, includes REJECTED/RETURNED
  // decisions this pair of columns cannot represent).
  approvedByUserId String?
  approvedAt       DateTime?

  // Set only on the transition into ACHIEVED/NOT_ACHIEVED — the objective
  // review, not action completion, decides this (spec §2).
  achievementDecidedByUserId String?
  achievementDecidedAt       DateTime?
  achievementRationale       String?

  revisionRationale String?

  supersedesVersionId String?
  supersedesVersion   EnvironmentalObjectiveVersion? @relation("EnvironmentalObjectiveVersionSuccessor", fields: [organisationId, supersedesVersionId], references: [organisationId, id])
  successorVersion    EnvironmentalObjectiveVersion? @relation("EnvironmentalObjectiveVersionSuccessor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activeForObjective EnvironmentalObjective? @relation("EnvironmentalObjectiveActiveVersion")

  sourceLinks ObjectiveSourceLink[]
  approvals   ObjectiveApproval[]

  @@unique([organisationId, id])
  @@unique([organisationId, objectiveId, version])
  @@unique([organisationId, supersedesVersionId])
  @@index([organisationId, objectiveId, status])
  @@index([organisationId, status])
  @@index([organisationId, ownerMembershipId])
}

/// Links an objective version to the policy, significant aspect, compliance
/// obligation or risk/opportunity it responds to (spec §3). Exactly one of
/// the four target columns is set per row; links do not determine priority
/// automatically (spec §1).
model ObjectiveSourceLink {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  objectiveVersionId String
  objectiveVersion   EnvironmentalObjectiveVersion @relation(fields: [organisationId, objectiveVersionId], references: [organisationId, id], onDelete: Cascade)

  linkType ObjectiveSourceLinkType

  policyRecordId String?
  policyRecord   EnvironmentalPolicyRecord? @relation(fields: [organisationId, policyRecordId], references: [organisationId, id], onDelete: Restrict)

  aspectAssessmentId String?
  aspectAssessment   AspectAssessment? @relation(fields: [organisationId, aspectAssessmentId], references: [organisationId, id], onDelete: Restrict)

  obligationVersionId String?
  obligationVersion   ComplianceObligationVersion? @relation(fields: [organisationId, obligationVersionId], references: [organisationId, id], onDelete: Restrict)

  riskOpportunityId String?
  riskOpportunity   EmsRiskOpportunity? @relation(fields: [organisationId, riskOpportunityId], references: [organisationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([organisationId, objectiveVersionId, linkType, policyRecordId, aspectAssessmentId, obligationVersionId, riskOpportunityId], map: "ObjectiveSourceLink_link_key")
  @@index([organisationId, objectiveVersionId])
  @@index([organisationId, policyRecordId])
  @@index([organisationId, aspectAssessmentId])
  @@index([organisationId, obligationVersionId])
  @@index([organisationId, riskOpportunityId])
}

/// Append-only exact-version approval decision — the same shape and rules
/// as `ComplianceObligationApproval`. Never updated or deleted.
model ObjectiveApproval {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  objectiveVersionId String
  objectiveVersion   EnvironmentalObjectiveVersion @relation(fields: [organisationId, objectiveVersionId], references: [organisationId, id], onDelete: Cascade)

  decision       ObjectiveApprovalDecision
  permissionCode String
  comment        String?

  approverMembershipId String
  approver             OrganisationMembership @relation("ObjectiveApprovalApprover", fields: [organisationId, approverMembershipId], references: [organisationId, id], onDelete: Restrict)
  decidedAt            DateTime               @default(now())

  @@index([organisationId, objectiveVersionId])
  @@index([organisationId, approverMembershipId])
}

/// Stable reference to one metric definition, owned by one objective.
/// Never carries metric content itself — only the pointer to whichever
/// `ObjectiveMetricVersion` is currently ACTIVE.
model ObjectiveMetricDefinition {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  objectiveId String
  objective   EnvironmentalObjective @relation(fields: [organisationId, objectiveId], references: [organisationId, id], onDelete: Restrict)

  activeVersionId String?                 @unique
  activeVersion   ObjectiveMetricVersion? @relation("ObjectiveMetricDefinitionActiveVersion", fields: [organisationId, activeVersionId], references: [organisationId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ObjectiveMetricVersion[] @relation("ObjectiveMetricDefinitionVersions")

  @@unique([organisationId, id])
  @@unique([organisationId, activeVersionId])
  @@index([organisationId, objectiveId])
}

/// One version of one metric definition's content (spec §1 "a metric
/// definition is versioned and separate from measurement values"). No
/// `ObjectiveMeasurement` model is added here — resolving observations
/// through the manual/corporate-carbon/product-LCA/monitoring adapters is
/// T51.
model ObjectiveMetricVersion {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  metricDefinitionId String
  metricDefinition   ObjectiveMetricDefinition @relation("ObjectiveMetricDefinitionVersions", fields: [organisationId, metricDefinitionId], references: [organisationId, id])
  version            Int

  name       String
  sourceType ObjectiveMetricSourceType

  aggregationConfig   Json?
  unit                String
  frequency           String
  boundaryDescription String?
  dataQualityRules    Json?

  status ObjectiveMetricVersionStatus @default(DRAFT)

  preparedByUserId String
  preparedAt       DateTime  @default(now())
  approvedByUserId String?
  approvedAt       DateTime?

  supersedesVersionId String?
  supersedesVersion   ObjectiveMetricVersion? @relation("ObjectiveMetricVersionSuccessor", fields: [organisationId, supersedesVersionId], references: [organisationId, id])
  successorVersion    ObjectiveMetricVersion? @relation("ObjectiveMetricVersionSuccessor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activeForDefinition ObjectiveMetricDefinition? @relation("ObjectiveMetricDefinitionActiveVersion")

  @@unique([organisationId, id])
  @@unique([organisationId, metricDefinitionId, version])
  @@unique([organisationId, supersedesVersionId])
  @@index([organisationId, metricDefinitionId, status])
  @@index([organisationId, status])
}

// ---------------------------------------------------------------------------
// Action programmes and reminders (task T52,
// Docs/PHASE5_OBJECTIVES_ACTIONS_SPEC.md §§1-3). Depends on T50 (objectives)
// and T24 (notifications/reminders, both already on this branch).
//
// `ActionProgramme` optionally links to an `EnvironmentalObjective` — a
// programme need not support an objective (spec §3 "programme/source ...
// links"; NC/review source links are deferred the same way
// `ObjectiveSourceLink`'s management-review link is, because those models
// don't exist yet in this codebase).
//
// `ActionItem` follows the exact state machine from spec §2: OPEN ->
// IN_PROGRESS -> BLOCKED -> COMPLETED -> VERIFIED / REOPENED / CANCELLED.
// COMPLETED/VERIFIED/CANCELLED are the "closed" statuses the T52 acceptance
// criterion means by "closed action immutable except reopen event": the
// `action_item_immutable_once_closed` trigger below makes every content
// column read-only once an item reaches one of those three statuses, and
// allows exactly one further transition out of that state — into REOPENED,
// which is not itself closed, so an item explicitly reopened behaves like a
// normal in-flight action again (spec's own diagram treats REOPENED as a
// sibling of VERIFIED/CANCELLED reachable from COMPLETED, not a pass-through
// state). Completing an action never touches `EnvironmentalObjective`/
// `EnvironmentalObjectiveVersion` — the objective review, not action
// completion, decides achievement (spec §1, enforced architecturally: this
// module never imports the objective-service write path).
//
// `ActionStatusHistory` is the append-only audit trail the acceptance
// criterion "reassignment/history audited" asks for, in the same shape as
// `ObjectiveApproval`: never updated or deleted, one row per status change,
// reassignment or reopen event.
// ---------------------------------------------------------------------------

enum ActionProgrammeStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  VERIFIED
  REOPENED
  CANCELLED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatusHistoryEventType {
  STATUS_CHANGE
  REASSIGNED
  REOPENED
}

/// One organisation's action programme — a container of related `ActionItem`
/// rows, optionally supporting one environmental objective.
model ActionProgramme {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  objectiveId String?
  objective   EnvironmentalObjective? @relation(fields: [organisationId, objectiveId], references: [organisationId, id], onDelete: Restrict)

  title                String
  resourcesDescription String?

  ownerMembershipId String
  owner             OrganisationMembership @relation("ActionProgrammeOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)

  startDate  DateTime?
  targetDate DateTime?

  status ActionProgrammeStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions ActionItem[]

  @@unique([organisationId, id])
  @@index([organisationId, objectiveId])
  @@index([organisationId, status])
  @@index([organisationId, ownerMembershipId])
}

/// One action within a programme. `completionCriteria` is set on creation;
/// `completedAt`/`completedByUserId` and `verifiedAt`/`verifiedByUserId` are
/// only ever set by the corresponding explicit transition (spec §5:
/// "verification follows configured permission/separation" — enforced in
/// the service layer as the same four-eyes rule T50/T44 use, verifier !=
/// completor).
model ActionItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  programmeId String
  programme   ActionProgramme @relation(fields: [organisationId, programmeId], references: [organisationId, id], onDelete: Restrict)

  title       String
  description String?
  priority    ActionPriority @default(MEDIUM)

  ownerMembershipId String
  owner             OrganisationMembership @relation("ActionItemOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)

  startDate DateTime?
  dueDate   DateTime

  completionCriteria String?

  status ActionItemStatus @default(OPEN)

  completedAt            DateTime?
  completedByUserId      String?
  completionEvidenceNote String?

  verifiedAt       DateTime?
  verifiedByUserId String?

  reopenedAt       DateTime?
  reopenedByUserId String?
  reopenReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dependenciesOn  ActionDependency[]     @relation("ActionDependencyItem")
  dependedOnBy    ActionDependency[]     @relation("ActionDependencyDependsOn")
  progressUpdates ActionProgressUpdate[]
  statusHistory   ActionStatusHistory[]

  @@unique([organisationId, id])
  @@index([organisationId, programmeId])
  @@index([organisationId, status])
  @@index([organisationId, ownerMembershipId])
  @@index([organisationId, dueDate])
}

/// `actionItemId` cannot proceed/complete until `dependsOnActionItemId` is
/// COMPLETED/VERIFIED — enforced in the service layer, not by this table
/// alone.
model ActionDependency {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  actionItemId String
  actionItem   ActionItem @relation("ActionDependencyItem", fields: [organisationId, actionItemId], references: [organisationId, id], onDelete: Cascade)

  dependsOnActionItemId String
  dependsOnActionItem   ActionItem @relation("ActionDependencyDependsOn", fields: [organisationId, dependsOnActionItemId], references: [organisationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([organisationId, actionItemId, dependsOnActionItemId])
  @@index([organisationId, actionItemId])
  @@index([organisationId, dependsOnActionItemId])
}

/// Append-only progress notes on an action — never updated or deleted.
model ActionProgressUpdate {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  actionItemId String
  actionItem   ActionItem @relation(fields: [organisationId, actionItemId], references: [organisationId, id], onDelete: Cascade)

  progressPercent Int?
  note            String

  recordedByUserId String
  recordedAt       DateTime @default(now())

  @@index([organisationId, actionItemId])
}

/// Append-only status/reassignment/reopen history — never updated or
/// deleted. `previousOwnerMembershipId`/`newOwnerMembershipId` are only set
/// on a REASSIGNED row; `fromStatus`/`toStatus` are only set on
/// STATUS_CHANGE/REOPENED rows.
model ActionStatusHistory {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  actionItemId String
  actionItem   ActionItem @relation(fields: [organisationId, actionItemId], references: [organisationId, id], onDelete: Cascade)

  eventType ActionStatusHistoryEventType

  fromStatus ActionItemStatus?
  toStatus   ActionItemStatus?

  previousOwnerMembershipId String?
  newOwnerMembershipId      String?

  note String?

  actorUserId String
  occurredAt  DateTime @default(now())

  @@index([organisationId, actionItemId])
}

// ---------------------------------------------------------------------------
// Audit programme and audit execution (task T60, Docs/PHASE6_AUDIT_INCIDENT_CAPA_SPEC.md
// §§1-3,7). Depends on T23 (EMS programme), T22 (controlled documents/evidence)
// and T24 (notifications/reminders). Scope is deliberately the programme,
// scheduling and independence shell only — checklist versioning, question
// responses, findings and the frozen issued report belong to T61
// (`EmsAudit.status` therefore only ever reaches IN_PROGRESS here;
// REPORT_DRAFT/REPORT_ISSUED/CLOSED are reserved enum values T61 will drive).
//
// `EmsAudit` is a planned management-system audit, distinct from the
// `AuditEvent` platform change-history table (T20) — see spec §1 "names and
// modules must prevent confusion".
//
// `AuditProgrammeItemScope`/`EmsAuditScope` follow the exact
// `ApplicabilityAssessmentScope` shape (entity/site/process/aspect), extended
// with obligation/requirement-map so a programme's coverage can be reported
// "by Site/process/aspect/obligation/internal requirement" (spec §3) without
// a second, incompatible scope shape in the same phase. Exactly one column
// is set per row — enforced in the service layer, the same way
// `ComplianceEvaluationScope`/`ApplicabilityAssessmentScope` enforce it.
//
// Independence is represented on `AuditTeamMember`, not assumed from role
// name (spec §1): `independenceDeclared`/`conflictDeclared` must be set
// explicitly by `assignAuditTeamMember`, never defaulted true, and a
// declared conflict blocks a LEAD_AUDITOR/AUDITOR assignment in the service
// layer (spec §8 "independence conflict blocks assignment ... when policy
// requires it").
// ---------------------------------------------------------------------------

enum AuditProgrammeStatus {
  DRAFT
  APPROVED
  ACTIVE
  COMPLETED
  SUPERSEDED
}

enum EmsAuditType {
  INTERNAL
  SUPPLIER
  COMPLIANCE
  SYSTEM
  PROCESS
  OTHER
}

/// Full state machine per spec §2. T60 only ever drives PLANNED -> PREPARATION
/// -> IN_PROGRESS; later values are reserved for T61.
enum EmsAuditStatus {
  PLANNED
  PREPARATION
  IN_PROGRESS
  REPORT_DRAFT
  REPORT_ISSUED
  CLOSED
}

enum AuditTeamRole {
  LEAD_AUDITOR
  AUDITOR
  TECHNICAL_EXPERT
  OBSERVER
}

enum AuditItemPriority {
  LOW
  MEDIUM
  HIGH
}

/// A standing, risk-based programme of internal audits (spec §3
/// "organisation/programme, period, objectives, risk basis, scope, coverage
/// targets, owner, approval/status/version"). `AuditProgrammeItem` rows are
/// the individual planned audits under it; the programme itself carries no
/// audit content of its own.
model AuditProgramme {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name        String
  description String?
  objectives  String?

  // Free-text rationale for why this programme prioritises what it does
  // (spec §3 "risk basis") — deliberately not a structured risk model,
  // matching how `ComplianceEvaluationProgramme.recurrence` stays a plain
  // string rather than inventing a scheduling engine this phase doesn't need.
  riskBasis String

  periodStart DateTime
  periodEnd   DateTime

  ownerMembershipId String
  owner             OrganisationMembership @relation("AuditProgrammeOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)

  status  AuditProgrammeStatus @default(DRAFT)
  version Int                  @default(1)

  // Revision chain (never mutate approved content in place) — same shape as
  // `EmsScopeVersion.supersedesVersionId`.
  supersedesProgrammeId String?
  supersedesProgramme   AuditProgramme?  @relation("AuditProgrammeSuccessor", fields: [organisationId, supersedesProgrammeId], references: [organisationId, id], onDelete: Restrict)
  supersededBy          AuditProgramme[] @relation("AuditProgrammeSuccessor")

  approvedAt       DateTime?
  approvedByUserId String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items  AuditProgrammeItem[]
  audits EmsAudit[]

  @@unique([organisationId, id])
  @@index([organisationId, status])
}

/// One planned audit slot under a programme (spec §3 "planned audit,
/// sites/processes/aspects/obligations/standard-map scope, timing,
/// priority/rationale"). `EmsAudit.programmeItemId` links the audit actually
/// created from this slot; a slot may exist with no audit created yet.
model AuditProgrammeItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  programmeId String
  programme   AuditProgramme @relation(fields: [organisationId, programmeId], references: [organisationId, id], onDelete: Cascade)

  title     String
  rationale String?
  priority  AuditItemPriority @default(MEDIUM)

  plannedStart DateTime
  plannedEnd   DateTime

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scopes AuditProgrammeItemScope[]
  audits EmsAudit[]

  @@unique([organisationId, id])
  @@index([organisationId, programmeId])
}

/// Coverage-dimension row for one `AuditProgrammeItem` — exactly one of
/// entity/site/process/aspect/obligation/requirementMap is set per row
/// (service-enforced, same convention as `ApplicabilityAssessmentScope`).
model AuditProgrammeItemScope {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  itemId String
  item   AuditProgrammeItem @relation(fields: [organisationId, itemId], references: [organisationId, id], onDelete: Cascade)

  entityId String?
  entity   Entity? @relation(fields: [organisationId, entityId], references: [organisationId, id], onDelete: Restrict)
  siteId   String?
  site     Site?   @relation(fields: [organisationId, siteId], references: [organisationId, id], onDelete: Restrict)

  processId String?
  process   ActivityProcess?     @relation(fields: [organisationId, processId], references: [organisationId, id], onDelete: Restrict)
  aspectId  String?
  aspect    EnvironmentalAspect? @relation(fields: [organisationId, aspectId], references: [organisationId, id], onDelete: Restrict)

  obligationId     String?
  obligation       ComplianceObligation?   @relation(fields: [organisationId, obligationId], references: [organisationId, id], onDelete: Restrict)
  requirementMapId String?
  requirementMap   StandardRequirementMap? @relation(fields: [organisationId, requirementMapId], references: [organisationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([organisationId, itemId, entityId, siteId, processId, aspectId, obligationId, requirementMapId], map: "AuditProgrammeItemScope_scope_key")
  @@index([organisationId, itemId])
  @@index([organisationId, entityId])
  @@index([organisationId, siteId])
  @@index([organisationId, processId])
  @@index([organisationId, aspectId])
  @@index([organisationId, obligationId])
  @@index([organisationId, requirementMapId])
}

/// One planned management-system audit (spec §3). Distinct from the
/// `AuditEvent` system change-history table — see module note above.
/// `criteriaReferences` pins the exact controlled-document-revision/standard
/// references the audit is run against (spec §1 "audit programmes and
/// reports pin exact criteria/checklist/source versions") — a plain JSON
/// list of `{ resourceType, resourceId }` pairs since T60 has no checklist
/// model of its own yet to pin against (that arrives with T61).
model EmsAudit {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  programmeId String
  programme   AuditProgramme @relation(fields: [organisationId, programmeId], references: [organisationId, id], onDelete: Restrict)

  programmeItemId String?
  programmeItem   AuditProgrammeItem? @relation(fields: [organisationId, programmeItemId], references: [organisationId, id], onDelete: Restrict)

  type EmsAuditType

  title              String
  objectives         String?
  criteriaSummary    String
  criteriaReferences Json?

  leadMembershipId String
  lead             OrganisationMembership @relation("EmsAuditLead", fields: [organisationId, leadMembershipId], references: [organisationId, id], onDelete: Restrict)

  scheduledStart DateTime
  scheduledEnd   DateTime

  status EmsAuditStatus @default(PLANNED)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scopes EmsAuditScope[]
  team   AuditTeamMember[]

  // Checklists, evidence, findings and frozen report (T61).
  checklistVersions AuditChecklistVersion[]
  questionResponses AuditQuestionResponse[]
  findings          AuditFinding[]
  reportRevision    AuditReportRevision?
  coverageSnapshot  AuditCoverageSnapshot?

  @@unique([organisationId, id])
  @@index([organisationId, programmeId, status])
  @@index([organisationId, status])
  @@index([organisationId, programmeItemId])
}

/// Coverage-dimension row for one `EmsAudit` — same shape/convention as
/// `AuditProgrammeItemScope`.
model EmsAuditScope {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  auditId String
  audit   EmsAudit @relation(fields: [organisationId, auditId], references: [organisationId, id], onDelete: Cascade)

  entityId String?
  entity   Entity? @relation(fields: [organisationId, entityId], references: [organisationId, id], onDelete: Restrict)
  siteId   String?
  site     Site?   @relation(fields: [organisationId, siteId], references: [organisationId, id], onDelete: Restrict)

  processId String?
  process   ActivityProcess?     @relation(fields: [organisationId, processId], references: [organisationId, id], onDelete: Restrict)
  aspectId  String?
  aspect    EnvironmentalAspect? @relation(fields: [organisationId, aspectId], references: [organisationId, id], onDelete: Restrict)

  obligationId     String?
  obligation       ComplianceObligation?   @relation(fields: [organisationId, obligationId], references: [organisationId, id], onDelete: Restrict)
  requirementMapId String?
  requirementMap   StandardRequirementMap? @relation(fields: [organisationId, requirementMapId], references: [organisationId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([organisationId, auditId, entityId, siteId, processId, aspectId, obligationId, requirementMapId], map: "EmsAuditScope_scope_key")
  @@index([organisationId, auditId])
  @@index([organisationId, entityId])
  @@index([organisationId, siteId])
  @@index([organisationId, processId])
  @@index([organisationId, aspectId])
  @@index([organisationId, obligationId])
  @@index([organisationId, requirementMapId])
}

/// One person's membership of one audit's team (spec §3). Independence is
/// represented explicitly here, not assumed from `role` — see module note.
model AuditTeamMember {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  auditId String
  audit   EmsAudit @relation(fields: [organisationId, auditId], references: [organisationId, id], onDelete: Cascade)

  membershipId String
  membership   OrganisationMembership @relation("AuditTeamMembership", fields: [organisationId, membershipId], references: [organisationId, id], onDelete: Restrict)

  role AuditTeamRole

  independenceDeclared Boolean   @default(false)
  conflictDeclared     Boolean   @default(false)
  conflictNotes        String?
  declaredAt           DateTime?

  addedByUserId String
  createdAt     DateTime @default(now())

  @@unique([organisationId, auditId, membershipId])
  @@index([organisationId, auditId])
  @@index([organisationId, membershipId])
}

// ---------------------------------------------------------------------------
// Checklists, evidence, findings and frozen report (task T61,
// Docs/PHASE6_AUDIT_INCIDENT_CAPA_SPEC.md §§1-3,6-7). Depends on T60
// (`EmsAudit`/`AuditTeamMember`/independence) and reuses the T22 evidence
// model (`EvidenceObject`/`EvidenceLink`, resource types
// `audit_question_response`/`audit_finding`) rather than a second evidence
// table — see `src/lib/documents/evidence-service.ts`.
//
// `AuditChecklistVersion` is mutable only while `status = DRAFT`; freezing
// (`frozenAt` set, `status -> FROZEN`) happens no later than the audit
// leaving PREPARATION for IN_PROGRESS (`startAuditExecution` in
// `audit-service.ts` calls the freeze helper in `checklist-service.ts` in
// the same transaction) so the plan the auditors execute against cannot
// change once the audit starts (spec: "checklist version frozen at audit
// start"). `AuditQuestionResponse` rows stay editable through IN_PROGRESS/
// REPORT_DRAFT and are copied into `AuditReportRevision.frozenPayload` —
// itself immutable once `status -> ISSUED` — when the report is issued
// (spec: "... or issue"; acceptance: "issued report immutable").
//
// `AuditFinding.classification` is a stable, generic, non-certification-body
// category (spec §3 "Do not hard-code certification-body classifications")
// set explicitly by whoever records the finding — the system never infers
// or defaults it, so a finding can never carry an automatic certification
// judgement.
// ---------------------------------------------------------------------------

enum AuditChecklistStatus {
  DRAFT
  FROZEN
}

enum AuditQuestionResult {
  NOT_ASSESSED
  CONFORMS
  NONCONFORMANCE
  NOT_APPLICABLE
}

/// Generic, stable finding categories — never a certification-body-specific
/// label (spec §3). An organisation may display its own wording for these in
/// the UI; the stored code never changes.
enum AuditFindingClassification {
  OBSERVATION
  OPPORTUNITY_FOR_IMPROVEMENT
  MINOR_NONCONFORMITY
  MAJOR_NONCONFORMITY
}

/// Full state machine per spec §2.
enum AuditFindingStatus {
  DRAFT
  CONFIRMED
  ACTION_REQUIRED
  ACCEPTED_OBSERVATION
  CLOSED
}

enum AuditReportStatus {
  DRAFT
  ISSUED
}

/// One version of an audit's checklist (spec §3 "audit, version, frozen
/// questions/criteria/expected evidence"). Only the latest version may be
/// DRAFT (edited); once FROZEN it, and its items, never change again —
/// `checklist-service.ts` enforces both rules, never the database.
model AuditChecklistVersion {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  auditId String
  audit   EmsAudit @relation(fields: [organisationId, auditId], references: [organisationId, id], onDelete: Cascade)

  version Int
  status  AuditChecklistStatus @default(DRAFT)

  frozenAt       DateTime?
  frozenByUserId String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items AuditChecklistItem[]

  @@unique([organisationId, id])
  @@unique([organisationId, auditId, version])
  @@index([organisationId, auditId])
}

/// One checklist question (spec §3). Immutable once its parent version is
/// FROZEN — enforced in `checklist-service.ts`.
model AuditChecklistItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  checklistVersionId String
  checklistVersion   AuditChecklistVersion @relation(fields: [organisationId, checklistVersionId], references: [organisationId, id], onDelete: Cascade)

  sortOrder         Int
  question          String
  criteriaReference String?
  expectedEvidence  String?

  createdAt DateTime @default(now())

  response AuditQuestionResponse?

  @@unique([organisationId, id])
  @@unique([organisationId, checklistVersionId, sortOrder])
  @@index([organisationId, checklistVersionId])
}

/// The auditor's recorded answer to one frozen checklist item (spec §3
/// "checklist item, result, notes, evidence, auditor/time"). One response
/// per item — `checklist-service.ts` upserts in place rather than
/// versioning responses, and blocks further changes once the audit's report
/// is issued (`AuditReportRevision.status = ISSUED`).
model AuditQuestionResponse {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  checklistItemId String
  checklistItem   AuditChecklistItem @relation(fields: [organisationId, checklistItemId], references: [organisationId, id], onDelete: Cascade)

  // Denormalised for tenant-scoped queries/indexing without a join through
  // AuditChecklistItem -> AuditChecklistVersion on every read.
  auditId String
  audit   EmsAudit @relation(fields: [organisationId, auditId], references: [organisationId, id], onDelete: Cascade)

  result AuditQuestionResult @default(NOT_ASSESSED)
  notes  String?

  auditorMembershipId String?
  auditor             OrganisationMembership? @relation(fields: [organisationId, auditorMembershipId], references: [organisationId, id], onDelete: Restrict)
  respondedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, checklistItemId])
  @@index([organisationId, auditId])
}

/// One audit finding (spec §3 "audit, type/configured classification,
/// statement, objective evidence, criterion/requirement reference, scope,
/// owner, due date, confirmation metadata"). `scopeRef` pins the exact
/// resource the finding concerns (same `{ resourceType, resourceId }` shape
/// as `EmsAudit.criteriaReferences`) rather than a second six-column scope
/// table — a finding concerns exactly one thing, unlike an audit's coverage.
model AuditFinding {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  auditId String
  audit   EmsAudit @relation(fields: [organisationId, auditId], references: [organisationId, id], onDelete: Cascade)

  questionResponseId String?

  classification AuditFindingClassification
  status         AuditFindingStatus         @default(DRAFT)

  statement          String
  objectiveEvidence  String?
  criterionReference String?
  scopeRef           Json?

  ownerMembershipId String?
  owner             OrganisationMembership? @relation(fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)
  dueDate           DateTime?

  confirmedAt       DateTime?
  confirmedByUserId String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organisationId, id])
  @@index([organisationId, auditId, status])
}

/// The frozen, issued audit report (spec §3 "audit, draft/issued number,
/// frozen payload/storage/checksum, preparer/reviewer/issuer, issued time").
/// One row per audit (T61 does not model report corrections/reissue — a
/// later phase's concern); `status -> ISSUED` is a one-way, one-time
/// transition set only by `report-service.ts#issueAuditReport`, after which
/// no field on this row is ever written again (acceptance: "issued report
/// immutable").
model AuditReportRevision {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  auditId String
  audit   EmsAudit @relation(fields: [organisationId, auditId], references: [organisationId, id], onDelete: Restrict)

  revisionNumber Int               @default(1)
  status         AuditReportStatus @default(DRAFT)

  preparerUserId String
  reviewerUserId String?
  issuerUserId   String?
  issuedAt       DateTime?

  // Populated only at issue: a full snapshot of the frozen checklist,
  // responses and findings this report was issued against, plus its
  // checksum — never re-derived from live data after issue.
  frozenPayload  Json?
  checksumSha256 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverageSnapshot AuditCoverageSnapshot?

  @@unique([organisationId, id])
  @@unique([organisationId, auditId])
}

/// Frozen coverage-by-dimension snapshot taken at report issue (spec §3) —
/// the point-in-time counterpart to `programme-service.ts`'s live coverage
/// report, scoped to this one audit's own `EmsAuditScope` rows.
model AuditCoverageSnapshot {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  auditId String
  audit   EmsAudit @relation(fields: [organisationId, auditId], references: [organisationId, id], onDelete: Restrict)

  reportRevisionId String
  reportRevision   AuditReportRevision @relation(fields: [organisationId, reportRevisionId], references: [organisationId, id], onDelete: Restrict)

  payload Json

  createdAt DateTime @default(now())

  @@unique([organisationId, id])
  @@unique([organisationId, auditId])
  @@unique([organisationId, reportRevisionId])
}

// ---------------------------------------------------------------------------
// Environmental incident intake (task T62, Docs/PHASE6_AUDIT_INCIDENT_CAPA_SPEC.md
// §§1-3,5-9). Depends on T22 (`EvidenceObject`/`EvidenceLink`, resource type
// `environmental_incident` added to `EVIDENCE_LINK_RESOURCE_TYPES`) and T23
// (Organisation/EMS tenant foundation) — see `src/lib/ems/incidents/incident-service.ts`.
//
// `IncidentSeverityLevel`/`IncidentEscalationRule` are the organisation's own
// configurable severity/escalation policy (spec acceptance: "escalation
// rules configurable") — same recipients-policy convention as
// `ReminderRule.recipientsPolicy` (T24). `EnvironmentalIncident.severityConfigSnapshot`
// freezes the exact severity-level row in effect when severity was assigned,
// so a later edit to the config never rewrites a past incident's record.
//
// `EnvironmentalIncident`'s own factual fields (`factualDescription`/
// `immediateResponse`/`potentialReceptors`) are set once at creation and
// never overwritten — `IncidentCorrection` is the only way to record a
// changed understanding of the facts, and it always keeps the original
// (spec acceptance: "preserves original report and corrections").
//
// `IncidentNotificationAssessment.decision` is entered only by a human
// reviewer through `notification-assessment-service.ts`; nothing in this
// schema or the service layer defaults or infers it, which is what makes
// "no automatic legal-reportability conclusion" true at the data level
// (spec acceptance).
// ---------------------------------------------------------------------------

enum EnvironmentalIncidentStatus {
  REPORTED
  TRIAGED
  INVESTIGATING
  RESPONSE_COMPLETE
  CLOSED
  REOPENED
}

enum IncidentNotificationDecision {
  NOT_REQUIRED
  REQUIRED
  UNCERTAIN
}

/// Organisation-configurable incident severity levels (spec §4 "severity
/// config snapshot"). `rank` orders levels low -> high for display; a level
/// is never deleted once referenced by an incident, only deactivated
/// (`isActive = false`) — `incident-service.ts` enforces this.
model IncidentSeverityLevel {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  key                String
  label              String
  rank               Int
  requiresEscalation Boolean @default(false)
  isActive           Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  escalationRule IncidentEscalationRule?
  incidents      EnvironmentalIncident[]

  @@unique([organisationId, id])
  @@unique([organisationId, key])
  @@index([organisationId, isActive])
}

/// Configurable escalation rule for one severity level (spec acceptance:
/// "escalation rules configurable"). `recipientsPolicy` is resolved against
/// live membership state at evaluation time, never a stored membership id
/// list — same convention as `ReminderRule.recipientsPolicy` (T24).
model IncidentEscalationRule {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  severityLevelId String
  severityLevel   IncidentSeverityLevel @relation(fields: [organisationId, severityLevelId], references: [organisationId, id], onDelete: Cascade)

  recipientsPolicy Json
  isActive         Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organisationId, id])
  @@unique([organisationId, severityLevelId])
  @@index([organisationId, isActive])
}

/// One reported environmental incident (spec §4). State machine per spec §2:
///   REPORTED -> TRIAGED -> INVESTIGATING -> RESPONSE_COMPLETE -> CLOSED / REOPENED
/// `restricted` gates list/search/aggregate visibility to
/// `ems.incident.restricted.view` in the service layer (spec §5); the
/// reporter may always read their own report regardless.
model EnvironmentalIncident {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  reference String

  reportedAt   DateTime  @default(now())
  occurredAt   DateTime?
  discoveredAt DateTime?

  entityId  String?
  entity    Entity?              @relation(fields: [organisationId, entityId], references: [organisationId, id], onDelete: Restrict)
  siteId    String?
  site      Site?                @relation(fields: [organisationId, siteId], references: [organisationId, id], onDelete: Restrict)
  processId String?
  process   ActivityProcess?     @relation(fields: [organisationId, processId], references: [organisationId, id], onDelete: Restrict)
  aspectId  String?
  aspect    EnvironmentalAspect? @relation(fields: [organisationId, aspectId], references: [organisationId, id], onDelete: Restrict)

  type String

  // Original report — set once at creation, never overwritten. See
  // IncidentCorrection for how a changed understanding of the facts is
  // recorded without losing this.
  factualDescription String
  immediateResponse  String?
  potentialReceptors String?

  severityLevelId        String?
  severityLevel          IncidentSeverityLevel? @relation(fields: [organisationId, severityLevelId], references: [organisationId, id], onDelete: Restrict)
  severityConfigSnapshot Json?

  status     EnvironmentalIncidentStatus @default(REPORTED)
  restricted Boolean                     @default(false)

  reporterMembershipId String
  reporter             OrganisationMembership @relation("EnvironmentalIncidentReporter", fields: [organisationId, reporterMembershipId], references: [organisationId, id], onDelete: Restrict)
  reporterUserId       String

  closedAt         DateTime?
  closedByUserId   String?
  reopenedAt       DateTime?
  reopenedByUserId String?
  reopenReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corrections             IncidentCorrection[]
  notificationAssessments IncidentNotificationAssessment[]

  @@unique([organisationId, id])
  @@unique([organisationId, reference])
  @@index([organisationId, status])
  @@index([organisationId, restricted])
  @@index([organisationId, entityId])
  @@index([organisationId, siteId])
  @@index([organisationId, processId])
  @@index([organisationId, aspectId])
  @@index([organisationId, severityLevelId])
}

/// Append-only correction to an incident's factual record (spec §4
/// "append-only correction to factual record with reason; original
/// retained"). The incident's own factual fields never change after
/// creation — the current view is the latest correction here, if any, else
/// the original incident fields; `incident-service.ts#getEnvironmentalIncident`
/// computes this rather than the schema.
model IncidentCorrection {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  incidentId String
  incident   EnvironmentalIncident @relation(fields: [organisationId, incidentId], references: [organisationId, id], onDelete: Cascade)

  correctedFactualDescription String?
  correctedImmediateResponse  String?
  correctedPotentialReceptors String?
  reason                      String

  correctedByUserId String
  correctedAt       DateTime @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, incidentId])
}

/// A competent reviewer's notification/reportability assessment (spec §4
/// "authority/party, due trigger, decision, competent reviewer,
/// rationale/evidence/time. Never automatic legal advice."). `decision` is
/// always set explicitly by `reviewerMembershipId` through
/// `notification-assessment-service.ts` — nothing here or in the service
/// infers or defaults it (spec acceptance: "no automatic legal-reportability
/// conclusion").
model IncidentNotificationAssessment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  incidentId String
  incident   EnvironmentalIncident @relation(fields: [organisationId, incidentId], references: [organisationId, id], onDelete: Cascade)

  authorityOrParty String
  dueTrigger       String?
  decision         IncidentNotificationDecision
  rationale        String

  reviewerMembershipId String
  reviewer             OrganisationMembership @relation("IncidentNotificationAssessmentReviewer", fields: [organisationId, reviewerMembershipId], references: [organisationId, id], onDelete: Restrict)

  assessedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, incidentId])
}

// ---------------------------------------------------------------------------
// Nonconformity workflow (task T63, Docs/PHASE6_AUDIT_INCIDENT_CAPA_SPEC.md
// §§1-9). Depends on T61 (`AuditFinding`), T62 (`EnvironmentalIncident`) and
// T45 (`ComplianceEvaluationItem`/`ComplianceEvaluationFindingLink`) — all
// already present above. State machine per spec §2, T63 scope only:
//
//   OPEN -> CONTAINED -> CLOSED / REOPENED
//
// The remaining states (`ROOT_CAUSE_APPROVED`, `ACTIONS_IN_PROGRESS`,
// `EFFECTIVENESS_REVIEW`) and the root-cause/corrective-action/effectiveness
// models that would drive them belong to T64 and are not modelled here (spec
// §1 "containment, root cause, corrective action, completion, effectiveness
// and closure are separate decisions"). `NonconformityClosurePolicy` still
// lets an organisation *require* those steps; `nonconformity-service.ts#closeNonconformity`
// always refuses to close while any such flag is set, since nothing in T63
// can prove those steps happened — T64 is expected to replace that refusal
// with a real completion check once its models exist (T63 acceptance:
// "closing is impossible without configured mandatory steps").
//
// `Nonconformity.sourceType`/`sourceId` pin the source that created the
// record; `NonconformitySourceLink` additionally records every further
// source later linked to this same Nonconformity (T63 acceptance: "duplicate
// linking supported without losing source traceability") — a second audit
// finding, incident, or evaluation item found to describe the same
// underlying nonconformity is linked here instead of spawning a second
// Nonconformity, while every source it came from stays individually
// traceable via its own row.
// ---------------------------------------------------------------------------

enum NonconformitySourceType {
  AUDIT_FINDING
  INCIDENT
  COMPLIANCE_EVALUATION_ITEM
  CONTROL_CHECK
  COMPLAINT
  MANUAL
}

enum NonconformityStatus {
  OPEN
  CONTAINED
  ROOT_CAUSE_APPROVED
  ACTIONS_IN_PROGRESS
  EFFECTIVENESS_REVIEW
  CLOSED
  REOPENED
}

/// Organisation-configurable nonconformity classification (spec §4
/// "classification config snapshot") — same convention as
/// `IncidentSeverityLevel` (T62): a level already referenced by a
/// Nonconformity is never deleted, only deactivated
/// (`nonconformity-service.ts` enforces this).
model NonconformityClassification {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  key      String
  label    String
  rank     Int
  isActive Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nonconformities Nonconformity[]

  @@unique([organisationId, id])
  @@unique([organisationId, key])
  @@index([organisationId, isActive])
}

/// One organisation's mandatory-close-step policy (spec acceptance: "closing
/// is impossible without configured mandatory steps"). Single row per
/// organisation, upserted by `ems.nonconformity.manage`.
/// `requireRootCauseApproval`/`requireCorrectiveActionsComplete`/
/// `requireEffectivenessReview` name steps T63 does not implement — see the
/// module docblock above for why setting any of them always blocks close
/// rather than being silently ignored.
model NonconformityClosurePolicy {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  requireContainment               Boolean @default(true)
  requireRootCauseApproval         Boolean @default(false)
  requireCorrectiveActionsComplete Boolean @default(false)
  requireEffectivenessReview       Boolean @default(false)

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// A controlled nonconformity record (spec §4). `sourceType`/`sourceId` pin
/// the source that created this record; for source types with a backing
/// model (`AUDIT_FINDING`, `INCIDENT`, `COMPLIANCE_EVALUATION_ITEM`,
/// `CONTROL_CHECK`) `sourceId` is validated against that model in the same
/// Organisation before the row is created — see
/// `nonconformity-service.ts#resolveAndValidateSource`. `COMPLAINT` and
/// `MANUAL` have no backing model in this codebase yet, so `sourceId` stays
/// null for them and `sourceReferenceNote` carries the free-text reference
/// instead — either way a source is always recorded (T63 acceptance: "source
/// linkage ... required for each nonconformity"). `requirementReference` is
/// always required free text; `complianceObligationId`/`operationalControlId`
/// are optional FK links to the exact record when the reference names one.
/// `classificationConfigSnapshot` freezes the exact
/// `NonconformityClassification` row in effect when classification was
/// assigned (same convention as `EnvironmentalIncident.severityConfigSnapshot`,
/// T62) so a later config edit never rewrites a past record.
model Nonconformity {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  reference String

  sourceType          NonconformitySourceType
  sourceId            String?
  sourceReferenceNote String?

  statement            String
  requirementReference String

  complianceObligationId String?
  complianceObligation   ComplianceObligation? @relation(fields: [organisationId, complianceObligationId], references: [organisationId, id], onDelete: Restrict)
  operationalControlId   String?
  operationalControl     OperationalControl?   @relation(fields: [organisationId, operationalControlId], references: [organisationId, id], onDelete: Restrict)

  classificationId              String?
  classification                NonconformityClassification? @relation(fields: [organisationId, classificationId], references: [organisationId, id], onDelete: Restrict)
  classificationConfigSnapshot  Json?

  status NonconformityStatus @default(OPEN)

  ownerMembershipId String?
  owner             OrganisationMembership? @relation("NonconformityOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)
  dueDate           DateTime?

  closedAt         DateTime?
  closedByUserId   String?
  reopenedAt       DateTime?
  reopenedByUserId String?
  reopenReason     String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceLinks        NonconformitySourceLink[]
  containmentRecords ContainmentRecord[]

  @@unique([organisationId, id])
  @@unique([organisationId, reference])
  @@index([organisationId, status])
  @@index([organisationId, sourceType, sourceId])
  @@index([organisationId, classificationId])
}

/// Every source ever linked to a Nonconformity, including the one that
/// created it (`isPrimary = true`, written once by `createNonconformityFromSource`)
/// and any later duplicate source linked instead of spawning a second
/// Nonconformity (spec acceptance: "duplicate linking supported without
/// losing source traceability").
model NonconformitySourceLink {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  nonconformityId String
  nonconformity   Nonconformity @relation(fields: [organisationId, nonconformityId], references: [organisationId, id], onDelete: Cascade)

  sourceType          NonconformitySourceType
  sourceId            String?
  sourceReferenceNote String?
  isPrimary           Boolean @default(false)

  linkedByMembershipId String
  linkedBy              OrganisationMembership @relation("NonconformitySourceLinkedBy", fields: [organisationId, linkedByMembershipId], references: [organisationId, id], onDelete: Restrict)
  linkedAt              DateTime @default(now())

  @@unique([organisationId, id])
  @@index([organisationId, nonconformityId])
  @@index([organisationId, sourceType, sourceId])
}

/// Containment action taken against a Nonconformity (spec §4 "action taken,
/// owner/time, evidence, adequacy review"). Root cause, corrective action,
/// completion and effectiveness are explicitly separate decisions T63 does
/// not implement (spec §1) — this model captures containment and its own
/// adequacy review only.
model ContainmentRecord {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  nonconformityId String
  nonconformity   Nonconformity @relation(fields: [organisationId, nonconformityId], references: [organisationId, id], onDelete: Cascade)

  actionTaken   String
  actionTakenAt DateTime

  ownerMembershipId String
  owner             OrganisationMembership @relation("ContainmentRecordOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)

  adequacyReviewed              Boolean   @default(false)
  adequate                      Boolean?
  adequacyReviewNotes           String?
  adequacyReviewerMembershipId  String?
  adequacyReviewer              OrganisationMembership? @relation("ContainmentRecordAdequacyReviewer", fields: [organisationId, adequacyReviewerMembershipId], references: [organisationId, id], onDelete: Restrict)
  adequacyReviewedAt            DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organisationId, id])
  @@index([organisationId, nonconformityId])
}
